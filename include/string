template <> struct char_traits<char> {
    typedef char char_type;
    static void assign(char_type& destination, const char_type& value) { destination = value; }
    static char_type* assign(char_type* destination, size_t count, char_type value) { return static_cast<char_type*>(memset(destination, static_cast<unsigned char>(value), count)); }
    static char_type* copy(char_type* destination, const char_type* source, size_t count) { return static_cast<char_type*>(memcpy(destination, source, count * sizeof(char_type))); }
    static char_type* move(char_type* destination, const char_type* source, size_t count) { return static_cast<char_type*>(memmove(destination, source, count * sizeof(char_type))); }


    static size_t length(const char_type* s) { return strlen(s); }
    static int compare(const char_type* lhs, const char_type* rhs, size_t n) { return memcmp(lhs, rhs, n); }
};

template <> struct char_traits<wchar_t> {
    typedef wchar_t char_type;
    static void assign(char_type& destination, const char_type& value) { destination = value; }
    static char_type* assign(char_type* destination, size_t count, char_type value) { return wmemset(destination, value, count); }
    static char_type* copy(char_type* destination, const char_type* source, size_t count) { return wmemcpy(destination, source, count); }
    static char_type* move(char_type* destination, const char_type* source, size_t count) { return wmemmove(destination, source, count); }


    static size_t length(const char_type* s) { return wcslen(s); }
    static int compare(const char_type* lhs, const char_type* rhs, size_t n) { return wmemcmp(lhs, rhs, n); }
};

struct single_char_init {};

template <class charT, class traits, class Allocator> class basic_string {
public:
    typedef traits traits_type;
    typedef charT value_type;
    typedef Allocator allocator_type;
    typedef unsigned long size_type;
    typedef charT* pointer;
    typedef const charT* const_pointer;
    typedef charT* iterator;
    typedef const charT* const_iterator;
    static const size_type npos = static_cast<size_type>(-1);

    basic_string() { init(); }
    explicit basic_string(const allocator_type& allocator) : r_(allocator) { init(); }
    basic_string(single_char_init, charT c) {
        init();
        charT* d;
        if (is_long()) {
            r_.first().r.l.size_ = 0;
            d = reinterpret_cast<charT*>(&r_.first().r);
        } else {
            r_.first().r.s.size_ = 1;
            d = r_.first().r.s.data_;
        }
        d[0] = c;
        d[1] = charT();
    }
    basic_string(const charT* s);
    basic_string(const_iterator first, const_iterator last, const Allocator* pAllocator = 0);
    basic_string(const basic_string& str);
    basic_string(const basic_string& str, size_type pos, size_type n, const allocator_type& a);
    basic_string substr(size_type pos = 0, size_type n = npos) const;
    ~basic_string();

    basic_string& operator=(const charT* s) { return assign(s); }
    basic_string& assign(const charT* s);

    basic_string& operator=(const basic_string& str);

    basic_string& assign(const basic_string& str);

    size_type max_size() const { return (sizeof(value_type) > 1 ? alloc().max_size() : alloc().max_size() / 2) - 1; }
    size_type size() const { return !is_long() ? short_size() : long_size(); }
    const charT* data() const { return buffer(); }
    const charT* c_str() const { return data(); }
    const_iterator begin() const { return data(); }
    const_iterator end() const { return data() + size(); }

    template <class InputIterator> basic_string& assign(InputIterator first, InputIterator last);

    basic_string& append(const charT* s);
    basic_string& replace(size_type pos, size_type count, const charT* s);
    basic_string& replace_tagged(size_type pos, size_type count, const charT* s);
    basic_string& replace(size_type pos, size_type count, const charT* s, size_type length);

    basic_string& append(const basic_string& str);
    basic_string& replace(size_type pos, size_type count, const basic_string& str);

    int compare(size_type pos1, size_type n1, const charT* s, size_type n2) const;

    int compare(const basic_string& str) const;
    size_type rfind(charT c, size_type pos = npos) const;
    int compare(const charT* s) const { return compare(0, size(), s, traits::length(s)); }

    basic_string& operator+=(const charT* s) { return append(s); }
    basic_string& operator+=(const basic_string& str) { return append(str); }
    charT& operator[](size_type n) { return buffer()[n]; }
    basic_string& operator+=(charT c);
    void push_back(charT c) { *this += c; }

    const charT& operator[](size_type n) const { return data()[n]; }

    void clear() {
        if (!is_long()) {
            r_.first().r.s.data_[0] = charT();
            r_.first().r.s.size_ = 0;
        } else {
            r_.first().r.l.data_[0] = charT();
            r_.first().r.l.size_ = 0;
        }
    }

    template <class InputIterator> basic_string& append(InputIterator first, InputIterator last) {
        return replace(size(), 0, first, last, forward_iterator_tag());
    }

    basic_string& replace(size_type pos1, size_type n1, const basic_string& str, size_type pos2, size_type n2);

    void reserve(size_type res_arg);
    void resize(size_type n, value_type c);
    void resize(size_type n);
    basic_string& replace(size_type pos, size_type n1, size_type n2, value_type c);

    basic_string& insert(size_type pos, const charT* first, const charT* last) {
        forward_iterator_tag tag;
        return replace(pos, 0, first, last, tag);
    }

    void get_buffer(const_pointer& rData, size_type& rSize) const {
        if (!is_long()) {
            rData = short_data();
            rSize = short_size();
        } else {
            rData = long_data();
            rSize = long_size();
        }
    }

    template <class ForwardIterator>
    basic_string& replace(size_type pos, size_type n1, ForwardIterator j1, ForwardIterator j2) {
        return do_replace(pos, n1, j1, j2, typename iterator_traits<ForwardIterator>::iterator_category());
    }

    template <class ForwardIterator>
    basic_string& replace(size_type pos, size_type n1, ForwardIterator j1, ForwardIterator j2, forward_iterator_tag);

    basic_string& do_replace(size_type pos, size_type count, pointer first, pointer last, random_access_iterator_tag tag) { return do_replace(pos, count, static_cast<const_pointer>(first), static_cast<const_pointer>(last), tag); }

private:
    struct long_rep {
        size_type is_long_ : 1;
        size_type cap_ : 31;
        size_type size_;
        charT* data_;
    };

    struct short_rep {
        unsigned char is_long_ : 1;
        unsigned char size_ : 7;
        charT data_[(sizeof(long_rep) - 1) / sizeof(charT)];
    };

    struct raw_t { size_type words_[3]; };
    union rep {
        raw_t raw;
        long_rep l;
        short_rep s;
        size_type words[3];
    };

    basic_string& do_replace(size_type pos, size_type n1, const_pointer first, const_pointer last, random_access_iterator_tag);

    static const size_type min_cap = (sizeof(long_rep) - 1) / sizeof(charT);
    static size_type align(size_type size, size_type alignment) { return (size + alignment - 1) & ~(alignment - 1); }
    static size_type recommend(size_type capacity) { return align(capacity, sizeof(value_type) < 16 ? 16 / sizeof(value_type) : 1); }

    bool is_long() const { return r_.first().r.l.is_long_; }
    void is_long(bool value) { r_.first().r.l.is_long_ = value; }
    unsigned char short_size() const { return r_.first().r.s.size_; }
    void short_size(unsigned int value) { r_.first().r.s.size_ = value; }
    size_type& long_size() { return r_.first().r.l.size_; }
    const size_type& long_size() const { return r_.first().r.l.size_; }
    size_type long_cap() const { return r_.first().r.l.cap_; }
    void long_cap(size_type value) { r_.first().r.l.cap_ = value; }

    bool is_short() const { return !r_.first().r.l.is_long_; }
    charT* short_data() { return r_.first().r.s.data_; }
    const charT* short_data() const { return r_.first().r.s.data_; }
    charT*& long_data() { return r_.first().r.l.data_; }
    const charT* long_data() const { return r_.first().r.l.data_; }
    charT* buffer() { return !is_long() ? short_data() : long_data(); }
    const charT* buffer() const { return !is_long() ? short_data() : long_data(); }
    void init(const_iterator first, const_iterator last, forward_iterator_tag);
    typedef size_type (&word_array)[3];
    word_array words() { return r_.first().r.raw.words_; }
    void init();

    struct rep_s { rep r; };
    Metrowerks::compressed_pair<rep_s, allocator_type> r_;
    allocator_type& alloc() { return r_.second(); }
    const allocator_type& alloc() const { return r_.second(); }
};


template <class charT, class traits, class Allocator>
inline void basic_string<charT, traits, Allocator>::init() {
    word_array w = words();
    for (unsigned int i = 0; i < 3; ++i) w[i] = 0;
}

template <class charT, class traits, class Allocator>
void basic_string<charT, traits, Allocator>::resize(size_type n, value_type c) {
    size_type currentSize = size();
    if (n > currentSize) replace(currentSize, 0, n - currentSize, c);
    else replace(n, currentSize - n, size_type(0), value_type(0));
}

template <class charT, class traits, class Allocator>
inline void basic_string<charT, traits, Allocator>::resize(size_type n) {
    resize(n, value_type());
}

template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator>& basic_string<charT, traits, Allocator>::replace(size_type pos, size_type n1, size_type n2, value_type c) {
    pointer p;
    size_type oldSize;
    size_type oldCapacity;
    bool wasLong = is_long();
    if (!wasLong) {
        p = short_data();
        oldSize = short_size();
        oldCapacity = min_cap;
    } else {
        p = long_data();
        oldSize = long_size();
        oldCapacity = long_cap();
    }
    if (pos > oldSize) throw out_of_range("basic_string: out_of_range");
    size_type erased = min(n1, oldSize - pos);
    size_type maximumSize = max_size();
    if (n2 > maximumSize || oldSize - erased > maximumSize - n2) throw length_error("basic_string: length_error");
    size_type newSize = oldSize - erased + n2;
    size_type suffix = oldSize - (pos + erased);
    if (newSize >= oldCapacity) {
        size_type newCapacity = recommend(oldCapacity);
        while (newCapacity < newSize + 1) newCapacity = recommend(newCapacity * 2);
        pointer pNew = alloc().allocate(newCapacity);
        if (pos > 0) traits::copy(pNew, p, pos);
        traits::assign(pNew + pos, n2, c);
        if (suffix > 0) traits::copy(pNew + pos + n2, p + pos + erased, suffix);
        traits::assign(pNew[newSize], value_type());
        if (wasLong) alloc().deallocate(p, oldCapacity);
        else is_long(true);
        long_data() = pNew;
        long_size() = newSize;
        long_cap(newCapacity);
    } else {
        if (suffix > 0) traits::move(p + pos + n2, p + pos + erased, suffix);
        traits::assign(p + pos, n2, c);
        traits::assign(p[newSize], charT());
        if (!wasLong) short_size(static_cast<unsigned int>(newSize));
        else long_size() = newSize;
    }
    return *this;
}

template <class charT, class traits, class Allocator>
inline basic_string<charT, traits, Allocator>::basic_string(const_iterator first, const_iterator last, const Allocator* pAllocator) {
    init(first, last, random_access_iterator_tag());
}

template <class charT, class traits, class Allocator>
void basic_string<charT, traits, Allocator>::init(const_iterator first, const_iterator last, forward_iterator_tag) {
    init();
    reserve(static_cast<size_type>(std::distance(first, last)));
    replace(size_type(0), size_type(0), first, last);
}

template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator>::basic_string(const basic_string& str, size_type pos, size_type n, const allocator_type& a) : r_(a) {
    init();
    size_type s_s = str.size();
    reserve(pos <= s_s ? min(n, s_s - pos) : 0);
    replace(0, 0, str, pos, n);
}

template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator>& basic_string<charT, traits, Allocator>::replace(size_type pos1, size_type n1, const basic_string& str, size_type pos2, size_type n2) {
    const_pointer p;
    size_type sz;
    str.get_buffer(p, sz);
    if (pos2 > sz) {
        throw out_of_range("basic_string: out_of_range");
    }
    p += pos2;
    n2 = min(n2, sz - pos2);
    return do_replace(pos1, n1, p, p + n2, random_access_iterator_tag());
}

template <class charT, class traits, class Allocator>
inline basic_string<charT, traits, Allocator> basic_string<charT, traits, Allocator>::substr(size_type pos, size_type n) const {
    return basic_string(*this, pos, n, alloc());
}

template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator>::basic_string(const basic_string& str) : r_(str.alloc()) {
    if (!str.is_long()) {
        r_.first().r.raw = str.r_.first().r.raw;
    } else {
        init();
        reserve(str.long_size());
        do_replace(0, 0, str.long_data(), str.long_data() + str.long_size(), random_access_iterator_tag());
    }
}

template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator>::basic_string(const charT* s) {
    init();
    size_type n = traits::length(s);
    reserve(n);
    do_replace(0, 0, s, s + n, random_access_iterator_tag());
}

template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator>& basic_string<charT, traits, Allocator>::append(const charT* s) {
    return replace_tagged(size(), 0, s);
}

template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator>& basic_string<charT, traits, Allocator>::replace_tagged(size_type pos, size_type count, const charT* s) {
    random_access_iterator_tag tag;
    return do_replace(pos, count, s, s + traits::length(s), tag);
}

template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator>& basic_string<charT, traits, Allocator>::replace(size_type pos, size_type count, const charT* s, size_type length) {
    random_access_iterator_tag tag;
    return do_replace(pos, count, s, s + length, tag);
}

template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator>& basic_string<charT, traits, Allocator>::replace(size_type pos, size_type count, const charT* s) {
    return do_replace(pos, count, s, s + traits::length(s), random_access_iterator_tag());
}

template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator>& basic_string<charT, traits, Allocator>::assign(const charT* s) {
    return replace(0, size(), s);
}

template <class charT, class traits, class Allocator>
template <class InputIterator>
basic_string<charT, traits, Allocator>& basic_string<charT, traits, Allocator>::assign(InputIterator first, InputIterator last) {
    return replace(0, size(), first, last);
}

template <class charT, class traits, class Allocator>
template <class ForwardIterator>
basic_string<charT, traits, Allocator>& basic_string<charT, traits, Allocator>::replace(size_type pos, size_type n1, ForwardIterator first, ForwardIterator last, forward_iterator_tag) {
    typename iterator_traits<ForwardIterator>::iterator_category tag;
    return do_replace(pos, n1, first, last, tag);
}

template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator>& basic_string<charT, traits, Allocator>::do_replace(size_type pos, size_type n1, const_pointer first, const_pointer last, random_access_iterator_tag) {
    pointer p;
    size_type oldSize;
    size_type oldCapacity;
    bool wasLong = is_long();
    if (!wasLong) {
        p = short_data();
        oldSize = short_size();
        oldCapacity = min_cap;
    } else {
        p = long_data();
        oldSize = long_size();
        oldCapacity = long_cap();
    }
    if (pos > oldSize) throw out_of_range("basic_string: out_of_range");
    size_type erased = min(n1, oldSize - pos);
    size_type inserted = distance(first, last);
    size_type maximumSize = max_size();
    if (inserted > maximumSize || oldSize - erased > maximumSize - inserted) throw length_error("basic_string: length_error");
    size_type newSize = oldSize - erased + inserted;
    size_type suffix = oldSize - (pos + erased);
    if (newSize >= oldCapacity) {
        size_type newCapacity = recommend(oldCapacity);
        while (newCapacity < newSize + 1) newCapacity = recommend(newCapacity * 2);
        pointer pNew = alloc().allocate(newCapacity);
        if (pos > 0) traits::copy(pNew, p, pos);
        memmove(pNew + pos, first, (last - first) * sizeof(charT));
        if (suffix > 0) traits::copy(pNew + pos + inserted, p + pos + erased, suffix);
        traits::assign(pNew[newSize], charT());
        if (wasLong) alloc().deallocate(p, oldCapacity);
        else is_long(true);
        long_data() = pNew;
        long_size() = newSize;
        long_cap(newCapacity);
    } else {
        basic_string temporary(alloc());
        if (suffix > 0 && p + pos + inserted < last && last <= p + oldSize) {
            temporary.assign(first, last);
            const basic_string& rTemporary = temporary;
            size_type temporarySize;
            rTemporary.get_buffer(first, temporarySize);
            last = first + temporarySize;
        }
        if (suffix > 0) traits::move(p + pos + inserted, p + pos + erased, suffix);
        traits::move(p + pos, first, inserted);
        traits::assign(p[newSize], charT());
        if (!wasLong) short_size(newSize);
        else long_size() = newSize;
    }
    return *this;
}

template <class charT, class traits, class Allocator>
void basic_string<charT, traits, Allocator>::reserve(size_type newCapacity) {
    if (newCapacity > max_size()) {
        throw length_error("basic_string::reserve length_error");
    }
    bool wasLong = is_long();
    size_type length;
    size_type oldCapacity;
    if (!wasLong) {
        length = short_size();
        oldCapacity = min_cap;
    } else {
        length = long_size();
        oldCapacity = long_cap();
    }
    if (newCapacity < length) newCapacity = length;
    ++newCapacity;
    if (newCapacity <= min_cap) newCapacity = min_cap;
    else {
        newCapacity = recommend(newCapacity);
    }
    if (newCapacity != oldCapacity) {
        charT* pNew;
        charT* pOld;
        bool nowLong;
        if (newCapacity == min_cap) {
            pNew = short_data();
            nowLong = false;
            pOld = long_data();
        } else {
            if (newCapacity > oldCapacity) pNew = alloc().allocate(newCapacity);
            else {
                try { pNew = alloc().allocate(newCapacity); }
                catch (...) { return; }
            }
            nowLong = true;
            pOld = wasLong ? long_data() : short_data();
        }
        memmove(pNew, pOld, length * sizeof(charT));
        pNew[length] = charT();
        if (wasLong) alloc().deallocate(pOld, oldCapacity);
        is_long(nowLong);
        if (!nowLong) short_size(length);
        else {
            long_data() = pNew;
            long_size() = length;
            long_cap(newCapacity);
        }
    }
}

template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator> operator+(const basic_string<charT, traits, Allocator>& lhs,
                                                 const basic_string<charT, traits, Allocator>& rhs) {
    basic_string<charT, traits, Allocator> result;
    typename basic_string<charT, traits, Allocator>::size_type lhsSize;
    typename basic_string<charT, traits, Allocator>::size_type rhsSize;
    const charT* pLhs;
    const charT* pRhs;
    lhs.get_buffer(pLhs, lhsSize);
    rhs.get_buffer(pRhs, rhsSize);
    result.reserve(lhsSize + rhsSize);
    result.insert(0, pLhs, pLhs + lhsSize).insert(lhsSize, pRhs, pRhs + rhsSize);
    return result;
}
template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator> operator+(const charT* lhs, const basic_string<charT, traits, Allocator>& rhs) {
    basic_string<charT, traits, Allocator> result;
    typename basic_string<charT, traits, Allocator>::size_type lhsSize = traits::length(lhs);
    typename basic_string<charT, traits, Allocator>::size_type rhsSize;
    const charT* pRhs;
    rhs.get_buffer(pRhs, rhsSize);
    result.reserve(lhsSize + rhsSize);
    result.insert(0, lhs, lhs + lhsSize).insert(lhsSize, pRhs, pRhs + rhsSize);
    return result;
}
template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator> operator+(const basic_string<charT, traits, Allocator>& lhs, const charT* rhs);
template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator> operator+(const basic_string<charT, traits, Allocator>& lhs, charT rhs) {
    basic_string<charT, traits, Allocator> result(single_char_init(), rhs);
    typename basic_string<charT, traits, Allocator>::const_pointer pLhs;
    typename basic_string<charT, traits, Allocator>::size_type lhsSize;
    lhs.get_buffer(pLhs, lhsSize);
    result.insert(0, pLhs, pLhs + lhsSize);
    return result;
}

template <class charT, class traits, class Allocator>
bool operator<(const basic_string<charT, traits, Allocator>& lhs, const basic_string<charT, traits, Allocator>& rhs) {
    return lhs.compare(rhs) < 0;
}

template <class charT, class traits, class Allocator>
int basic_string<charT, traits, Allocator>::compare(const basic_string& str) const {
        const charT* pStr;
        size_type length;
        str.get_buffer(pStr, length);
        return compare(0, size(), pStr, length);
    }

template <class charT, class traits, class Allocator>
int basic_string<charT, traits, Allocator>::compare(size_type pos1, size_type n1, const charT* s, size_type n2) const {
    const charT* pLhs;
    size_type size;
    get_buffer(pLhs, size);
    if (pos1 > size) {
        throw out_of_range("string compare: pos > len");
    }
    size_type rlen = min(size - pos1, n1);
    int result = traits::compare(pLhs + pos1, s, min(rlen, n2));
    if (result == 0) {
        if (rlen < n2) {
            return -1;
        }
        if (rlen == n2) {
            return 0;
        }
        return 1;
    }
    return result;
}

template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator>& basic_string<charT, traits, Allocator>::operator=(const basic_string& str) {
    bool lhsLong = is_long();
    if (!lhsLong) {
        if (str.is_long()) { goto doLong; }
        r_.first().r.raw = str.r_.first().r.raw;
        return *this;
    }
doLong:
    return replace(0, lhsLong ? long_size() : short_size(), str);
}

template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator>& basic_string<charT, traits, Allocator>::assign(const basic_string& str) {
    const_pointer p;
    size_type size;
    bool lhsLong = is_long();
    if (!lhsLong) {
        if (str.is_long()) { goto doLong; }
        r_.first().r.raw = str.r_.first().r.raw;
        return *this;
    }
doLong:
    size_type count = lhsLong ? long_size() : short_size();
    str.get_buffer(p, size);
    return replace(0, count, p, p + size, forward_iterator_tag());
}

template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator>& basic_string<charT, traits, Allocator>::operator+=(charT c) { return do_replace(size(), 0, &c, &c + 1, random_access_iterator_tag()); }

template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator>& basic_string<charT, traits, Allocator>::append(const basic_string& str) { return replace(size(), 0, str); }

template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator>& basic_string<charT, traits, Allocator>::replace(size_type pos, size_type count, const basic_string& str) {
    random_access_iterator_tag tag;
    const_pointer p;
    size_type size;
    str.get_buffer(p, size);
    return do_replace(pos, count, p, p + size, tag);
}

template <class charT, class traits, class Allocator>
basic_string<charT, traits, Allocator>::~basic_string() {
    if (is_long()) {
        alloc().deallocate(r_.first().r.l.data_, r_.first().r.l.cap_);
    }
}

typedef basic_string<char> string;
typedef basic_string<wchar_t> wstring;

template <class charT, class traits, class Allocator>
typename basic_string<charT, traits, Allocator>::size_type basic_string<charT, traits, Allocator>::rfind(charT c, size_type pos) const {
    const charT* pStr;
    size_type length;
    get_buffer(pStr, length);
    if (length == 0) {
        return npos;
    }
    if (pos > length - 1) {
        pos = length - 1;
    }
    for (const charT* p = pStr + pos; p >= pStr; --p) {
        if (*p == c) {
            return p - pStr;
        }
    }
    return npos;
}

