template <typename Iterator>
typename Iterator::comparison_result operator!=(const Iterator& rLeft, const Iterator& rRight) {
    return rLeft.base() != rRight.base();
}

template <bool> struct __vector_common {
    static void throw_length_error();
};

template <bool b> void __vector_common<b>::throw_length_error() {
    throw length_error("vector length error");
}

template <typename T> struct __vec_bulk_move {
    enum { value = Metrowerks::is_POD<T>::value };
};

template <class CharT, class Traits, class Allocator> struct __vec_bulk_move<basic_string<CharT, Traits, Allocator> > {
    enum { value = (__builtin_trivial_members(Allocator) & 4) != 0 && Metrowerks::has_trivial_dtor<Allocator>::value };
};

template <class Key, class T, class Compare, class Allocator> class map;

template <typename T> struct __vec_swap_move {
    enum { value = false };
};

template <class Key, class T, class Compare, class Allocator> struct __vec_swap_move<map<Key, T, Compare, Allocator> > {
    enum { value = true };
};

template <typename T> struct __vec_trivial_copy {
    enum { value = Metrowerks::is_POD<T>::value || (__builtin_trivial_members(T) & 7) == 7 };
};

template <typename T, typename Allocator> class __vec_split_buffer;

template <typename T, typename Allocator, bool IsPOD> class __vec_constructor;

template <typename T, typename Allocator> class __vec_deleter : public __vector_common<true> {
public:
    typedef unsigned long size_type;
    typedef __vec_split_buffer<T, Allocator> helper;
    typedef typename Metrowerks::compressed_pair<size_type, Allocator>::second_param allocator_param;
    typedef Metrowerks::int2type<Metrowerks::is_POD<T>::value> pod_type;
    typedef Metrowerks::int2type<__vec_trivial_copy<T>::value> copy_type;

    __vec_deleter() : data_(nullptr), size_(0), capacity_(0) {}
    explicit __vec_deleter(allocator_param a) : data_(nullptr), size_(0), capacity_(0, a) {}

    size_type& cap() { return capacity_.first(); }
    const size_type& cap() const { return capacity_.first(); }
    Allocator& alloc() { return capacity_.second(); }
    const Allocator& alloc() const { return capacity_.second(); }
    size_type max_size() const { return alloc().max_size(); }

    ~__vec_deleter();

    T* begin() { return this->data_; }
    const T* begin() const { return this->data_; }
    T* end() { return this->data_ + this->size_; }
    const T* end() const { return this->data_ + this->size_; }
    T& back() { return this->data_[this->size_ - 1]; }

    void clear() { erase_at_end(size_); }

    void allocate(size_type n) { allocate(n, pod_type()); }
    void allocate(size_type n, size_type capacity) { allocate(n, capacity, pod_type()); }
    void allocate(size_type n, size_type capacity, pod_type tag) { allocate(capacity, tag); }
    void allocate(size_type n, pod_type);

    size_type recommend(size_type n);
    size_type recommend(size_type n, pod_type) { return recommend(n); }
    size_type recommend_realloc(size_type n) { return recommend(n); }
    size_type grow_capacity(size_type n) { return recommend_realloc(this->size_ + n - this->cap()); }
    size_type recommend_extra(size_type n) { return recommend(n); }
    size_type recommend_append(size_type n) { return recommend_extra(n); }

    void append_realloc(size_type n);
    void append_realloc(size_type n, const T& x);

    void append(size_type n) { append(n, pod_type()); }
    void append(size_type n, pod_type);

    void reallocate(size_type n);

    T* data_;
    size_type size_;
    Metrowerks::compressed_pair<size_type, Allocator> capacity_;

    void swap(__vec_deleter& r) { swap_storage(r); }

protected:
    void swap_storage(__vec_deleter& r) {
        Metrowerks::swap(capacity_, r.capacity_);
        std::swap(data_, r.data_);
        std::swap(size_, r.size_);
    }
    void erase_at_end(size_type n, Metrowerks::int2type<false>) {
        size_type count = n;
        T* p = data_ + size_;
        size_ -= count;
        for (; count != 0; --count) {
            --p;
            alloc().destroy(p);
        }
    }
public:
    void erase_at_end(size_type n) { erase_tail(n, pod_type()); }
protected:
    void erase_tail(size_type n, Metrowerks::int2type<false>);
    void erase_tail(size_type n, Metrowerks::int2type<true>) { size_ -= n; }
    void erase_at_end(size_type& n, Metrowerks::int2type<true>) { size_ -= n; }

public:
    bool can_append(size_type n) { size_type capacity; return grow_by(n, capacity, pod_type()); }
    bool grow_by(size_type n) {
        size_type capacity;
        return grow_by(n, capacity, pod_type());
    }
    bool grow_by(size_type n, pod_type) {
        recommend_append(n);
        return false;
    }
    bool grow_by(size_type n, size_type& rCapacity) { return grow_by(n, rCapacity, pod_type()); }
    bool grow_by(size_type n, size_type& rCapacity, pod_type) {
        rCapacity = recommend(n);
        return false;
    }

    void construct_at_end(size_type n) { construct_at_end(n, pod_type()); }
    void construct_at_end(size_type n, Metrowerks::int2type<false>) {
        for (T* p = this->data_ + this->size_; n != 0; --n, ++p) {
            this->alloc().construct(p, T());
            ++this->size_;
        }
    }
    void construct_at_end(size_type n, Metrowerks::int2type<true>) {
        memset(this->data_ + this->size_, 0, n * sizeof(T));
        this->size_ += n;
    }
    void construct_at_end(T* pFirst, T* pLast) { construct_at_end(pFirst, pLast, pod_type()); }
    void construct_at_end(T* pFirst, T* pLast, Metrowerks::int2type<true>) {
        ptrdiff_t n = pLast - pFirst;
        memcpy(data_ + size_, pFirst, n * sizeof(T));
        memset(pFirst, 0, n * sizeof(T));
        size_ += n;
    }
    void construct_at_end(const T* pFirst, const T* pLast, Metrowerks::int2type<true>) {
        ptrdiff_t n = pLast - pFirst;
        memmove(data_ + size_, pFirst, (pLast - pFirst) * sizeof(T));
        size_ += n;
    }
    void construct_at_end(const T* pFirst, const T* pLast, Metrowerks::int2type<false>) {
        for (T* p = data_ + size_; pFirst != pLast; ++pFirst, ++p) {
            alloc().construct(p, *pFirst);
            ++size_;
        }
    }

    void push_back_realloc(const T& x) { push_back_realloc(x, copy_type()); }
    void push_back_realloc(const T& x, Metrowerks::int2type<false>);
    void push_back_realloc(const T& x, Metrowerks::int2type<true>);

    void move_construct_to_end(T* pFirst, T* pLast) { move_construct_to_end(pFirst, pLast, pod_type()); }
    void move_construct_to_end(T* pFirst, T* pLast, Metrowerks::int2type<true>) {
        ptrdiff_t n = pLast - pFirst;
        memcpy(data_ + size_, pFirst, n * sizeof(T));
        memset(pFirst, 0, n * sizeof(T));
        size_ += n;
    }
    void move_construct_to_end(T* pFirst, T* pLast, Metrowerks::int2type<false>) {
        for (T* p = data_ + size_; pFirst < pLast; ++pFirst, ++p) {
            alloc().construct(p, std::move(*pFirst));
            ++size_;
        }
    }

    void clear_moved() { clear_moved(pod_type()); }
    void clear_moved(Metrowerks::int2type<true>) { this->size_ = 0; }
    void clear_moved(Metrowerks::int2type<false>) {
        if (Metrowerks::is_same<Allocator, allocator<T> >::value && Metrowerks::has_trivial_dtor<T>::value) this->size_ = 0;
    }

private:
    __vec_deleter(const __vec_deleter&);
    __vec_deleter& operator=(const __vec_deleter&);
};

template <typename T, typename Allocator> __vec_deleter<T, Allocator>::~__vec_deleter() {
    if (data_) {
        clear();
        alloc().deallocate(data_, cap());
    }
}

template <typename T, typename Allocator>
void __vec_deleter<T, Allocator>::erase_tail(size_type n, Metrowerks::int2type<false>) {
        T* p = end();
        size_ -= n;
        for (; n > 0; --n) {
            alloc().destroy(--p);
        }
    }

template <typename T, typename Allocator> class __vec_split_buffer : public __vec_deleter<T, Allocator&> {
    typedef __vec_deleter<T, Allocator&> base;

public:
    typedef typename base::size_type size_type;
    typedef typename base::pod_type pod_type;

    explicit __vec_split_buffer(Allocator& a) : base(a), start_(0) {}
    ~__vec_split_buffer();

    T* begin() { return this->data_ + start_; }
    T* end() { return begin() + this->size_; }

    void move_construct_to_end(T* pFirst, T* pLast) { move_construct_to_end(pFirst, pLast, pod_type()); }
    void move_construct_to_end(T* pFirst, T* pLast, Metrowerks::int2type<true>) {
        ptrdiff_t n = pLast - pFirst;
        memcpy(this->data_ + start_ + this->size_, pFirst, n * sizeof(T));
        memset(pFirst, 0, n * sizeof(T));
        this->size_ += n;
    }
    void move_construct_to_end(T* pFirst, T* pLast, Metrowerks::int2type<false>) {
        for (T* p = this->data_ + start_ + this->size_; pFirst < pLast; ++pFirst, ++p) {
            this->alloc().construct(p, std::move(*pFirst));
            ++this->size_;
        }
    }

    void construct_at_end(size_type n) { construct_at_end(n, pod_type()); }
    void construct_at_end(size_type n, Metrowerks::int2type<false>) {
        for (T* p = this->data_ + start_ + this->size_; n; --n, ++p, ++this->size_) {
            this->alloc().construct(p, T());
        }
    }
    void construct_at_end(size_type n, Metrowerks::int2type<true>) {
        memset(this->data_ + start_ + this->size_, 0, n * sizeof(T));
        this->size_ += n;
    }

    void construct_at_end(const T& x, pod_type) {
        this->alloc().construct(end(), x);
        ++this->size_;
    }

    void construct_at_end(size_type n, const T& x) { construct_at_end(n, x, Metrowerks::int2type<__vec_trivial_copy<T>::value>()); }
    void construct_at_end(size_type n, const T& x, Metrowerks::int2type<true>) {
        std::fill_n(this->data_ + start_ + this->size_, n, x);
        this->size_ += n;
    }
    void construct_at_end(size_type n, const T& x, Metrowerks::int2type<false>) {
        for (T* p = this->data_ + start_ + this->size_; n; --n, ++p, ++this->size_) {
            this->alloc().construct(p, x);
        }
    }

    template <typename Iterator> void construct_at_end(Iterator first, Iterator last) {
        construct_at_end(first, last, pod_type());
    }
    template <typename Iterator> void construct_at_end(Iterator first, Iterator last, Metrowerks::int2type<false>) {
        T* p = this->data_ + start_ + this->size_;
        for (; first != last; ++p) {
            this->alloc().construct(p, *first);
            ++first;
            ++this->size_;
        }
    }

    void construct_at_front(T* pFirst, T* pLast) {
        construct_at_front(pFirst, pLast, Metrowerks::int2type<__vec_bulk_move<T>::value ? 1 : __vec_swap_move<T>::value ? 2 : 0>());
    }
    void construct_at_front(T* pFirst, T* pLast, Metrowerks::int2type<true>) {
        ptrdiff_t n = pLast - pFirst;
        start_ -= n;
        memcpy(this->data_ + start_, pFirst, n * sizeof(T));
        memset(pFirst, 0, n * sizeof(T));
        this->size_ += n;
    }
    void construct_at_front(T* pFirst, T* pLast, Metrowerks::int2type<false>) {
        for (T* p = this->data_ + start_; pFirst < pLast; --start_, ++this->size_) {
            this->alloc().construct(--p, std::move(*--pLast));
        }
    }
    void construct_at_front(T* pFirst, T* pLast, Metrowerks::int2type<2>) {
        for (T* p = this->data_ + start_; pFirst < pLast; --start_, ++this->size_) {
            ::new (--p) T;
            p->swap(*--pLast);
        }
    }

    size_type start_;
};

template <typename T, typename Allocator> __vec_split_buffer<T, Allocator>::~__vec_split_buffer() {
    T* first = this->data_ + start_;
    T* last = first + this->size_;
    while (last > first) {
        this->alloc().destroy(--last);
    }
    this->size_ = 0;
}

template <typename T, typename Allocator, bool IsPOD> class __vec_constructor : public __vec_deleter<T, Allocator> {
    typedef __vec_deleter<T, Allocator> base;

public:
    typedef T storage_type;
    typedef Allocator storage_allocator;
    typedef typename base::size_type size_type;
    typedef typename base::pod_type pod_type;
    typedef Metrowerks::int2type<__vec_trivial_copy<T>::value> copy_type;

    __vec_constructor() {}
    void swap(__vec_constructor& r) { base::swap(r); }
    explicit __vec_constructor(size_type n) {
        if (n != 0) {
            allocate(n, pod_type());
            base::construct_at_end(n, pod_type());
        }
    }
    __vec_constructor(const __vec_constructor& x) : base() {
        const T* first = x.data_;
        const T* last = x.data_ + x.size_;
        size_type n = last - first;
        if (n != 0) {
            allocate(n, pod_type());
            base::construct_at_end(first, last, pod_type());
        }
    }

    template <typename Iterator> __vec_constructor(Iterator first, Iterator last) : base() {
        size_type n = std::distance(first, last);
        if (n != 0) {
            allocate(n, pod_type());
            for (; first != last; ++first) {
                this->alloc().construct(this->data_ + this->size_, *first);
                ++this->size_;
            }
        }
    }

    using base::begin;
    using base::end;
    size_type size() const { return this->size_; }
    T& operator[](size_type i) { return this->data_[i]; }

    void reserve(size_type n) {
        if (n > this->cap()) {
            reallocate(n);
        }
    }

    void resize(size_type n) {
        if (n > this->size_) {
            append(n - this->size_);
        } else if (n < this->size_) {
            erase_at_end(this->size_ - n);
        }
    }

    void push_back(const T& x) { push_back(x, copy_type()); }
    void pop_back() { pop_back(pod_type()); }
    using base::clear;

    __vec_constructor& operator=(const __vec_constructor& x) {
        if (this != &x) {
            assign(x.begin(), x.end(), pod_type());
        }
        return *this;
    }

    template <typename Iterator> void assign(Iterator first, Iterator last, Metrowerks::int2type<true>) {
        size_type n = std::distance(first, last);
        if (n > this->cap()) {
            size_type capacity = recommend(n - this->cap());
            clear();
            if (this->data_) {
                this->alloc().deallocate(this->data_, this->cap());
                this->data_ = nullptr;
                this->cap() = 0;
            }
            base::allocate(capacity);
        }
        copy_assign(first, last, this->data_);
        this->size_ = n;
    }

    template <typename Iterator> void assign_iterated(Iterator first, Iterator last) {
        size_type n = std::distance(first, last);
        if (n > this->cap()) {
            size_type capacity = recommend(n - this->cap());
            clear();
            if (this->data_) {
                this->alloc().deallocate(this->data_, this->cap());
                this->data_ = nullptr;
                this->cap() = 0;
            }
            base::allocate(capacity);
        }
        copy_assign(first, last, this->data_);
        this->size_ = n;
    }

    template <typename Iterator> void assign(Iterator first, Iterator last, Metrowerks::int2type<false>) {
        size_type capacity;
        size_type n = std::distance(first, last);
        if (n <= this->cap() || grow_by(n - this->cap(), capacity)) {
            Iterator mid(first);
            std::advance(mid, std::min(n, this->size_));
            copy_range(first, mid, this->data_);
            if (n < this->size_) {
                this->erase_at_end(this->size_ - n);
            } else if (this->size_ < n) {
                construct_at_end(mid, last);
            }
        } else {
            assign_reallocate(n, capacity);
            construct_at_end(first, last);
        }
    }

    size_type assign_capacity(size_type n) { return recommend(n - this->cap(), pod_type()); }

    template <typename Iterator> void assign_in_place(Iterator first, Iterator mid, Iterator last, size_type n) {
        T* result = this->data_;
        for (Iterator it = first; it < mid; ++it, ++result) {
            *result = *it;
        }
        if (n < this->size_) {
            this->erase_at_end(this->size_ - n);
        } else if (this->size_ < n) {
            base::construct_at_end(mid, last, pod_type());
        }
    }

    template <typename Iterator> void assign_reallocate(Iterator first, Iterator last, size_type capacity) {
        base::clear();
        if (this->data_) {
            this->alloc().deallocate(this->data_, this->cap());
            this->data_ = nullptr;
            this->cap() = 0;
        }
        base::allocate(capacity);
        base::construct_at_end(first, last, pod_type());
    }

    template <typename Iterator> static void copy_assign(Iterator first, Iterator last, T* result) {
        for (; first != last; ++first, ++result) {
            *result = *first;
        }
    }
    static void copy_assign(T* const& first, T* const& last, T* result) {
        ptrdiff_t n = last - first;
        memmove(result, first, n * sizeof(T));
    }
    static void copy_assign(const T* const& first, const T* const& last, T* result) {
        ptrdiff_t n = last - first;
        memmove(result, first, n * sizeof(T));
    }

protected:
    void push_back(const T& x, Metrowerks::int2type<true>) {
        if (this->size_ < this->cap()) {
            ++this->size_;
            back() = x;
        } else {
            push_back_realloc(x);
        }
    }

    void push_back(const T& x, Metrowerks::int2type<false>) {
        if (this->size_ < this->cap()) {
            this->alloc().construct(end(), x);
            ++this->size_;
        } else {
            push_back_realloc(x);
        }
    }

    void pop_back(Metrowerks::int2type<true>) { --this->size_; }
    void clear(Metrowerks::int2type<true>) { base::clear(); }
    void clear(Metrowerks::int2type<false>) { base::clear(); }

    void allocate(size_type n, pod_type) {
        if (n > max_size()) {
            this->throw_length_error();
        }
        this->data_ = this->alloc().allocate(n);
        this->cap() = n;
    }


public:
    template <typename Iterator> void assign_dispatch(Iterator first, Iterator last, Metrowerks::int2type<0>) {
        assign_range(first, last, std::forward_iterator_tag());
    }
    template <typename Iterator> void insert_dispatch(T* pos, Iterator first, Iterator last, Metrowerks::int2type<0>) {
        insert_range(pos, first, last, std::forward_iterator_tag());
    }

protected:
    template <typename Iterator> void assign_range(Iterator first, Iterator last, std::forward_iterator_tag) {
        size_type capacity;
        size_type n = std::distance(first, last);
        if (n <= this->cap() || grow_by(n - this->cap(), capacity)) {
            Iterator mid(first);
            std::advance(mid, std::min(n, this->size_));
            copy_range(first, mid, this->data_);
            if (n < this->size_) {
                this->erase_at_end(this->size_ - n);
            } else if (this->size_ < n) {
                construct_at_end(mid, last);
            }
        } else {
            assign_reallocate(n, capacity);
            construct_at_end(first, last);
        }
    }

    void assign_reallocate(size_type n, size_type capacity);

    template <typename Iterator> void insert_range(T* pos, Iterator first, Iterator last, std::forward_iterator_tag) {
        size_type n = std::distance(first, last);
        if (n != 0) {
            if ((n <= this->cap() && this->size_ <= this->cap() - n) || grow_by(this->size_ + n - this->cap())) {
                size_type elemsAfter = end() - pos;
                Iterator mid;
                if (elemsAfter < n) {
                    mid = first;
                    std::advance(mid, elemsAfter);
                    construct_at_end(mid, last);
                } else {
                    mid = last;
                }
                move_range(elemsAfter, n, end());
                copy_range(first, mid, pos);
            } else {
                typename base::helper buffer(this->alloc());
                insert_prepare(buffer, pos, n);
                buffer.construct_at_end(first, last);
                insert_finish(buffer, pos);
            }
        }
    }

    template <typename Iterator> void construct_at_end(Iterator first, Iterator last) {
        construct_at_end(first, last, pod_type());
    }
    void construct_at_end(const T* first, const T* last, Metrowerks::int2type<false>) {
        T* p = this->data_ + this->size_;
        for (; first != last; ++first) {
            this->alloc().construct(p, *first);
            ++p;
            ++this->size_;
        }
    }

    template <typename Iterator> void construct_at_end(Iterator first, Iterator last, Metrowerks::int2type<false>) {
        T* p = this->data_ + this->size_;
        for (; first != last; ++p) {
            this->alloc().construct(p, *first);
            ++first;
            ++this->size_;
        }
    }

    template <typename Iterator> static T* copy_range(Iterator first, Iterator last, T* result) {
        for (; first != last; ++first, ++result) {
            *result = *first;
        }
        return result;
    }

    static T* copy_range(const T* first, const T* last, T* result) {
        return copy_contiguous(first, last, result);
    }

    static T* copy_contiguous(const T* first, const T* last, T* result) {
        for (; first < last; ++first, ++result) {
            *result = *first;
        }
        return result;
    }

    void insert_prepare(typename base::helper& buffer, T* pos, size_type n);
    T* insert_finish(typename base::helper& buffer, T* pos);
    size_type move_range(size_type elemsAfter, size_type n, T* pEnd) { return move_range(elemsAfter, n, pEnd, pod_type()); }
    size_type move_range(size_type elemsAfter, size_type n, T* pEnd, Metrowerks::int2type<false>);
};

template <typename T, typename Allocator, bool IsPOD>
void __vec_constructor<T, Allocator, IsPOD>::assign_reallocate(size_type n, size_type capacity) {
    base::clear();
    if (this->data_) {
        this->alloc().deallocate(this->data_, this->cap());
        this->data_ = nullptr;
        this->cap() = 0;
    }
    base::allocate(n, capacity);
}

template <typename T, typename Allocator, bool IsPOD>
void __vec_constructor<T, Allocator, IsPOD>::insert_prepare(typename base::helper& buffer, T* pos, size_type n) {
    buffer.allocate(this->size_ + n, recommend(this->size_ + n - this->cap()));
    buffer.start_ = pos - begin();
}

template <typename T, typename Allocator, bool IsPOD>
T* __vec_constructor<T, Allocator, IsPOD>::insert_finish(typename base::helper& buffer, T* pos) {
    size_type index = pos - begin();
    buffer.move_construct_to_end(pos, end());
    buffer.construct_at_front(begin(), pos);
    clear_moved();
    std::swap(this->cap(), buffer.cap());
    std::swap(this->data_, buffer.data_);
    std::swap(this->size_, buffer.size_);
    return begin() + index;
}

template <typename T, typename Allocator, bool IsPOD>
typename __vec_constructor<T, Allocator, IsPOD>::size_type __vec_constructor<T, Allocator, IsPOD>::move_range(size_type elemsAfter, size_type n, T* pEnd, Metrowerks::int2type<false>) {
    size_type count = std::min(elemsAfter, n);
    for (size_type i = 0; i < count; ++i, ++pEnd) {
        this->alloc().construct(pEnd, std::move(pEnd[-n]));
        ++this->size_;
    }
    pEnd -= n;
    if (elemsAfter > n) {
        std::move_backward(pEnd - elemsAfter, pEnd - n, pEnd);
    }
    return count;
}

template <typename T, typename Allocator> void __vec_deleter<T, Allocator>::allocate(size_type n, pod_type) {
    if (n > max_size()) {
        this->throw_length_error();
    }
    data_ = alloc().allocate(n, 0);
    cap() = n;
}

template <typename T, typename Allocator> void __vec_deleter<T, Allocator>::reallocate(size_type n) {
    __vec_deleter buffer(this->alloc());
    buffer.allocate(n);
    buffer.move_construct_to_end(begin(), end());
    clear_moved();
    std::swap(this->cap(), buffer.cap());
    std::swap(this->data_, buffer.data_);
    std::swap(this->size_, buffer.size_);
}

template <typename T, typename Allocator> typename __vec_deleter<T, Allocator>::size_type __vec_deleter<T, Allocator>::recommend(size_type n) {
    size_type maxSize = this->max_size();
    size_type capacity = this->cap();
    if (n > maxSize - capacity) {
        this->throw_length_error();
    }
    size_type third = maxSize / 3;
    if (capacity < third) {
        return capacity + max((capacity + 1) * 3 / 5, n);
    }
    if (capacity < third * 2) {
        return capacity + max((capacity + 1) / 2, n);
    }
    return maxSize;
}

template <typename T, typename Allocator> void __vec_deleter<T, Allocator>::append_realloc(size_type n, const T& x) {
    helper buffer(this->alloc());
    buffer.allocate(this->size_ + n, recommend(this->size_ + n - this->cap()));
    buffer.start_ = this->size_;
    buffer.construct_at_end(n, x);
    buffer.construct_at_front(begin(), end());
    clear_moved();
    std::swap(this->cap(), buffer.cap());
    std::swap(this->data_, buffer.data_);
    std::swap(this->size_, buffer.size_);
}

template <typename T, typename Allocator> void __vec_deleter<T, Allocator>::push_back_realloc(const T& x, Metrowerks::int2type<false>) {
    if (grow_by(1)) {
        this->alloc().construct(end(), x);
        ++this->size_;
    } else {
        append_realloc(1, x);
    }
}

template <typename T, typename Allocator> void __vec_deleter<T, Allocator>::push_back_realloc(const T& x, Metrowerks::int2type<true>) {
    if (grow_by(1)) {
        ++this->size_;
        back() = x;
    } else {
        append_realloc(1, x);
    }
}

template <typename T, typename Allocator> void __vec_deleter<T, Allocator>::append(size_type n, pod_type) {
        if (n <= this->cap()) {
            if (this->size_ <= this->cap() - n) {
                goto construct;
            }
        }
        if (can_append(this->size_ + n - this->cap())) {
        construct:
            construct_at_end(n);
        } else {
            append_realloc(n);
        }
    }

