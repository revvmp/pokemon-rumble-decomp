namespace std {

static inline void __throw_vector_length_error() {
    throw length_error("vector length error");
}

template <typename T> struct __vec_bulk_move {
    enum { value = Metrowerks::is_POD<T>::value };
};

template <typename T, typename Allocator, bool IsPOD> class __vec_constructor;

template <typename T, typename Allocator> class __vec_deleter {
public:
    typedef unsigned long size_type;
    typedef typename Metrowerks::compressed_pair<size_type, Allocator>::second_param allocator_param;
    typedef Metrowerks::int2type<Metrowerks::is_POD<T>::value> pod_type;

    __vec_deleter() : data_(nullptr), size_(0), capacity_(0) {}
    explicit __vec_deleter(allocator_param a) : data_(nullptr), size_(0), capacity_(0, a) {}
    ~__vec_deleter();

    void clear() { size_type n = size_; erase_at_end(n, pod_type()); }

    size_type& cap() { return capacity_.first(); }
    Allocator& alloc() { return capacity_.second(); }
    const Allocator& alloc() const { return capacity_.second(); }
    size_type max_size() const { return alloc().max_size(); }

    void allocate(size_type n) { allocate(n, pod_type()); }
    void allocate(size_type n, pod_type);

    void construct_at_end(T* pFirst, T* pLast) { construct_at_end(pFirst, pLast, pod_type()); }
    void construct_at_end(T* pFirst, T* pLast, Metrowerks::int2type<true>) {
        ptrdiff_t n = pLast - pFirst;
        memcpy(data_ + size_, pFirst, n * sizeof(T));
        memset(pFirst, 0, n * sizeof(T));
        size_ += n;
    }
    void construct_at_end(const T* pFirst, const T* pLast, Metrowerks::int2type<true>) {
        ptrdiff_t n = pLast - pFirst;
        memcpy(data_ + size_, pFirst, n * sizeof(T));
        size_ += n;
    }
    void construct_at_end(const T* pFirst, const T* pLast, Metrowerks::int2type<false>) {
        for (T* p = data_ + size_; pFirst != pLast; ++pFirst, ++p) {
            capacity_.second().construct(p, *pFirst);
            ++size_;
        }
    }

    T* data_;
    size_type size_;
    Metrowerks::compressed_pair<size_type, Allocator> capacity_;

protected:
    void erase_at_end(size_type n, Metrowerks::int2type<false>) {
        size_type count = n;
        T* p = data_ + size_;
        size_ -= count;
        for (; count != 0; --count) {
            --p;
            capacity_.second().destroy(p);
        }
    }
    void erase_at_end(size_type& n, Metrowerks::int2type<true>) { size_ -= n; }

private:
    __vec_deleter(const __vec_deleter&);
    __vec_deleter& operator=(const __vec_deleter&);
};

template <typename T, typename Allocator> __vec_deleter<T, Allocator>::~__vec_deleter() {
    if (data_) {
        clear();
        capacity_.second().deallocate(data_, capacity_.first());
    }
}

template <typename T, typename Allocator> class __vec_split_buffer : public __vec_deleter<T, Allocator&> {
    typedef __vec_deleter<T, Allocator&> base;

public:
    typedef typename base::size_type size_type;
    typedef typename base::pod_type pod_type;

    explicit __vec_split_buffer(Allocator& a) : base(a), start_(0) {}
    ~__vec_split_buffer();

    T* begin() { return this->data_ + start_; }
    T* end() { return begin() + this->size_; }

    void construct_at_end(size_type n, pod_type) {
        for (T* p = end(); n != 0; --n, ++p) {
            this->capacity_.second().construct(p, T());
            ++this->size_;
        }
    }

    void construct_at_end(const T& x, pod_type) {
        this->capacity_.second().construct(end(), x);
        ++this->size_;
    }

    void allocate(size_type size, size_type n) { allocate(size, n, pod_type()); }
    void allocate(size_type, size_type n, pod_type tag) { base::allocate(n, tag); }

    void construct_at_end(size_type n, const T& x) { construct_at_end(n, x, pod_type()); }
    void construct_at_end(size_type n, const T& x, Metrowerks::int2type<true>) {
        std::fill_n(this->data_ + start_ + this->size_, n, x);
        this->size_ += n;
    }

    void construct_at_front(T* pFirst, T* pLast) {
        construct_at_front(pFirst, pLast, Metrowerks::int2type<__vec_bulk_move<T>::value>());
    }
    void construct_at_front(T* pFirst, T* pLast, Metrowerks::int2type<true>) {
        ptrdiff_t n = pLast - pFirst;
        start_ -= n;
        memcpy(this->data_ + start_, pFirst, n * sizeof(T));
        memset(pFirst, 0, n * sizeof(T));
        this->size_ += n;
    }
    void construct_at_front(T* pFirst, T* pLast, Metrowerks::int2type<false>) {
        for (T* p = begin(); pLast > pFirst;) {
            --p;
            --pLast;
            this->capacity_.second().construct(p, *pLast);
            --start_;
            ++this->size_;
        }
    }

    size_type start_;
};

template <typename T, typename Allocator> __vec_split_buffer<T, Allocator>::~__vec_split_buffer() {
    T* first = begin();
    for (T* p = first + this->size_; p > first;) {
        --p;
        this->capacity_.second().destroy(p);
    }
    this->size_ = 0;
}

template <typename T, typename Allocator, bool IsPOD> class __vec_constructor : public __vec_deleter<T, Allocator> {
    typedef __vec_deleter<T, Allocator> base;

public:
    typedef typename base::size_type size_type;
    typedef typename base::pod_type pod_type;

    __vec_constructor() {}
    explicit __vec_constructor(size_type n) {
        if (n != 0) {
            allocate(n, pod_type());
            construct_at_end(n, pod_type());
        }
    }
    __vec_constructor(const __vec_constructor& x) : base() {
        const T* first = x.data_;
        const T* last = x.data_ + x.size_;
        size_type n = last - first;
        if (n != 0) {
            allocate(n, pod_type());
            base::construct_at_end(first, last, pod_type());
        }
    }

    T* begin() { return this->data_; }
    const T* begin() const { return this->data_; }
    T* end() { return this->data_ + this->size_; }
    const T* end() const { return this->data_ + this->size_; }
    size_type size() const { return this->size_; }
    T& back() { return this->data_[this->size_ - 1]; }
    T& operator[](size_type i) { return this->data_[i]; }

    void reserve(size_type n) {
        if (n > this->cap()) {
            reallocate(n);
        }
    }

    void push_back(const T& x) { push_back(x, pod_type()); }
    void pop_back() { pop_back(pod_type()); }
    void clear() { clear(pod_type()); }

    __vec_constructor& operator=(const __vec_constructor& x) {
        if (this != &x) {
            assign(x.begin(), x.end(), pod_type());
        }
        return *this;
    }

    template <typename Iterator> void assign(Iterator first, Iterator last, Metrowerks::int2type<true>) {
        size_type n = std::distance(first, last);
        if (n > this->cap()) {
            size_type capacity = recommend(n - this->cap());
            clear();
            if (this->data_) {
                this->alloc().deallocate(this->data_, this->cap());
                this->data_ = nullptr;
                this->cap() = 0;
            }
            base::allocate(capacity);
        }
        copy_assign(first, last, this->data_);
        this->size_ = n;
    }

    template <typename Iterator> static void copy_assign(const Iterator& first, const Iterator& last, T* result) {
        ptrdiff_t n = last - first;
        memmove(result, first, n * sizeof(T));
    }

protected:
    void reallocate(size_type n);

    void push_back(const T& x, Metrowerks::int2type<true>) {
        if (this->size_ < this->cap()) {
            ++this->size_;
            back() = x;
        } else {
            push_back_realloc(x);
        }
    }

    void push_back(const T& x, Metrowerks::int2type<false>) {
        if (this->size_ < this->cap()) {
            this->alloc().construct(end(), x);
            ++this->size_;
        } else {
            push_back_realloc(x);
        }
    }

    void push_back_realloc(const T& x) { push_back_realloc(x, pod_type()); }
    void push_back_realloc(const T& x, Metrowerks::int2type<false>) {
        grow_by(1);
        __vec_split_buffer<T, Allocator> buffer(this->capacity_.second());
        size_type capacity = grow_capacity(1);
        if (capacity > max_size()) {
            __throw_vector_length_error();
        }
        buffer.data_ = buffer.capacity_.second().allocate(capacity);
        buffer.capacity_.first() = capacity;
        buffer.start_ = this->size_;
        buffer.construct_at_end(x, pod_type());
        buffer.construct_at_front(this->data_, this->data_ + this->size_, pod_type());
        swap(buffer, pod_type());
    }
    void push_back_realloc(const T& x, Metrowerks::int2type<true>) {
        if (grow_by(1)) {
            ++this->size_;
            back() = x;
        } else {
            append_realloc(1, x);
        }
    }

    void append_realloc(size_type n, const T& x) {
        __vec_split_buffer<T, Allocator> buffer(this->alloc());
        buffer.allocate(this->size_ + n, recommend(this->size_ + n - this->cap()));
        buffer.start_ = this->size_;
        buffer.construct_at_end(n, x);
        buffer.construct_at_front(begin(), end());
        clear_moved();
        std::swap(this->cap(), buffer.cap());
        std::swap(this->data_, buffer.data_);
        std::swap(this->size_, buffer.size_);
    }

    void pop_back(Metrowerks::int2type<true>) { --this->size_; }
    void clear(Metrowerks::int2type<true>) { base::clear(); }
    void clear(Metrowerks::int2type<false>) { base::clear(); }
    void clear_moved() { clear_moved(pod_type()); }
    void clear_moved(Metrowerks::int2type<true>) { this->size_ = 0; }
    void clear_moved(Metrowerks::int2type<false>) { this->size_ = 0; }

    void allocate(size_type n, pod_type) {
        if (n > max_size()) {
            __throw_vector_length_error();
        }
        this->data_ = this->capacity_.second().allocate(n);
        this->capacity_.first() = n;
    }

    void construct_at_end(size_type n, pod_type) {
        for (T* p = this->data_ + this->size_; n != 0; --n, ++p) {
            this->capacity_.second().construct(p, T());
            ++this->size_;
        }
    }

    size_type recommend(size_type n) {
        size_type maxSize = this->max_size();
        size_type capacity = this->cap();
        if (n > maxSize - capacity) {
            __throw_vector_length_error();
        }
        size_type third = maxSize / 3;
        if (capacity < third) {
            return capacity + max((capacity + 1) * 3 / 5, n);
        }
        if (capacity < third * 2) {
            return capacity + max((capacity + 1) / 2, n);
        }
        return maxSize;
    }
    size_type grow_capacity(size_type n) { return recommend(this->size_ + n - this->capacity_.first()); }
    bool grow_by(size_type n) {
        size_type capacity;
        return grow_by(n, capacity, pod_type());
    }
    bool grow_by(size_type n, pod_type) {
        recommend(n);
        return false;
    }
    bool grow_by(size_type n, size_type& rCapacity, pod_type) {
        rCapacity = recommend(n);
        return false;
    }

    void append_realloc(size_type n) {
        __vec_split_buffer<T, Allocator> buffer(this->capacity_.second());
        size_type capacity = grow_capacity(n);
        if (capacity > max_size()) {
            __throw_vector_length_error();
        }
        buffer.data_ = buffer.capacity_.second().allocate(capacity);
        buffer.capacity_.first() = capacity;
        buffer.start_ = this->size_;
        buffer.construct_at_end(n, pod_type());
        buffer.construct_at_front(this->data_, this->data_ + this->size_, pod_type());
        swap(buffer, pod_type());
    }

    void append(size_type n, pod_type) {
        size_type capacity = this->capacity_.first();
        if ((n <= capacity && this->size_ <= capacity - n) || grow_by(this->size_ + n - capacity, pod_type())) {
            construct_at_end(n, pod_type());
        } else {
            append_realloc(n);
        }
    }

    void swap(__vec_deleter<T, Allocator&>& r, pod_type) {
        size_type capacity = this->capacity_.first();
        this->capacity_.first() = r.capacity_.first();
        r.capacity_.first() = capacity;
        T* data = this->data_;
        this->data_ = r.data_;
        r.data_ = data;
        size_type size = this->size_;
        this->size_ = r.size_;
        r.size_ = size;
    }
};

template <typename T, typename Allocator, bool IsPOD>
void __vec_constructor<T, Allocator, IsPOD>::reallocate(size_type n) {
    base buffer(this->alloc());
    buffer.allocate(n);
    buffer.construct_at_end(begin(), end());
    clear_moved();
    std::swap(this->cap(), buffer.cap());
    std::swap(this->data_, buffer.data_);
    std::swap(this->size_, buffer.size_);
}

template <typename T, typename Allocator> void __vec_deleter<T, Allocator>::allocate(size_type n, pod_type) {
    if (n > max_size()) {
        __throw_vector_length_error();
    }
    data_ = alloc().allocate(n, 0);
    cap() = n;
}

template <typename T, typename Allocator = allocator<T> >
class vector : private __vec_constructor<T, Allocator, Metrowerks::is_POD<T>::value> {
    typedef __vec_constructor<T, Allocator, Metrowerks::is_POD<T>::value> base;

public:
    typedef T value_type;
    typedef const T* const_iterator;

    class iterator {
    public:
        iterator() {}
        iterator(T* const& rPointer) : mPointer(rPointer) {}
        iterator& operator=(const iterator& rOther) {
            mPointer = rOther.mPointer;
            return *this;
        }

        T& operator*() const { return *mPointer; }
        T* operator->() const { return mPointer; }
        iterator& operator++() {
            ++mPointer;
            return *this;
        }
        bool operator==(const iterator& rOther) const { return base() == rOther.base(); }
        bool operator!=(const iterator& rOther) const { return !(*this == rOther); }

        T* base() const { return mPointer; }

    private:
        T* mPointer;
    };

    typedef typename base::size_type size_type;
    typedef typename base::pod_type pod_type;

    vector() {}
    explicit vector(size_type n) : base(n) {}
    vector(const vector& x) : base(x) {}
    ~vector() {}

    void resize(size_type n) {
        size_type size = this->size_;
        if (n > size) {
            this->append(n - size, pod_type());
        } else if (n < size) {
            this->erase_at_end(size - n, pod_type());
        }
    }

    using base::reserve;

    void swap(vector& r) {
        size_type capacity = this->capacity_.first();
        this->capacity_.first() = r.capacity_.first();
        r.capacity_.first() = capacity;
        T* data = this->data_;
        this->data_ = r.data_;
        r.data_ = data;
        size_type size = this->size_;
        this->size_ = r.size_;
        r.size_ = size;
    }

    iterator begin() { return make_iterator(base::begin()); }
    const_iterator begin() const { return this->data_; }
    iterator end() { return make_iterator(base::end()); }
    const_iterator end() const { return this->data_ + this->size_; }
    size_type size() const { return this->size_; }
    bool empty() const { return this->size_ == 0; }
    void push_back(const T& x) { base::push_back(x); }
    T& operator[](size_type i) { return base::operator[](i); }
    const T& operator[](size_type i) const { return this->data_[i]; }

private:
    iterator make_iterator(T* const& rPointer) { return iterator(rPointer); }
};

template <typename T, typename Allocator> class __vec_pointer : public __vec_constructor<void*, allocator<void*>, true> {
    typedef __vec_constructor<void*, allocator<void*>, true> base;

public:
    void push_back(T* const& x) { base::push_back((void* const&)x); }
    __vec_pointer& operator=(const __vec_pointer& x) {
        base::operator=(x);
        return *this;
    }
};

template <typename T, typename Allocator> class vector<T*, Allocator> : private __vec_pointer<T, Allocator> {
    typedef __vec_pointer<T, Allocator> base;

public:
    typedef T* value_type;
    typedef unsigned long size_type;
    class iterator {
    public:
        iterator() {}
        explicit iterator(void** const& pPointer) : mPointer(pPointer) {}
        T*& operator*() const { return reinterpret_cast<T*&>(*mPointer); }
        iterator& operator++() { ++mPointer; return *this; }
        iterator operator++(int) { iterator previous(*this); ++*this; return previous; }
        iterator& operator--() { --mPointer; return *this; }
        iterator operator--(int) { iterator previous(*this); --*this; return previous; }
        iterator& operator+=(long offset) { mPointer += offset; return *this; }
        iterator& operator-=(long offset) { mPointer -= offset; return *this; }
        iterator operator+(long offset) const { iterator result(*this); result += offset; return result; }
        iterator operator-(long offset) const { iterator result(*this); result -= offset; return result; }
        long operator-(const iterator& rOther) const { return mPointer - rOther.mPointer; }
        bool operator==(const iterator& rOther) const { return mPointer == rOther.mPointer; }
        bool operator!=(const iterator& rOther) const { return mPointer != rOther.mPointer; }
        bool operator<(const iterator& rOther) const { return mPointer < rOther.mPointer; }
    private:
        void** mPointer;
    };
    class const_iterator {
    public:
        const_iterator() {}
        explicit const_iterator(void* const* const& pPointer) : mPointer(pPointer) {}
        T* const& operator*() const { return reinterpret_cast<T* const&>(*mPointer); }
        const_iterator& operator++() { ++mPointer; return *this; }
        const_iterator operator++(int) { const_iterator previous(*this); ++*this; return previous; }
        const_iterator& operator--() { --mPointer; return *this; }
        const_iterator operator--(int) { const_iterator previous(*this); --*this; return previous; }
        const_iterator& operator+=(long offset) { mPointer += offset; return *this; }
        const_iterator& operator-=(long offset) { mPointer -= offset; return *this; }
        const_iterator operator+(long offset) const { const_iterator result(*this); result += offset; return result; }
        const_iterator operator-(long offset) const { const_iterator result(*this); result -= offset; return result; }
        long operator-(const const_iterator& rOther) const { return mPointer - rOther.mPointer; }
        bool operator==(const const_iterator& rOther) const { return mPointer == rOther.mPointer; }
        bool operator!=(const const_iterator& rOther) const { return mPointer != rOther.mPointer; }
        bool operator<(const const_iterator& rOther) const { return mPointer < rOther.mPointer; }
    private:
        void* const* mPointer;
    };


    vector() {}
    ~vector() {}

    using base::size;

    iterator begin() { return iterator(this->data_); }
    const_iterator begin() const { void* const* pBegin = this->data_; return const_iterator(pBegin); }
    iterator end() { void** pEnd = this->data_ + this->size_; return iterator(pEnd); }
    const_iterator end() const { void* const* pEnd = this->data_ + this->size_; return const_iterator(pEnd); }

    T*& operator[](size_type i) { return reinterpret_cast<T**>(base::begin())[i]; }

    vector& operator=(const vector& x) {
        base::operator=(x);
        return *this;
    }

    void reserve(size_type n) { base::reserve(n); }
    void push_back(T* const& x) { base::push_back(x); }
    T*& back() { return reinterpret_cast<T*&>(base::back()); }
    void pop_back() { base::pop_back(); }
};

template <typename Allocator> class __vec_integer : public __vec_constructor<unsigned long, Allocator, true> {};

template <typename Allocator> class vector<unsigned long, Allocator> : private __vec_integer<Allocator> {
    typedef __vec_integer<Allocator> base;

public:
    typedef unsigned long value_type;
    typedef unsigned long* iterator;
    typedef const unsigned long* const_iterator;
    typedef unsigned long size_type;

    vector() {}
    ~vector() {}

    iterator begin() { return this->data_; }
    const_iterator begin() const { return this->data_; }
    iterator end() { return this->data_ + this->size_; }
    const_iterator end() const { return this->data_ + this->size_; }
    size_type size() const { return this->size_; }
    bool empty() const { return this->size_ == 0; }
    void push_back(const unsigned long& x) { base::push_back(x); }
    void clear() { base::clear(); }
    unsigned long& operator[](size_type i) { return this->data_[i]; }
};

