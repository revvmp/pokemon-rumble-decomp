namespace std {

static inline void __throw_vector_length_error() {
    throw length_error("vector length error");
}

template <typename T, typename Allocator, bool IsPOD> class __vec_constructor;

template <typename T, typename Allocator> class __vec_deleter {
public:
    typedef unsigned long size_type;
    typedef typename Metrowerks::compressed_pair<size_type, Allocator>::second_param allocator_param;
    typedef Metrowerks::int2type<Metrowerks::is_POD<T>::value> pod_type;

    __vec_deleter() : data_(nullptr), size_(0), capacity_(0) {}
    explicit __vec_deleter(allocator_param a) : data_(nullptr), size_(0), capacity_(0, a) {}
    ~__vec_deleter();

    void clear() { size_type n = size_; erase_at_end(n, pod_type()); }

    size_type& cap() { return capacity_.first(); }
    Allocator& alloc() { return capacity_.second(); }
    const Allocator& alloc() const { return capacity_.second(); }
    size_type max_size() const { return alloc().max_size(); }

    void allocate(size_type n) { allocate(n, pod_type()); }
    void allocate(size_type n, pod_type);

    void construct_at_end(T* pFirst, T* pLast) { construct_at_end(pFirst, pLast, pod_type()); }
    void construct_at_end(T* pFirst, T* pLast, Metrowerks::int2type<true>) {
        ptrdiff_t n = pLast - pFirst;
        memcpy(data_ + size_, pFirst, n * sizeof(T));
        memset(pFirst, 0, n * sizeof(T));
        size_ += n;
    }
    void construct_at_end(const T* pFirst, const T* pLast, Metrowerks::int2type<true>) {
        ptrdiff_t n = pLast - pFirst;
        memcpy(data_ + size_, pFirst, n * sizeof(T));
        size_ += n;
    }
    void construct_at_end(const T* pFirst, const T* pLast, Metrowerks::int2type<false>) {
        for (T* p = data_ + size_; pFirst != pLast; ++pFirst, ++p) {
            capacity_.second().construct(p, *pFirst);
            ++size_;
        }
    }

    T* data_;
    size_type size_;
    Metrowerks::compressed_pair<size_type, Allocator> capacity_;

protected:
    void erase_at_end(size_type n, Metrowerks::int2type<false>) {
        T* p = data_ + size_;
        size_ -= n;
        for (; n != 0; --n) {
            --p;
            capacity_.second().destroy(p);
        }
    }
    void erase_at_end(size_type& n, Metrowerks::int2type<true>) { size_ -= n; }

private:
    __vec_deleter(const __vec_deleter&);
    __vec_deleter& operator=(const __vec_deleter&);
};

template <typename T, typename Allocator> __vec_deleter<T, Allocator>::~__vec_deleter() {
    if (data_) {
        clear();
        capacity_.second().deallocate(data_, capacity_.first());
    }
}

template <typename T, typename Allocator> class __vec_split_buffer : public __vec_deleter<T, Allocator&> {
    typedef __vec_deleter<T, Allocator&> base;

public:
    typedef typename base::size_type size_type;
    typedef typename base::pod_type pod_type;

    explicit __vec_split_buffer(Allocator& a) : base(a), start_(0) {}
    ~__vec_split_buffer();

    T* begin() { return this->data_ + start_; }
    T* end() { return begin() + this->size_; }

    void construct_at_end(size_type n, pod_type) {
        for (T* p = end(); n != 0; --n, ++p) {
            this->capacity_.second().construct(p, T());
            ++this->size_;
        }
    }

    void construct_at_front(T* pFirst, T* pLast, Metrowerks::int2type<true>) {
        ptrdiff_t n = pLast - pFirst;
        start_ -= n;
        memcpy(begin(), pFirst, n * sizeof(T));
        memset(pFirst, 0, n * sizeof(T));
        this->size_ += n;
    }
    void construct_at_front(T* pFirst, T* pLast, Metrowerks::int2type<false>) {
        for (T* p = begin(); pLast > pFirst;) {
            --p;
            --pLast;
            this->capacity_.second().construct(p, *pLast);
            --start_;
            ++this->size_;
        }
    }

    size_type start_;
};

template <typename T, typename Allocator> __vec_split_buffer<T, Allocator>::~__vec_split_buffer() {
    T* first = begin();
    for (T* p = first + this->size_; p > first;) {
        --p;
        this->capacity_.second().destroy(p);
    }
    this->size_ = 0;
}

template <typename T, typename Allocator, bool IsPOD> class __vec_constructor : public __vec_deleter<T, Allocator> {
    typedef __vec_deleter<T, Allocator> base;

public:
    typedef typename base::size_type size_type;
    typedef typename base::pod_type pod_type;

    __vec_constructor() {}
    explicit __vec_constructor(size_type n) {
        if (n != 0) {
            allocate(n, pod_type());
            construct_at_end(n, pod_type());
        }
    }
    __vec_constructor(const __vec_constructor& x) : base() {
        const T* first = x.data_;
        const T* last = x.data_ + x.size_;
        size_type n = last - first;
        if (n != 0) {
            allocate(n, pod_type());
            base::construct_at_end(first, last, pod_type());
        }
    }

    size_type max_size() const { return size_type(-1) / sizeof(T); }

    T* begin() { return this->data_; }
    T* end() { return this->data_ + this->size_; }
    size_type size() const { return this->size_; }
    T& back() { return this->data_[this->size_ - 1]; }

    void reserve(size_type n) {
        if (n > this->cap()) {
            reallocate(n);
        }
    }

    void push_back(const T& x) { push_back(x, pod_type()); }
    void pop_back() { pop_back(pod_type()); }
    void clear() { clear(pod_type()); }

protected:
    void reallocate(size_type n);

    void push_back(const T& x, Metrowerks::int2type<true>) {
        if (this->size_ < this->cap()) {
            ++this->size_;
            back() = x;
        } else if (grow_by(1, pod_type())) {
            ++this->size_;
            back() = x;
        } else {
            push_back_realloc(x);
        }
    }

    void push_back(const T& x, Metrowerks::int2type<false>) {
        if (this->size_ < this->cap()) {
            this->alloc().construct(end(), x);
            ++this->size_;
        } else {
            push_back_realloc(x);
        }
    }

    void push_back_realloc(const T& x) { push_back_realloc(x, pod_type()); }
    void push_back_realloc(const T& x, Metrowerks::int2type<false>);
    void push_back_realloc(const T& x, Metrowerks::int2type<true>) {
        __vec_split_buffer<T, Allocator> buffer(this->capacity_.second());
        size_type capacity = grow_by(1);
        if (capacity > max_size()) {
            __throw_vector_length_error();
        }
        buffer.data_ = buffer.capacity_.second().allocate(capacity);
        buffer.capacity_.first() = capacity;
        buffer.start_ = this->size_;
        *buffer.end() = x;
        ++buffer.size_;
        buffer.construct_at_front(this->data_, this->data_ + this->size_, pod_type());
        this->size_ = 0;
        swap(buffer, pod_type());
    }

    void pop_back(Metrowerks::int2type<true>) { --this->size_; }
    void clear(Metrowerks::int2type<true>) { this->size_ = 0; }

    void allocate(size_type n, pod_type) {
        if (n > max_size()) {
            __throw_vector_length_error();
        }
        this->data_ = this->capacity_.second().allocate(n);
        this->capacity_.first() = n;
    }

    void construct_at_end(size_type n, pod_type) {
        for (T* p = this->data_ + this->size_; n != 0; --n, ++p) {
            this->capacity_.second().construct(p, T());
            ++this->size_;
        }
    }

    size_type recommend(size_type n) {
        size_type capacity = this->capacity_.first();
        if (n > max_size() - capacity) {
            __throw_vector_length_error();
        }
        size_type result;
        if (capacity < max_size() / 3) {
            result = capacity + max((capacity + 1) * 3 / 5, n);
        } else if (capacity < max_size() / 3 * 2) {
            result = capacity + max((capacity + 1) / 2, n);
        } else {
            result = max_size();
        }
        return result;
    }
    size_type grow_by(size_type n) { return recommend(this->size_ + n - this->capacity_.first()); }
    bool grow_by(size_type n, pod_type) {
        recommend(n);
        return false;
    }

    void append_realloc(size_type n) {
        __vec_split_buffer<T, Allocator> buffer(this->capacity_.second());
        size_type capacity = grow_by(n);
        if (capacity > max_size()) {
            __throw_vector_length_error();
        }
        buffer.data_ = buffer.capacity_.second().allocate(capacity);
        buffer.capacity_.first() = capacity;
        buffer.start_ = this->size_;
        buffer.construct_at_end(n, pod_type());
        buffer.construct_at_front(this->data_, this->data_ + this->size_, pod_type());
        swap(buffer, pod_type());
    }

    void append(size_type n, pod_type) {
        size_type capacity = this->capacity_.first();
        if ((n <= capacity && this->size_ <= capacity - n) || grow_by(this->size_ + n - capacity, pod_type())) {
            construct_at_end(n, pod_type());
        } else {
            append_realloc(n);
        }
    }

    void swap(__vec_deleter<T, Allocator&>& r, pod_type) {
        size_type capacity = this->capacity_.first();
        this->capacity_.first() = r.capacity_.first();
        r.capacity_.first() = capacity;
        T* data = this->data_;
        this->data_ = r.data_;
        r.data_ = data;
        size_type size = this->size_;
        this->size_ = r.size_;
        r.size_ = size;
    }
};

template <typename T, typename Allocator, bool IsPOD>
void __vec_constructor<T, Allocator, IsPOD>::reallocate(size_type n) {
    base buffer(this->alloc());
    buffer.allocate(n);
    buffer.construct_at_end(begin(), end());
    clear();
    std::swap(this->cap(), buffer.cap());
    std::swap(this->data_, buffer.data_);
    std::swap(this->size_, buffer.size_);
}

template <typename T, typename Allocator> void __vec_deleter<T, Allocator>::allocate(size_type n, pod_type) {
    if (n > max_size()) {
        __throw_vector_length_error();
    }
    data_ = alloc().allocate(n, 0);
    cap() = n;
}

template <typename T, typename Allocator = allocator<T> >
class vector : private __vec_constructor<T, Allocator, Metrowerks::is_POD<T>::value> {
    typedef __vec_constructor<T, Allocator, Metrowerks::is_POD<T>::value> base;

public:
    typedef T value_type;
    typedef T* iterator;
    typedef const T* const_iterator;
    typedef typename base::size_type size_type;
    typedef typename base::pod_type pod_type;

    vector() {}
    explicit vector(size_type n) : base(n) {}
    vector(const vector& x) : base(x) {}
    ~vector() {}

    void resize(size_type n) {
        size_type size = this->size_;
        if (n > size) {
            this->append(n - size, pod_type());
        } else if (n < size) {
            this->erase_at_end(size - n, pod_type());
        }
    }

    iterator begin() { return this->data_; }
    const_iterator begin() const { return this->data_; }
    iterator end() { return this->data_ + this->size_; }
    const_iterator end() const { return this->data_ + this->size_; }
    size_type size() const { return this->size_; }
    bool empty() const { return this->size_ == 0; }
    void push_back(const T& x) { base::push_back(x); }
    T& operator[](size_type i) { return this->data_[i]; }
    const T& operator[](size_type i) const { return this->data_[i]; }
};

template <typename T, typename Allocator> class __vec_pointer : public __vec_constructor<void*, allocator<void*>, true> {
    typedef __vec_constructor<void*, allocator<void*>, true> base;

public:
    void push_back(T* const& x) { base::push_back(reinterpret_cast<void* const&>(x)); }
};

template <typename T, typename Allocator> class vector<T*, Allocator> : private __vec_pointer<T, Allocator> {
    typedef __vec_pointer<T, Allocator> base;

public:
    typedef T* value_type;
    typedef unsigned long size_type;

    vector() {}
    ~vector() {}

    using base::size;

    void reserve(size_type n) { base::reserve(n); }
    void push_back(T* const& x) { base::push_back(x); }
    T*& back() { return reinterpret_cast<T*&>(base::back()); }
    void pop_back() { base::pop_back(); }
};

