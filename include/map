template <typename T> struct map_pointer_key { enum { value = false }; };
template <typename T> struct map_pointer_key<T*> { enum { value = true }; };

template <typename Key, typename T, typename Compare> struct map_transform { enum { value = false }; };
template <typename Key, typename T> struct map_transform<Key, T, less<Key> > {
    enum { value = (Metrowerks::is_POD<T>::value && sizeof(T) == sizeof(void*)) || map_pointer_key<Key>::value };
};

template <typename Key, typename T, typename Compare> struct map_iterator_transform { enum { value = false }; };
template <typename Key, typename T> struct map_iterator_transform<Key, T, less<Key> > {
    enum { value = Metrowerks::is_scalar<T>::value || map_pointer_key<Key>::value };
};

template <typename Key, typename T, typename Compare> struct map_base_value_compare {
    bool operator()(const pair<const Key, T>& rLeft, const pair<const Key, T>& rRight) const {
        return Compare()(rLeft.first, rRight.first);
    }
};

template <typename Key, typename T, typename Compare> struct map_value_compare {
    typedef pair<const Key, T> value_type;
    map_value_compare() {}
    bool operator()(const value_type& rLeft, const value_type& rRight) const { return Compare()(rLeft.first, rRight.first); }
    bool operator()(const value_type& rLeft, const Key& rKey) const { return Compare()(rLeft.first, rKey); }
    bool operator()(const Key& rKey, const value_type& rRight) const { return Compare()(rKey, rRight.first); }
};

template <typename Key, typename T, typename Compare> class map_member_compare {
public:
    typedef pair<const Key, T> value_type;
    bool operator()(const value_type& rLeft, const value_type& rRight) const { return comp(rLeft.first, rRight.first); }
    bool operator()(const value_type& rLeft, const Key& rKey) const { return comp(rLeft.first, rKey); }
    bool operator()(const Key& rKey, const value_type& rRight) const { return comp(rKey, rRight.first); }

protected:
    Compare comp;
};

template <typename Key, typename T, typename Compare, bool IsPOD> struct map_tree_compare {
    typedef map_member_compare<Key, T, Compare> type;
};
template <typename Key, typename T> struct map_tree_compare<Key, T, less<Key>, true> {
    typedef map_value_compare<Key, T, less<Key> > type;
};

template <typename T, typename Compare, typename Allocator> class map_compact_tree : public __red_black_tree<tree_node_base*> {
public:
    typedef unsigned long size_type;

    struct node : tree_node_base {
        T value_;
    };

    typedef typename Allocator::template rebind<node>::other node_allocator;

    map_compact_tree() : alloc_(Allocator(), size_type(0)), comp_(Compare(), reinterpret_cast<node*>(&node_alloc_.second())) {}
    map_compact_tree(const map_compact_tree& rOther) : alloc_(Allocator(), size_type(0)), comp_(Compare(), reinterpret_cast<node*>(&node_alloc_.second())) {
        copy(rOther);
    }
    ~map_compact_tree() {
        if (root() != nullptr) {
            destroy(static_cast<node*>(root()));
        }
    }
    map_compact_tree& operator=(const map_compact_tree& rOther) {
        if (this != &rOther) {
            clear();
            copy(rOther);
        }
        return *this;
    }
    void clear() {
        if (root() != nullptr) {
            destroy(static_cast<node*>(root()));
            sz() = 0;
            root() = nullptr;
            front() = end_node();
        }
    }
    __attribute__((noinline)) void copy_children(node* pDestination, node* pSource, bool left) {
        node_allocator& nodeAllocator = node_alloc_.first();
        Metrowerks::alloc_ptr<node, node_allocator&> pNode(nodeAllocator.allocate(1), nodeAllocator);
        pNode.get()->left_ = pNode.get()->right_ = nullptr;
        pNode.get()->set_parent(pDestination);
        if (left) {
            alloc_.first().construct(&pNode.get()->value_, static_cast<node*>(pSource->left_)->value_);
            front() = pNode.get();
            pDestination->left_ = pNode.release();
            pDestination = static_cast<node*>(pDestination->left_);
            pSource = static_cast<node*>(pSource->left_);
        } else {
            alloc_.first().construct(&pNode.get()->value_, static_cast<node*>(pSource->right_)->value_);
            pDestination->right_ = pNode.release();
            pDestination = static_cast<node*>(pDestination->right_);
            pSource = static_cast<node*>(pSource->right_);
        }
        if (pSource->parent_.bit()) {
            pDestination->set_red();
        } else {
            pDestination->set_black();
        }
        ++sz();
        if (pSource->right_ != nullptr) {
            copy_children(pDestination, pSource, false);
        }
        if (pSource->left_ != nullptr) {
            copy_children(pDestination, pSource, true);
        }
    }
    __attribute__((noinline)) void copy(const map_compact_tree& rOther) {
        if (rOther.root() != nullptr) {
            node_allocator& nodeAllocator = node_alloc_.first();
            Metrowerks::alloc_ptr<node, node_allocator&> pNode(nodeAllocator.allocate(1), nodeAllocator);
            alloc_.first().construct(&pNode.get()->value_, static_cast<node*>(rOther.root())->value_);
            map_compact_tree temporary;
            pNode.get()->left_ = pNode.get()->right_ = nullptr;
            pNode.get()->set_parent(temporary.end_node());
            if (rOther.root()->parent_.bit()) {
                pNode.get()->set_red();
            } else {
                pNode.get()->set_black();
            }
            temporary.root() = pNode.release();
            temporary.sz() = 1;
            temporary.front() = temporary.root();
            if (rOther.root()->right_ != nullptr) {
                temporary.copy_children(static_cast<node*>(temporary.root()), static_cast<node*>(rOther.root()), false);
            }
            if (rOther.root()->left_ != nullptr) {
                temporary.copy_children(static_cast<node*>(temporary.root()), static_cast<node*>(rOther.root()), true);
            }
            swap(temporary);
        }
    }

    typedef T value_type;
    class iterator {
    public:
        iterator() {}
        iterator(const iterator& rOther) : node_(rOther.node_) {}
        iterator(tree_node_base* pNode) : node_(pNode) {}
        T& operator*() const { return static_cast<node*>(node_)->value_; }
        T* operator->() const { return &static_cast<node*>(node_)->value_; }
        iterator& operator++() {
            tree_node_base* pNode = node_->right_;
            if (pNode != nullptr) {
                while (pNode->left_ != nullptr) {
                    pNode = pNode->left_;
                }
                node_ = pNode;
            } else {
                while (node_ != node_->parent()->left_) {
                    node_ = node_->parent();
                }
                node_ = node_->parent();
            }
            return *this;
        }
        bool operator==(const iterator& rOther) const { return node_ == rOther.node_; }
        bool operator!=(const iterator& rOther) const { return node_ != rOther.node_; }
        tree_node_base* node_;
    };
    iterator begin() { return iterator(front()); }
    template <typename Key> tree_node_base* find_leaf(const Key& key, node*& rpPred, bool& rLeft, bool& rLeftmost);
    template <typename Key> value_type& find_or_insert(const Key& key) {
        node* pPred;
        bool left;
        bool leftmost;
        tree_node_base* pParent = find_leaf(key, pPred, left, leftmost);
        if (pPred == nullptr || pPred->value_.first < key) {
            return insert_node_at(pParent, left, leftmost, value_type(key, typename value_type::second_type()))->value_;
        }
        return pPred->value_;
    }
    template <typename Key> iterator find(const Key& key) { return find_key(key); }
    iterator end() { return iterator(end_node()); }
    void erase(iterator position) {
        tree_node_base* pNode = position.node_;
        if (pNode == front()) {
            iterator next(pNode);
            ++next;
            front() = next.node_;
        }
        __red_black_tree<tree_node_base*>::balance_erase(pNode, root());
        alloc_.first().destroy(&static_cast<node*>(pNode)->value_);
        ::operator delete(pNode);
        --sz();
    }
    iterator erase_next(iterator position) {
        tree_node_base* pNode = position.node_;
        if (pNode == front()) {
            front() = (++iterator(position)).node_;
        }
        tree_node_base* pNext = __red_black_tree<tree_node_base*>::balance_erase(pNode, root());
        alloc_.first().destroy(&static_cast<node*>(pNode)->value_);
        ::operator delete(pNode);
        --sz();
        return iterator(pNext);
    }
    template <typename Key> iterator lower_bound_key(const Key& key) {
        tree_node_base* pBest = end_node();
        tree_node_base* pNode = root();
        while (pNode != nullptr) {
            if (!(static_cast<node*>(pNode)->value_.first < key)) {
                pBest = pNode;
                pNode = pNode->left_;
            } else {
                pNode = pNode->right_;
            }
        }
        return iterator(pBest);
    }
    template <typename Key> iterator find_key(const Key& key) {
        iterator it = lower_bound_key(key);
        if (it == end() || key < it->first) {
            return end();
        }
        return it;
    }
    void swap(map_compact_tree& rOther) {
        if (this == &rOther) {
            return;
        }
        std::swap(alloc_, rOther.alloc_);
        std::swap(node_alloc_, rOther.node_alloc_);
        std::swap(comp_, rOther.comp_);
        if (root() != nullptr) {
            root()->set_parent(end_node());
        } else {
            front() = end_node();
        }
        if (rOther.root() != nullptr) {
            rOther.root()->set_parent(rOther.end_node());
        } else {
            rOther.front() = rOther.end_node();
        }
    }
    tree_node_base* end_node() { return reinterpret_cast<tree_node_base*>(&node_alloc_.second()); }
    pair<iterator, bool> insert_one(const value_type& rValue) {
        node* pPred;
        bool left;
        bool leftmost;
        tree_node_base* pParent = find_leaf(rValue, pPred, left, leftmost);
        if (pPred == nullptr || Compare()(pPred->value_, rValue)) {
            return pair<iterator, bool>(iterator(insert_node_at(pParent, left, leftmost, rValue)), true);
        }
        return pair<iterator, bool>(iterator(pPred), false);
    }
    tree_node_base* find_leaf(const value_type& rValue, node*& rpPred, bool& rLeft, bool& rLeftmost);
    node* insert_node_at(tree_node_base* pParent, bool left, bool leftmost, const value_type& rValue);

    size_type size() const { return sz(); }
    void destroy(node* pNode);

private:
    struct anchor { anchor() : left_(nullptr) {} tree_node_base* left_; };
    Metrowerks::compressed_pair<Allocator, size_type> alloc_;
    Metrowerks::compressed_pair<node_allocator, anchor> node_alloc_;
    Metrowerks::compressed_pair<Compare, tree_node_base*> comp_;
    size_type& sz() { return alloc_.second(); }
    size_type sz() const { return alloc_.second(); }
    tree_node_base*& root() { return node_alloc_.second().left_; }
    tree_node_base* root() const { return node_alloc_.second().left_; }
    tree_node_base*& front() { return comp_.second(); }
    tree_node_base* front() const { return comp_.second(); }
};

template <typename T, typename Compare, typename Allocator>
void map_compact_tree<T, Compare, Allocator>::destroy(node* pNode) {
    if (pNode->left_ != nullptr) {
        destroy(static_cast<node*>(pNode->left_));
    }
    if (pNode->right_ != nullptr) {
        destroy(static_cast<node*>(pNode->right_));
    }
    alloc_.first().destroy(&pNode->value_);
    ::operator delete(pNode);
}

template <typename T, typename Compare, typename Allocator>
template <typename Key> tree_node_base* map_compact_tree<T, Compare, Allocator>::find_leaf(const Key& key, node*& rpPred, bool& rLeft, bool& rLeftmost) {
        rpPred = nullptr;
        node* pLeaf = static_cast<node*>(end_node());
        node* pNode = static_cast<node*>(root());
        rLeft = true;
        rLeftmost = true;
        while (pNode != nullptr) {
            pLeaf = pNode;
            if (key < pNode->value_.first) {
                pNode = static_cast<node*>(pNode->left_);
                rLeft = true;
            } else {
                rpPred = pLeaf;
                pNode = static_cast<node*>(pNode->right_);
                rLeft = false;
                rLeftmost = false;
            }
        }
        return pLeaf;
    }

template <typename T, typename Compare, typename Allocator>
typename map_compact_tree<T, Compare, Allocator>::node* map_compact_tree<T, Compare, Allocator>::insert_node_at(tree_node_base* pParent, bool left, bool leftmost, const value_type& rValue) {
    if (sz() == size_type(-1)) {
        throw length_error("tree::insert length error");
    }
    Metrowerks::alloc_ptr<node, node_allocator&> holder(node_alloc_.first().allocate(1), node_alloc_.first());
    alloc_.first().construct(&holder.get()->value_, rValue);
    node* pNode = holder.release();
    pNode->right_ = nullptr;
    pNode->left_ = nullptr;
    new (&pNode->parent_) unsigned long(reinterpret_cast<unsigned long>(pParent));
    if (left) {
        pParent->left_ = pNode;
    } else {
        pParent->right_ = pNode;
    }
    ++sz();
    __red_black_tree<tree_node_base*>::balance_insert(pNode, root());
    if (leftmost) {
        front() = pNode;
    }
    return pNode;
}

template <typename T, typename Compare, typename Allocator>
tree_node_base* map_compact_tree<T, Compare, Allocator>::find_leaf(const value_type& rValue, node*& rpPred, bool& rLeft, bool& rLeftmost) {
    rpPred = nullptr;
    node* pLeaf = static_cast<node*>(end_node());
    node* pNode = static_cast<node*>(root());
    rLeft = true;
    rLeftmost = true;
    while (pNode != nullptr) {
        pLeaf = pNode;
        if (Compare()(rValue, pNode->value_)) {
            pNode = static_cast<node*>(pNode->left_);
            rLeft = true;
        } else {
            rpPred = pLeaf;
            pNode = static_cast<node*>(pNode->right_);
            rLeft = false;
            rLeftmost = false;
        }
    }
    return pLeaf;
}

template <typename T, typename Compare, typename Allocator> class map_compact_red_black_tree : public map_compact_tree<T, Compare, Allocator> {};
template <typename T, typename Compare, typename Allocator> class map_compact_tree_adapter : public map_compact_red_black_tree<T, Compare, Allocator> {
public:
    template <typename Key> T& find_or_insert(const Key& key) { return map_compact_red_black_tree<T, Compare, Allocator>::find_or_insert(key); }
};

template <typename T, typename Compare, typename BaseCompare, typename Allocator, bool Compact> struct map_tree_selection {
    typedef tree<T, Compare, Allocator> type;
};
template <typename T, typename Compare, typename BaseCompare, typename Allocator> struct map_tree_selection<T, Compare, BaseCompare, Allocator, true> {
    typedef map_compact_tree_adapter<T, BaseCompare, Allocator> type;
};

