namespace detail {

template <typename Key, typename T, typename Compare, typename Allocator> class map_base {
public:
    typedef Key key_type;
    typedef T mapped_type;
    typedef pair<const Key, T> value_type;
    typedef Compare key_compare;
    typedef Allocator allocator_type;

    typedef typename map_tree_compare<Key, T, Compare, Metrowerks::is_POD<T>::value>::type value_compare;

private:
    typedef map_base_value_compare<Key, T, Compare> base_value_compare;
    typedef typename map_tree_selection<value_type, value_compare, base_value_compare, allocator_type, map_transform<Key, T, Compare>::value>::type tree_type;

public:
    typedef typename tree_type::size_type size_type;

    class iterator {
    public:
        iterator() {}
        iterator(const iterator& rOther) : mIterator(rOther.mIterator) {}
        iterator(const typename tree_type::iterator& rIterator) : mIterator(rIterator) {}
        operator typename tree_type::iterator() const { return mIterator; }
        value_type* operator->() const { return mIterator.operator->(); }
        value_type& operator*() const { return *mIterator; }
        iterator& operator++() {
            ++mIterator;
            return *this;
        }
        bool operator==(const iterator& rOther) const { return mIterator == rOther.mIterator; }
        bool operator!=(const iterator& rOther) const { return mIterator != rOther.mIterator; }

        typename tree_type::iterator mIterator;
    };

    typedef typename Metrowerks::select<map_iterator_transform<Key, T, Compare>::value, iterator, typename tree_type::iterator>::type native_iterator;

    void swap(map_base& rOther) { tree_.swap(rOther.tree_); }
    native_iterator begin() { return tree_.begin(); }
    native_iterator end() { return tree_.end(); }
    size_type size() const { return tree_.size(); }
    bool empty() const { return tree_.size() == 0; }
    void clear() { tree_.clear(); }

    pair<native_iterator, bool> insert(const value_type& rValue) {
        return tree_.insert_one(rValue);
    }
    native_iterator find(const key_type& rKey) { return tree_.find(rKey); }
    native_iterator erase(native_iterator position);
    native_iterator find(const key_type& rKey) const { return const_cast<tree_type&>(tree_).find(rKey); }
    native_iterator end() const { return const_cast<map_base*>(this)->end(); }
    mapped_type& operator[](const key_type& rKey) { return find_or_insert(rKey).second; }

private:
    value_type& find_or_insert(const key_type& rKey) { return find_or_insert_impl(tree_, rKey); }
    template <typename Tree> static value_type& find_or_insert_impl(Tree& rTree, const key_type& rKey) { return rTree.find_or_insert(rKey); }
    typedef typename Metrowerks::select<Metrowerks::is_POD<T>::value || !Metrowerks::is_POD<Key>::value, map_base, tree_type>::type deferred_tree_type;
    static value_type& find_or_insert_impl(deferred_tree_type& rTree, const key_type& rKey);
    native_iterator erase_impl(native_iterator position, Metrowerks::int2type<1>) { return iterator(tree_.erase_next(position)); }
    native_iterator erase_impl(native_iterator position, Metrowerks::int2type<0>) { return tree_.erase(position); }
    tree_type tree_;
    template <typename, typename, typename, typename> friend class std::map;
};

template <typename Key, typename T, typename Compare, typename Allocator>
typename map_base<Key, T, Compare, Allocator>::native_iterator map_base<Key, T, Compare, Allocator>::erase(native_iterator position) {
    Metrowerks::int2type<map_iterator_transform<Key, T, Compare>::value> tag;
    return erase_impl(position, tag);
}

template <typename Key, typename T, typename Compare, typename Allocator>
typename map_base<Key, T, Compare, Allocator>::value_type& map_base<Key, T, Compare, Allocator>::find_or_insert_impl(deferred_tree_type& rTree, const key_type& rKey) { return rTree.find_or_insert(rKey); }

}

template <typename Key, typename T, typename Compare = less<Key>, typename Allocator = allocator<pair<const Key, T> > >
class map : public detail::map_base<Key, T, Compare, Allocator> {
    typedef detail::map_base<Key, T, Compare, Allocator> base;
public:
    typedef typename base::native_iterator iterator;
    typedef typename base::value_type value_type;
    pair<iterator, bool> insert(const value_type& rValue) { return base::insert(rValue); }
    map() {}
    ~map() {}
};

template <typename Key, typename T> class map<Key*, T*, less<Key*>, allocator<pair<Key* const, T*> > > {
    typedef pair<const void* const, unsigned long> base_value_type;
    typedef detail::map_base_value_compare<const void*, unsigned long, less<const void*> > base_compare;
    typedef detail::map_compact_tree<base_value_type, base_compare, allocator<base_value_type> > tree_type;
public:
    typedef Key* key_type;
    typedef T* mapped_type;
    typedef pair<key_type const, mapped_type> value_type;
    typedef less<Key*> key_compare;
    typedef allocator<value_type> allocator_type;
    typedef unsigned long size_type;
    class iterator {
    public:
        iterator() {}
        iterator(const iterator& rOther) : mIterator(rOther.mIterator) {}
        explicit iterator(const typename tree_type::iterator& rIterator) : mIterator(rIterator) {}
        value_type* operator->() const { return reinterpret_cast<value_type*>(mIterator.operator->()); }
        value_type& operator*() const { return *operator->(); }
        iterator& operator++() {
            ++mIterator;
            return *this;
        }
        bool operator==(const iterator& rOther) const { return mIterator == rOther.mIterator; }
        bool operator!=(const iterator& rOther) const { return mIterator != rOther.mIterator; }
        typename tree_type::iterator mIterator;
    };
    typedef iterator const_iterator;
    map() {}
    ~map() {}
    iterator begin() { return iterator(mTree.begin()); }
    iterator end() { return iterator(mTree.end()); }
    iterator find(const key_type& rKey) { return iterator(mTree.find(static_cast<const void*>(rKey))); }
    void erase(iterator position) { mTree.erase(position.mIterator); }
    size_type size() const { return mTree.size(); }
    bool empty() const { return mTree.size() == 0; }
    pair<iterator, bool> insert(const value_type& rValue) {
        pair<typename tree_type::iterator, bool> result = mTree.insert_one(reinterpret_cast<const base_value_type&>(rValue));
        return pair<iterator, bool>(iterator(result.first), result.second);
    }
private:
    tree_type mTree;
};

template <typename T> class map<unsigned long, T*, less<unsigned long>, allocator<pair<const unsigned long, T*> > > {
    typedef pair<const unsigned long, unsigned long> base_value_type;
    typedef detail::map_base_value_compare<unsigned long, unsigned long, less<unsigned long> > base_compare;
    typedef detail::map_base<unsigned long, unsigned long, less<unsigned long>, allocator<base_value_type> > base_type;
    typedef detail::map_compact_tree_adapter<base_value_type, base_compare, allocator<base_value_type> > tree_type;
public:
    typedef unsigned long key_type;
    typedef T* mapped_type;
    typedef pair<key_type const, mapped_type> value_type;
    typedef less<unsigned long> key_compare;
    typedef allocator<value_type> allocator_type;
    typedef unsigned long size_type;
    class iterator {
    public:
        iterator() {}
        iterator(const iterator& rOther) : mIterator(rOther.mIterator) {}
        explicit iterator(const typename tree_type::iterator& rIterator) : mIterator(rIterator) {}
        value_type* operator->() const { return reinterpret_cast<value_type*>(mIterator.operator->()); }
        value_type& operator*() const { return *operator->(); }
        iterator& operator++() {
            ++mIterator;
            return *this;
        }
        bool operator==(const iterator& rOther) const { return mIterator == rOther.mIterator; }
        bool operator!=(const iterator& rOther) const { return mIterator != rOther.mIterator; }
        typename tree_type::iterator mIterator;
    };
    typedef iterator const_iterator;
    map() {}
    ~map() {}
    iterator begin() { return iterator(mBase.tree_.begin()); }
    iterator end() { return iterator(mBase.tree_.end()); }
    iterator find(const key_type& rKey) { return iterator(mBase.tree_.find(rKey)); }
    void erase(iterator position) { mBase.tree_.erase(position.mIterator); }
    size_type size() const { return mBase.tree_.size(); }
    bool empty() const { return mBase.tree_.size() == 0; }
    pair<iterator, bool> insert(const value_type& rValue) {
        pair<typename tree_type::iterator, bool> result = mBase.tree_.insert_one(reinterpret_cast<const base_value_type&>(rValue));
        return pair<iterator, bool>(iterator(result.first), result.second);
    }
private:
    base_type mBase;
};

