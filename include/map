#ifndef _MAP
#define _MAP

#include <MSL_CPP/allocator.h>
#include <MSL_CPP/msl_utility.h>
#include <MSL_CPP/detail/tree.h>
#include <utility>

namespace std {

namespace detail {

template <typename T> struct map_pointer_key { enum { value = false }; };
template <typename T> struct map_pointer_key<T*> { enum { value = true }; };

template <typename Key, typename T, typename Compare> struct map_transform { enum { value = false }; };
template <typename Key, typename T> struct map_transform<Key, T, less<Key> > {
    enum { value = (Metrowerks::is_POD<T>::value && sizeof(T) == sizeof(void*)) || map_pointer_key<Key>::value };
};

template <typename Key, typename T, typename Compare> struct map_base_value_compare {
    bool operator()(const pair<const Key, T>& rLeft, const pair<const Key, T>& rRight) const {
        return Compare()(rLeft.first, rRight.first);
    }
};

template <typename Key, typename T, typename Compare> struct map_value_compare {
    typedef pair<const Key, T> value_type;
    map_value_compare() {}
    bool operator()(const value_type& rLeft, const value_type& rRight) const { return Compare()(rLeft.first, rRight.first); }
    bool operator()(const value_type& rLeft, const Key& rKey) const { return Compare()(rLeft.first, rKey); }
    bool operator()(const Key& rKey, const value_type& rRight) const { return Compare()(rKey, rRight.first); }
};

template <typename Key, typename T, typename Compare> class map_member_compare {
public:
    typedef pair<const Key, T> value_type;
    bool operator()(const value_type& rLeft, const value_type& rRight) const { return comp(rLeft.first, rRight.first); }
    bool operator()(const value_type& rLeft, const Key& rKey) const { return comp(rLeft.first, rKey); }
    bool operator()(const Key& rKey, const value_type& rRight) const { return comp(rKey, rRight.first); }

protected:
    Compare comp;
};

template <typename Key, typename T, typename Compare, bool IsPOD> struct map_tree_compare {
    typedef map_member_compare<Key, T, Compare> type;
};
template <typename Key, typename T, typename Compare> struct map_tree_compare<Key, T, Compare, true> {
    typedef map_value_compare<Key, T, Compare> type;
};

template <typename T, typename Compare, typename Allocator> class map_compact_tree : private Compare, private Allocator {
public:
    typedef unsigned long size_type;

    struct node : tree_node_base {
        T value_;
    };

    typedef typename Allocator::template rebind<node>::other node_allocator;

    map_compact_tree() : size_(0), begin_(end_node()) {}
    ~map_compact_tree() {
        if (root_.second() != nullptr) {
            destroy(static_cast<node*>(root_.second()));
        }
    }

    typedef T value_type;
    class iterator {
    public:
        iterator() {}
        iterator(const iterator& rOther) : node_(rOther.node_) {}
        iterator(tree_node_base* pNode) : node_(pNode) {}
        T* operator->() const { return &static_cast<node*>(node_)->value_; }
        tree_node_base* node_;
    };
    iterator begin() { return iterator(begin_); }
    tree_node_base* end_node() { return reinterpret_cast<tree_node_base*>(&root_.second()); }
    pair<iterator, bool> insert_one(const value_type& rValue) {
        node* pPred;
        bool left;
        bool leftmost;
        tree_node_base* pParent = find_leaf(rValue, pPred, left, leftmost);
        if (pPred == nullptr || Compare()(pPred->value_, rValue)) {
            return pair<iterator, bool>(iterator(insert_node_at(pParent, left, leftmost, rValue)), true);
        }
        return pair<iterator, bool>(iterator(pPred), false);
    }
    tree_node_base* find_leaf(const value_type& rValue, node*& rpPred, bool& rLeft, bool& rLeftmost);
    node* insert_node_at(tree_node_base* pParent, bool left, bool leftmost, const value_type& rValue);

    size_type size() const { return size_; }
    void destroy(node* pNode) {
        if (pNode->left_ != nullptr) {
            destroy(static_cast<node*>(pNode->left_));
        }
        if (pNode->right_ != nullptr) {
            destroy(static_cast<node*>(pNode->right_));
        }
        this->Allocator::destroy(&pNode->value_);
        ::operator delete(pNode);
    }

private:
    size_type size_;
    Metrowerks::compressed_pair<node_allocator, tree_node_base*> root_;
    tree_node_base* begin_;
};

template <typename T, typename Compare, typename Allocator>
typename map_compact_tree<T, Compare, Allocator>::node* map_compact_tree<T, Compare, Allocator>::insert_node_at(tree_node_base* pParent, bool left, bool leftmost, const value_type& rValue) {
    if (size_ == size_type(-1)) {
        __throw_tree_length_error();
    }
    Metrowerks::alloc_ptr<node, node_allocator&> holder(root_.first().allocate(1), root_.first());
    this->Allocator::construct(&holder.get()->value_, rValue);
    node* pNode = holder.release();
    pNode->right_ = nullptr;
    pNode->left_ = nullptr;
    new (&pNode->parent_) unsigned long(reinterpret_cast<unsigned long>(pParent));
    if (left) {
        pParent->left_ = pNode;
    } else {
        pParent->right_ = pNode;
    }
    ++size_;
    tree_balance_after_insert(pNode, root_.second());
    if (leftmost) {
        begin_ = pNode;
    }
    return pNode;
}

template <typename T, typename Compare, typename Allocator>
tree_node_base* map_compact_tree<T, Compare, Allocator>::find_leaf(const value_type& rValue, node*& rpPred, bool& rLeft, bool& rLeftmost) {
    rpPred = nullptr;
    node* pLeaf = static_cast<node*>(end_node());
    node* pNode = static_cast<node*>(root_.second());
    rLeft = true;
    rLeftmost = true;
    while (pNode != nullptr) {
        pLeaf = pNode;
        if (Compare()(rValue, pNode->value_)) {
            pNode = static_cast<node*>(pNode->left_);
            rLeft = true;
        } else {
            rpPred = pLeaf;
            pNode = static_cast<node*>(pNode->right_);
            rLeft = false;
            rLeftmost = false;
        }
    }
    return pLeaf;
}

template <typename T, typename Compare, typename BaseCompare, typename Allocator, bool Compact> struct map_tree_selection {
    typedef tree<T, Compare, Allocator> type;
};
template <typename T, typename Compare, typename BaseCompare, typename Allocator> struct map_tree_selection<T, Compare, BaseCompare, Allocator, true> {
    typedef map_compact_tree<T, BaseCompare, Allocator> type;
};

}

namespace detail {

template <typename Key, typename T, typename Compare, typename Allocator> class map_base {
public:
    typedef Key key_type;
    typedef T mapped_type;
    typedef pair<const Key, T> value_type;
    typedef Compare key_compare;
    typedef Allocator allocator_type;

    typedef typename map_tree_compare<Key, T, Compare, Metrowerks::is_POD<T>::value>::type value_compare;

private:
    typedef map_base_value_compare<Key, T, Compare> base_value_compare;
    typedef typename map_tree_selection<value_type, value_compare, base_value_compare, allocator_type, map_transform<Key, T, Compare>::value>::type tree_type;

public:
    typedef typename tree_type::size_type size_type;

    class iterator {
    public:
        iterator() {}
        iterator(const iterator& rOther) : mIterator(rOther.mIterator) {}
        iterator(const typename tree_type::iterator& rIterator) : mIterator(rIterator) {}
        iterator& operator=(const iterator& rOther) {
            mIterator = rOther.mIterator;
            return *this;
        }
        value_type* operator->() const { return mIterator.operator->(); }
        value_type& operator*() const { return *mIterator; }
        iterator& operator++() {
            ++mIterator;
            return *this;
        }
        bool operator==(const iterator& rOther) const { return mIterator == rOther.mIterator; }
        bool operator!=(const iterator& rOther) const { return mIterator != rOther.mIterator; }

        typename tree_type::iterator mIterator;
    };

    iterator begin() { return iterator(tree_.begin()); }
    iterator end() { return iterator(tree_.end()); }
    size_type size() const { return tree_.size(); }
    bool empty() const { return tree_.size() == 0; }

    pair<iterator, bool> insert(const value_type& rValue) {
        pair<typename tree_type::iterator, bool> result = tree_.insert_one(rValue);
        return pair<iterator, bool>(iterator(result.first), result.second);
    }
    iterator find(const key_type& rKey) { return iterator(tree_.find(rKey)); }
    mapped_type& operator[](const key_type& rKey) { return tree_.find_or_insert(rKey).second; }

private:
    tree_type tree_;
};

}

template <typename Key, typename T, typename Compare = less<Key>, typename Allocator = allocator<pair<const Key, T> > >
class map : public detail::map_base<Key, T, Compare, Allocator> {
public:
    map() {}
    ~map() {}
};

template <typename Key, typename T> class map<Key*, T*, less<Key*>, allocator<pair<Key* const, T*> > > {
    typedef pair<const void* const, unsigned long> base_value_type;
    typedef detail::map_base_value_compare<const void*, unsigned long, less<const void*> > base_compare;
    typedef detail::map_compact_tree<base_value_type, base_compare, allocator<base_value_type> > tree_type;
public:
    typedef Key* key_type;
    typedef T* mapped_type;
    typedef pair<key_type const, mapped_type> value_type;
    typedef less<Key*> key_compare;
    typedef allocator<value_type> allocator_type;
    typedef unsigned long size_type;
    class iterator {
    public:
        iterator() {}
        iterator(const iterator& rOther) : mIterator(rOther.mIterator) {}
        explicit iterator(const typename tree_type::iterator& rIterator) : mIterator(rIterator) {}
        typename tree_type::iterator mIterator;
    };
    typedef iterator const_iterator;
    map() {}
    ~map() {}
    size_type size() const { return mTree.size(); }
    bool empty() const { return mTree.size() == 0; }
    pair<iterator, bool> insert(const value_type& rValue) {
        pair<typename tree_type::iterator, bool> result = mTree.insert_one(reinterpret_cast<const base_value_type&>(rValue));
        return pair<iterator, bool>(iterator(result.first), result.second);
    }
private:
    tree_type mTree;
};

}

#endif
