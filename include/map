#ifndef _MAP
#define _MAP

#include <MSL_CPP/allocator.h>
#include <MSL_CPP/msl_utility.h>
#include <MSL_CPP/detail/tree.h>
#include <utility>

namespace std {

namespace detail {

template <typename T> struct map_pointer_key { enum { value = false }; };
template <typename T> struct map_pointer_key<T*> { enum { value = true }; };

template <typename Key, typename T, typename Compare> struct map_transform { enum { value = false }; };
template <typename Key, typename T> struct map_transform<Key, T, less<Key> > {
    enum { value = Metrowerks::is_POD<T>::value || map_pointer_key<Key>::value };
};

template <typename Key, typename T, typename Compare> struct map_base_value_compare {
    bool operator()(const pair<const Key, T>& rLeft, const pair<const Key, T>& rRight) const {
        return Compare()(rLeft.first, rRight.first);
    }
};

template <typename T, typename Compare, typename Allocator> class map_tree : private Allocator {
public:
    typedef unsigned long size_type;

    struct node : tree_node_base {
        T value_;
    };

    map_tree() : size_(0), root_(nullptr), begin_(reinterpret_cast<tree_node_base*>(&root_)) {}
    ~map_tree() {
        if (root_ != nullptr) {
            destroy(static_cast<node*>(root_));
        }
    }

    size_type size() const { return size_; }

    void destroy(node* pNode);

private:
    size_type size_;
    tree_node_base* root_;
    Compare comp_;
    tree_node_base* begin_;
};

template <typename T, typename Compare, typename Allocator>
void map_tree<T, Compare, Allocator>::destroy(node* pNode) {
    if (pNode->left_ != nullptr) {
        destroy(static_cast<node*>(pNode->left_));
    }
    if (pNode->right_ != nullptr) {
        destroy(static_cast<node*>(pNode->right_));
    }
    this->Allocator::destroy(&pNode->value_);
    ::operator delete(pNode);
}

template <typename T, typename Compare, typename Allocator> class map_compact_tree : private Compare, private Allocator {
public:
    typedef unsigned long size_type;

    struct node : tree_node_base {
        T value_;
    };

    map_compact_tree() : size_(0), root_(nullptr), begin_(reinterpret_cast<tree_node_base*>(&root_)) {}
    ~map_compact_tree() {
        if (root_ != nullptr) {
            destroy(static_cast<node*>(root_));
        }
    }

    typedef T value_type;
    class iterator {
    public:
        iterator() {}
        iterator(const iterator& rOther) : node_(rOther.node_) {}
        iterator(tree_node_base* pNode) : node_(pNode) {}
        tree_node_base* node_;
    };
    tree_node_base* end_node() { return reinterpret_cast<tree_node_base*>(&root_); }
    pair<iterator, bool> insert_one(const value_type& rValue) {
        node* pPred;
        bool left;
        bool leftmost;
        tree_node_base* pParent = find_leaf(rValue, pPred, left, leftmost);
        if (pPred == nullptr || Compare()(pPred->value_, rValue)) {
            return pair<iterator, bool>(iterator(insert_node_at(pParent, left, leftmost, rValue)), true);
        }
        return pair<iterator, bool>(iterator(pPred), false);
    }
    tree_node_base* find_leaf(const value_type& rValue, node*& rpPred, bool& rLeft, bool& rLeftmost);
    node* insert_node_at(tree_node_base* pParent, bool left, bool leftmost, const value_type& rValue);

    size_type size() const { return size_; }
    void destroy(node* pNode) {
        if (pNode->left_ != nullptr) {
            destroy(static_cast<node*>(pNode->left_));
        }
        if (pNode->right_ != nullptr) {
            destroy(static_cast<node*>(pNode->right_));
        }
        this->Allocator::destroy(&pNode->value_);
        ::operator delete(pNode);
    }

private:
    size_type size_;
    tree_node_base* root_;
    tree_node_base* begin_;
};

template <typename T, typename Compare, typename Allocator>
tree_node_base* map_compact_tree<T, Compare, Allocator>::find_leaf(const value_type& rValue, node*& rpPred, bool& rLeft, bool& rLeftmost) {
    rpPred = nullptr;
    node* pLeaf = static_cast<node*>(end_node());
    node* pNode = static_cast<node*>(root_);
    rLeft = true;
    rLeftmost = true;
    while (pNode != nullptr) {
        pLeaf = pNode;
        if (Compare()(rValue, pNode->value_)) {
            pNode = static_cast<node*>(pNode->left_);
            rLeft = true;
        } else {
            rpPred = pLeaf;
            pNode = static_cast<node*>(pNode->right_);
            rLeft = false;
            rLeftmost = false;
        }
    }
    return pLeaf;
}

template <typename T, typename Compare, typename BaseCompare, typename Allocator, bool Compact> struct map_tree_selection {
    typedef map_tree<T, Compare, Allocator> type;
};
template <typename T, typename Compare, typename BaseCompare, typename Allocator> struct map_tree_selection<T, Compare, BaseCompare, Allocator, true> {
    typedef map_compact_tree<T, BaseCompare, Allocator> type;
};

}

template <typename Key, typename T, typename Compare = less<Key>, typename Allocator = allocator<pair<const Key, T> > >
class map {
public:
    typedef Key key_type;
    typedef T mapped_type;
    typedef pair<const Key, T> value_type;
    typedef Compare key_compare;
    typedef Allocator allocator_type;

    class value_compare {
    public:
        bool operator()(const value_type& rLeft, const value_type& rRight) const { return comp(rLeft.first, rRight.first); }

    protected:
        Compare comp;
    };

private:
    typedef detail::map_base_value_compare<Key, T, Compare> base_value_compare;
    typedef typename detail::map_tree_selection<value_type, value_compare, base_value_compare, allocator_type, detail::map_transform<Key, T, Compare>::value>::type tree_type;

public:
    typedef typename tree_type::size_type size_type;

    map() {}
    ~map() {}

    size_type size() const { return tree_.size(); }
    bool empty() const { return tree_.size() == 0; }

private:
    tree_type tree_;
};

template <typename Key, typename T> class map<Key*, T*, less<Key*>, allocator<pair<Key* const, T*> > > {
    typedef pair<const void* const, unsigned long> base_value_type;
    typedef detail::map_base_value_compare<const void*, unsigned long, less<const void*> > base_compare;
    typedef detail::map_compact_tree<base_value_type, base_compare, allocator<base_value_type> > tree_type;
public:
    typedef Key* key_type;
    typedef T* mapped_type;
    typedef pair<key_type const, mapped_type> value_type;
    typedef less<Key*> key_compare;
    typedef allocator<value_type> allocator_type;
    typedef unsigned long size_type;
    class iterator {
    public:
        iterator() {}
        iterator(const iterator& rOther) : mIterator(rOther.mIterator) {}
        explicit iterator(const typename tree_type::iterator& rIterator) : mIterator(rIterator) {}
        typename tree_type::iterator mIterator;
    };
    typedef iterator const_iterator;
    map() {}
    ~map() {}
    size_type size() const { return mTree.size(); }
    bool empty() const { return mTree.size() == 0; }
    pair<iterator, bool> insert(const value_type& rValue) {
        pair<typename tree_type::iterator, bool> result = mTree.insert_one(reinterpret_cast<const base_value_type&>(rValue));
        return pair<iterator, bool>(iterator(result.first), result.second);
    }
private:
    tree_type mTree;
};

}

#endif
