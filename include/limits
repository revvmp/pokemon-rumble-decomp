#ifndef _LIMITS
#define _LIMITS

namespace std {

template <typename T> class numeric_limits;

template <> class numeric_limits<long> {
public:
    static long max() { return 0x7FFFFFFF; }
};

template <> class numeric_limits<unsigned long> {
public:
    static unsigned long max() { return 0xFFFFFFFF; }
};

}

#endif
