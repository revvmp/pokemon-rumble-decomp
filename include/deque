#ifndef _DEQUE
#define _DEQUE

#include <MSL_CPP/allocator.h>
#include <MSL_CPP/compressed_pair.h>
#include <MSL_CPP/msl_utility.h>
#include <algorithm>
#include <iterator>
#include <stdexcept>

namespace std {

inline void __throw_deque_length_error(const char* pMessage) {
    throw length_error(pMessage);
}

template <bool> struct __cdeque_common {
    static void throw_length_error();
};

template <bool b> void __cdeque_common<b>::throw_length_error() {
    throw length_error("cdeque length error");
}

template <typename A> struct __cdeque_alloc_ref {
    typedef const A& type;
};

template <typename A> struct __cdeque_alloc_ref<A&> {
    typedef A& type;
};

template <typename A> struct __cdeque_value_alloc {
    typedef A type;
};

template <typename A> struct __cdeque_value_alloc<A&> {
    typedef A type;
};

template <typename T, typename Allocator> class __cdeque_buf;

template <typename T, typename Allocator> void swap(__cdeque_buf<T, Allocator>& rLeft, __cdeque_buf<T, Allocator>& rRight);

template <typename T, typename Allocator> class __cdeque_buf {
public:
    typedef unsigned long size_type;
    typedef Metrowerks::int2type<Metrowerks::is_POD<T>::value> pod_type;
    typedef typename Metrowerks::compressed_pair<size_type, Allocator>::second_param allocator_param;

    class iterator {
        template <typename, typename> friend class __cdeque_buf;
    public:
        typedef random_access_iterator_tag iterator_category;
        typedef T value_type;
        typedef long difference_type;
        typedef T* pointer;
        typedef T& reference;

    public:
        iterator(const iterator& rOther) : cur_(rOther.cur_), first_(rOther.first_), begin_(rOther.begin_), last_(rOther.last_) {}
        iterator(__cdeque_buf& rBuf, T* pCur) : cur_(pCur), first_(rBuf.data_), begin_(first_ + rBuf.start_), last_(first_ + rBuf.cap()) {}
        T& operator*() { return *cur_; }
        iterator& operator++() {
            ++cur_;
            if (cur_ == last_) {
                cur_ = first_;
            }
            return *this;
        }
        iterator& operator+=(int n) {
            int count = last_ - first_;
            int pos = n + (cur_ - first_);
            if (pos < 0) {
                pos += count;
            } else if (pos >= count) {
                pos -= count;
            }
            cur_ = first_ + pos;
            return *this;
        }
        iterator& operator-=(int n) { return *this += -n; }
        iterator operator+(int n) const {
            return iterator(*this) += n;
        }
        iterator operator-(int n) const {
            return iterator(*this) -= n;
        }
        long operator-(const iterator& rOther) const { return distance_to(rOther); }
        long distance_to(const iterator& rOther) const {
            T* pBegin = begin_;
            long n = cur_ - rOther.cur_;
            if (cur_ >= pBegin) {
                if (rOther.cur_ < pBegin) {
                    n -= last_ - first_;
                }
            } else {
                if (rOther.cur_ >= pBegin) {
                    n += last_ - first_;
                }
            }
            return n;
        }
        iterator& operator--() {
            if (cur_ == first_) {
                cur_ = last_;
            }
            --cur_;
            return *this;
        }
        T* segment_start() const {
            if (cur_ >= begin_) {
                return begin_;
            }
            return first_;
        }
        bool same_segment(const iterator& rOther) const { return (cur_ >= begin_) == (rOther.cur_ >= rOther.begin_); }
        bool operator==(const iterator& rOther) const { return cur_ == rOther.cur_; }
        bool operator!=(const iterator& rOther) const { return !(*this == rOther); }
        T* cur() const { return cur_; }
        T*& cur_ref() { return cur_; }
        T* last() const { return last_; }

    private:
        T* cur_;
        T* first_;
        T* begin_;
        T* last_;
    };

    class const_iterator {
        template <typename, typename> friend class __cdeque_buf;
    public:
        typedef random_access_iterator_tag iterator_category;
        typedef T value_type;
        typedef long difference_type;
        typedef const T* pointer;
        typedef const T& reference;

    public:
        const_iterator(const __cdeque_buf& rBuf, const T* pCur) : cur_(pCur), first_(rBuf.data_), begin_(first_ + rBuf.start_), last_(first_ + rBuf.cap()) {}
        const T& operator*() const { return *cur_; }
        const_iterator& operator++() {
            ++cur_;
            if (cur_ == last_) {
                cur_ = first_;
            }
            return *this;
        }
        const_iterator& operator+=(int n) {
            int count = last_ - first_;
            int pos = n + (cur_ - first_);
            if (pos < 0) {
                pos += count;
            } else if (pos >= count) {
                pos -= count;
            }
            cur_ = first_ + pos;
            return *this;
        }
        const_iterator operator+(int n) const {
            return const_iterator(*this) += n;
        }
        long operator-(const const_iterator& rOther) const { return distance_to(rOther); }
        long distance_to(const const_iterator& rOther) const {
            const T* pBegin = begin_;
            long n = cur_ - rOther.cur_;
            if (cur_ >= pBegin) {
                if (rOther.cur_ < pBegin) {
                    n -= last_ - first_;
                }
            } else {
                if (rOther.cur_ >= pBegin) {
                    n += last_ - first_;
                }
            }
            return n;
        }
        bool same_segment(const const_iterator& rOther) const { return (cur_ >= begin_) == (rOther.cur_ >= rOther.begin_); }
        bool operator==(const const_iterator& rOther) const { return cur_ == rOther.cur_; }
        bool operator!=(const const_iterator& rOther) const { return !(*this == rOther); }
        const T* cur() const { return cur_; }
        const T*& cur_ref() { return cur_; }
        const T* last() const { return last_; }

    private:
        const T* cur_;
        const T* first_;
        const T* begin_;
        const T* last_;
    };

    typedef __cdeque_buf<T, typename __cdeque_value_alloc<Allocator>::type> value_buf;
    typedef typename value_buf::iterator value_iterator;

    __cdeque_buf() : data_(0), start_(0), size_(0), capacity_(0) {}
    explicit __cdeque_buf(typename __cdeque_alloc_ref<Allocator>::type a) : data_(0), start_(0), size_(0), capacity_(0, a) {}
    ~__cdeque_buf();

    size_type& cap() { return capacity_.first(); }
    const size_type& cap() const { return capacity_.first(); }
    Allocator& alloc() { return capacity_.second(); }
    const Allocator& alloc() const { return capacity_.second(); }
    T& operator[](size_type i) { return data_[(start_ + i) % cap()]; }
    const T& operator[](size_type i) const { return data_[(start_ + i) % cap()]; }

    size_type size() const { return size_; }
    bool empty() const { return size_ == 0; }
    size_type capacity() const { return cap() == 0 ? 0 : cap() - 1; }
    size_type max_size() const {
        static size_type n = std::min(alloc().max_size(), size_type(numeric_limits<long>::max()) / 2) - 1;
        return n;
    }
    void reserve(size_type n);
    void clear() { pop_back(size_); }
    void pop_back(size_type n) { pop_back(n, pod_type()); }
    void pop_back(size_type n, Metrowerks::int2type<true>) { size_ -= n; }
    iterator begin() { return iterator(*this, data_ + start_); }
    iterator end() { return iterator(*this, data_ + (cap() ? (start_ + size_) % cap() : 0)); }
    const_iterator begin() const { return const_iterator(*this, data_ + start_); }
    const_iterator end() const { return const_iterator(*this, data_ + (cap() ? (start_ + size_) % cap() : 0)); }
    template <typename Iterator> void copy_construct(Iterator first, const Iterator& rLast, forward_iterator_tag) {
        size_type n = std::distance(first, rLast);
        if (n != 0) {
            allocate(n);
            construct_at_end(first, rLast);
        }
    }
    T& front() { return data_[start_]; }
    T& back() { return data_[(start_ + size_ - 1) % cap()]; }
    void pop_front() { pop_front(pod_type()); }
    void pop_front(Metrowerks::int2type<true>) {
        if (++start_ == cap()) {
            start_ = 0;
        }
        --size_;
    }
    void push_back(const T& rValue);
    void swap(__cdeque_buf& rOther) { std::swap(*this, rOther); }
    size_type recommend(size_type n) {
        size_type max = max_size();
        size_type cur = capacity();
        if (n > max - cur) {
            __cdeque_common<true>::throw_length_error();
        }
        if (cur < max / 3) {
            return cur + std::max((cur + 1) * 3 / 5, n);
        }
        if (cur < max / 3 * 2) {
            return cur + std::max((cur + 1) / 2, n);
        }
        return max;
    }
    void clear_moved() { clear_moved(pod_type()); }
    void clear_moved(Metrowerks::int2type<true>) { size_ = 0; }
    void allocate(size_type n) { allocate(n, pod_type()); }
    void allocate(size_type n, Metrowerks::int2type<true>);
    void allocate(size_type size, size_type n) { allocate(size, n, pod_type()); }
    void allocate(size_type, size_type n, Metrowerks::int2type<true> t) { allocate(n, t); }
    template <typename Iterator> void construct_at_end(const Iterator& rFirst, const Iterator& rLast) {
        construct_at_end(rFirst, rLast, pod_type());
    }
    template <typename Iterator> void construct_at_end(const Iterator& rFirst, const Iterator& rLast, Metrowerks::int2type<true>);
    void construct_at_end(const value_iterator& rFirst, const value_iterator& rLast, Metrowerks::int2type<true>);
    template <typename Iterator> void construct_at_front(const Iterator& rFirst, const Iterator& rLast) {
        construct_at_front(rFirst, rLast, pod_type());
    }
    void construct_at_front(const value_iterator& rFirst, const value_iterator& rLast, Metrowerks::int2type<true>);

    static iterator copy(iterator first, iterator last, iterator result);
    static iterator copy_backward(iterator first, iterator last, iterator result);
    static T* copy(const_iterator first, const_iterator last, T* result);
    static T* copy(T* first, T* last, T* result) { return copy_bytes(first, last, result); }
    static T* copy(const T* first, const T* last, T* result) { return copy_bytes(first, last, result); }
    static T* copy_bytes(const T* first, const T* last, T* result) {
        size_type bytes = (last - first) * sizeof(T);
        memmove(result, first, bytes);
        return reinterpret_cast<T*>(reinterpret_cast<char*>(result) + bytes);
    }
    static T* copy_backward(T* first, T* last, T* result) { return copy_backward_bytes(first, last, result); }
    static T* copy_backward_bytes(T* first, T* last, T* result) {
        long n = last - first;
        result -= n;
        memmove(result, first, n * sizeof(T));
        return result;
    }
    template <typename ForwardIterator> static iterator copy(ForwardIterator first, ForwardIterator last, iterator result);
    template <typename ForwardIterator> static T* copy(ForwardIterator first, ForwardIterator last, T* result);

    template <typename ForwardIterator>
    void insert(const iterator& rPos, ForwardIterator first, ForwardIterator last, bidirectional_iterator_tag) {
        insert(rPos, first, last, Metrowerks::int2type<0>());
    }
    template <typename ForwardIterator>
    void insert(const iterator& rPos, ForwardIterator& rFirst, ForwardIterator& rLast, Metrowerks::int2type<0>);

    T* data_;
    size_type start_;
    size_type size_;
    Metrowerks::compressed_pair<size_type, Allocator> capacity_;
};

template <typename T, typename Allocator> void swap(__cdeque_buf<T, Allocator>& rLeft, __cdeque_buf<T, Allocator>& rRight) {
    std::swap(rLeft.data_, rRight.data_);
    std::swap(rLeft.start_, rRight.start_);
    std::swap(rLeft.size_, rRight.size_);
    swap(rLeft.capacity_, rRight.capacity_);
}

template <typename T, typename Allocator> __cdeque_buf<T, Allocator>::~__cdeque_buf() {
    if (data_) {
        clear();
        alloc().deallocate(data_, cap());
    }
}

template <typename T, typename Allocator> void __cdeque_buf<T, Allocator>::allocate(size_type n, Metrowerks::int2type<true>) {
    if (n > max_size()) {
        __cdeque_common<true>::throw_length_error();
    }
    data_ = alloc().allocate(n + 1);
    cap() = n + 1;
}

template <typename T, typename Allocator> void __cdeque_buf<T, Allocator>::push_back(const T& rValue) {
    if (size_ + 1 < cap()) {
        alloc().construct(data_ + (start_ + size_) % cap(), rValue);
        ++size_;
    } else {
        __cdeque_buf<T, Allocator&> tmp(alloc());
        tmp.allocate(size_ + 1, recommend(1));
        tmp.start_ = size_;
        tmp.alloc().construct(tmp.data_ + tmp.start_, rValue);
        ++tmp.size_;
        tmp.construct_at_front(begin(), end());
        clear_moved();
        std::swap(data_, tmp.data_);
        std::swap(start_, tmp.start_);
        std::swap(size_, tmp.size_);
        std::swap(cap(), tmp.cap());
    }
}

template <typename T, typename Allocator> void __cdeque_buf<T, Allocator>::reserve(size_type n) {
    if (n > capacity()) {
        __cdeque_buf<T, Allocator&> tmp(alloc());
        tmp.allocate(n);
        tmp.construct_at_end(begin(), end());
        clear_moved();
        std::swap(data_, tmp.data_);
        std::swap(start_, tmp.start_);
        std::swap(size_, tmp.size_);
        std::swap(cap(), tmp.cap());
    }
}

template <typename T, typename Allocator>
typename __cdeque_buf<T, Allocator>::iterator
__cdeque_buf<T, Allocator>::copy(iterator first, iterator last, iterator result) {
    while (first != last) {
        long room = result.last() - result.cur();
        long n;
        if (first.same_segment(last)) {
            n = std::min(last.cur() - first.cur(), room);
        } else {
            n = std::min(first.last() - first.cur(), room);
        }
        copy(first.cur(), first.cur() + n, result.cur());
        first.cur_ref() += n - 1;
        ++first;
        result.cur_ref() += n - 1;
        ++result;
    }
    return result;
}

template <typename T, typename Allocator>
T* __cdeque_buf<T, Allocator>::copy(const_iterator first, const_iterator last, T* result) {
    while (first != last) {
        long n;
        if (first.same_segment(last)) {
            n = last.cur() - first.cur();
        } else {
            n = first.last() - first.cur();
        }
        result = copy(first.cur(), first.cur() + n, result);
        first.cur_ref() += n - 1;
        ++first;
    }
    return result;
}

template <typename T, typename Allocator>
template <typename Iterator>
void __cdeque_buf<T, Allocator>::construct_at_end(const Iterator& rFirst, const Iterator& rLast, Metrowerks::int2type<true>) {
    if (data_) {
        T* pDest = data_ + (start_ + size_) % cap();
        long n = rLast - rFirst;
        long room = (data_ + cap()) - pDest;
        room = std::min(room, n);
        size_ += n;
        copy(rFirst, rFirst + room, pDest);
        n -= room;
        if (n != 0) {
            copy(rFirst + room, rLast, data_);
        }
    }
}

template <typename T, typename Allocator>
void __cdeque_buf<T, Allocator>::construct_at_end(const value_iterator& rFirst, const value_iterator& rLast,
                                                  Metrowerks::int2type<true>) {
    T* pDest = data_ + (start_ + size_) % cap();
    if (rFirst.cur_ <= rLast.cur_) {
        value_buf::copy(rFirst.cur_, rLast.cur_, pDest);
        size_ += rLast.cur_ - rFirst.cur_;
    } else {
        pDest = value_buf::copy(rFirst.cur_, rFirst.last_, pDest);
        value_buf::copy(rLast.first_, rLast.cur_, pDest);
        size_ += (rFirst.last_ - rFirst.cur_) + (rLast.cur_ - rLast.first_);
    }
}

template <typename T, typename Allocator>
void __cdeque_buf<T, Allocator>::construct_at_front(const value_iterator& rFirst, const value_iterator& rLast,
                                                    Metrowerks::int2type<true>) {
    T* pDest = data_ + start_;
    if (rFirst.cur_ <= rLast.cur_) {
        value_buf::copy_backward(rFirst.cur_, rLast.cur_, pDest);
        size_type n = rLast.cur_ - rFirst.cur_;
        size_ += n;
        start_ -= n;
    } else {
        pDest = value_buf::copy_backward(rLast.first_, rLast.cur_, pDest);
        value_buf::copy_backward(rFirst.cur_, rFirst.last_, pDest);
        size_type n = (rLast.cur_ - rLast.first_) + (rFirst.last_ - rFirst.cur_);
        start_ -= n;
        size_ += n;
    }
}

template <typename T, typename Allocator>
typename __cdeque_buf<T, Allocator>::iterator
__cdeque_buf<T, Allocator>::copy_backward(iterator first, iterator last, iterator result) {
    while (first != last) {
        --last;
        --result;
        long room = result.cur() - result.segment_start();
        long n;
        if (first.same_segment(last)) {
            n = std::min(last.cur() - first.cur(), room);
        } else {
            n = std::min(last.cur() - last.segment_start(), room);
        }
        last.cur_ref() -= n;
        copy_backward(last.cur(), last.cur() + (n + 1), result.cur() + 1);
        result.cur_ref() -= n;
    }
    return result;
}

template <typename T, typename Allocator> class __cdeque_imp : public __cdeque_buf<T, Allocator> {
    typedef __cdeque_buf<T, Allocator> base;

public:
    __cdeque_imp() {}
    explicit __cdeque_imp(const Allocator& rAlloc) : base(rAlloc) {}
    __cdeque_imp(const __cdeque_imp& rOther) : base(rOther.alloc()) {
        this->copy_construct(rOther.begin(), rOther.end(), typename iterator_traits<typename base::const_iterator>::iterator_category());
    }
};

template <typename T, typename Allocator>
template <typename ForwardIterator>
T* __cdeque_buf<T, Allocator>::copy(ForwardIterator first, ForwardIterator last, T* result) {
    for (; first != last; ++first, ++result) {
        *result = *first;
    }
    return result;
}

template <typename T, typename Allocator>
template <typename ForwardIterator>
typename __cdeque_buf<T, Allocator>::iterator
__cdeque_buf<T, Allocator>::copy(ForwardIterator first, ForwardIterator last, iterator result) {
    if (first != last) {
        long remaining = last - first;
        for (;;) {
            long room = result.last() - result.cur();
            long n = std::min(remaining, room);
            ForwardIterator mid = first + n;
            copy(first, mid, result.cur());
            remaining -= n;
            result.cur_ref() += n - 1;
            ++result;
            if (remaining == 0) {
                break;
            }
            first = mid;
        }
    }
    return result;
}

template <typename T, typename Allocator>
template <typename ForwardIterator>
void __cdeque_buf<T, Allocator>::insert(const iterator& rPos, ForwardIterator& rFirst, ForwardIterator& rLast,
                                        Metrowerks::int2type<0>) {
    size_type n = std::distance(rFirst, rLast);
    if (n != 0) {
        T* pFront = data_ + start_;
        size_type index = rPos.cur_ - pFront;
        if (rPos.cur_ < pFront) {
            index += cap();
        }
        size_type room = capacity();
        if (n <= room && size_ <= room - n) {
            iterator it = begin();
            size_type tail = size_ - index;
            if (index < tail) {
                iterator oldBegin(it);
                it -= n;
                start_ = &*it - data_;
                size_ += n;
                if (index != 0) {
                    it = copy(oldBegin, oldBegin + index, it);
                }
            } else {
                size_ += n;
                it = end();
                if (tail != 0) {
                    it = copy_backward(it - (n + tail), it - n, it);
                }
                it -= n;
            }
            copy(rFirst, rLast, it);
        } else {
            __cdeque_buf<T, Allocator&> buf(alloc());
            buf.allocate(size_ + n, recommend(n));
            buf.start_ = index;
            T* pDest = buf.data_ + index;
            while (n != 0) {
                T value = *rFirst;
                buf.alloc().construct(pDest, value);
                ++buf.size_;
                --n;
                ++pDest;
                ++rFirst;
            }
            buf.construct_at_end(rPos, end());
            buf.construct_at_front(begin(), rPos);
            clear_moved();
            std::swap(data_, buf.data_);
            std::swap(start_, buf.start_);
            std::swap(size_, buf.size_);
            std::swap(cap(), buf.cap());
        }
    }
}

template <typename T, typename Allocator> class __cdeque_pointer : public __cdeque_imp<void*, allocator<void*> > {
    typedef __cdeque_buf<void*, allocator<void*> > base;
    typedef typename base::iterator base_iterator;

public:
    __cdeque_pointer() {}
    explicit __cdeque_pointer(const Allocator& rAlloc) : __cdeque_imp<void*, allocator<void*> >(allocator<void*>(rAlloc)) {}

    class iterator : public base_iterator {
    public:
        typedef int difference_type;
        typedef T* value_type;
        typedef T** pointer;
        typedef T*& reference;
        typedef random_access_iterator_tag iterator_category;

        iterator(const base_iterator& rBase) : base_iterator(rBase) {}
        base_iterator base() const { return *this; }
        T*& operator*() { return reinterpret_cast<T*&>(base_iterator::operator*()); }
        iterator& operator++() {
            base_iterator::operator++();
            return *this;
        }
        iterator& operator+=(int n) {
            base_iterator::operator+=(n);
            return *this;
        }
        iterator& operator-=(int n) { return *this += -n; }
        iterator operator+(int n) const { return iterator(*this) += n; }
        iterator operator-(int n) const { return iterator(*this) -= n; }
        long operator-(const iterator& rOther) const { return base_iterator::operator-(rOther); }
        bool operator==(const iterator& rOther) const { return base_iterator::operator==(rOther); }
        bool operator!=(const iterator& rOther) const { return base_iterator::operator!=(rOther); }
    };

    class void_iterator {
    public:
        typedef long difference_type;
        typedef void* value_type;
        typedef void** pointer;
        typedef void*& reference;
        typedef random_access_iterator_tag iterator_category;

        void_iterator(const iterator& rIt) : mIt(rIt) {}
        void* operator*() { return mCast(mIt); }
        void_iterator& operator++() {
            ++mIt;
            return *this;
        }
        void_iterator& operator+=(int n) {
            mIt += n;
            return *this;
        }
        void_iterator operator+(int n) const {
            return void_iterator(*this) += n;
        }
        long operator-(const void_iterator& rOther) const { return mIt - rOther.mIt; }
        bool operator==(const void_iterator& rOther) const { return mIt == rOther.mIt; }
        bool operator!=(const void_iterator& rOther) const { return !(*this == rOther); }

    private:
        struct pointer_cast {
            void* operator()(iterator it) { return get(it, Metrowerks::int2type<0>()); }
            void* get(iterator it, Metrowerks::int2type<0>) { return *it; }
        };

        iterator mIt;
        pointer_cast mCast;
    };

    T*& operator[](size_type i) { return reinterpret_cast<T*&>(base::operator[](i)); }
    T* const& operator[](size_type i) const { return reinterpret_cast<T* const&>(base::operator[](i)); }

    iterator begin() { return iterator(base::begin()); }
    iterator end() { return iterator(base::end()); }
    T*& front() { return reinterpret_cast<T*&>(base::front()); }
    T*& back() { return reinterpret_cast<T*&>(base::back()); }
    void push_back(T* const& rPtr) { base::push_back(reinterpret_cast<void* const&>(rPtr)); }
    void swap(__cdeque_pointer& rOther) { base::swap(rOther); }
    void insert(const iterator& rPos, iterator first, iterator last, int) {
        insert(rPos, first, last, typename iterator_traits<iterator>::iterator_category());
    }
    void insert(const iterator& rPos, iterator first, iterator last, bidirectional_iterator_tag) {
        insert(rPos, first, last, Metrowerks::int2type<0>(), Metrowerks::int2type<0>());
    }
    void insert(const iterator& rPos, iterator first, iterator last, Metrowerks::int2type<0>, Metrowerks::int2type<0>) {
        base::insert(rPos.base(), void_iterator(first), void_iterator(last),
                     typename iterator_traits<void_iterator>::iterator_category());
    }
};

template <typename T, typename Allocator> class __cdeque;

template <typename T, typename Allocator> class __cdeque<T*, Allocator> : private __cdeque_pointer<T, Allocator> {
    typedef __cdeque_pointer<T, Allocator> base;

public:
    typedef unsigned long size_type;
    typedef typename base::iterator iterator;

    __cdeque() {}
    explicit __cdeque(const Allocator& rAlloc) : base(rAlloc) {}

    T*& operator[](size_type i) { return base::operator[](i); }
    T* const& operator[](size_type i) const { return base::operator[](i); }

    using base::size;
    using base::empty;
    using base::capacity;
    using base::reserve;
    using base::clear;
    using base::begin;
    using base::end;
    using base::front;
    using base::back;
    using base::insert;

    void push_back(T* const& rPtr);
    void pop_front();
    void swap(__cdeque& rOther);
};

template <typename T, typename Allocator> void __cdeque<T*, Allocator>::push_back(T* const& rPtr) {
    base::push_back(rPtr);
}

template <typename T, typename Allocator> void __cdeque<T*, Allocator>::pop_front() {
    base::pop_front();
}

template <typename T, typename Allocator> void __cdeque<T*, Allocator>::swap(__cdeque& rOther) {
    base::swap(rOther);
}

template <typename T, typename Allocator> class __deque_imp {
public:
    typedef unsigned long size_type;
    typedef __cdeque<T*, typename Allocator::template rebind<T*>::other> buf_type;

    typedef Metrowerks::int2type<Metrowerks::is_POD<T>::value> pod_type;

    enum { block_size = 1024 / sizeof(T) };

    class iterator {
    public:
        iterator(const typename buf_type::iterator& rBlock, T* pCur) : block_(rBlock), cur_(pCur) {}
        T& operator*();

    private:
        typename buf_type::iterator block_;
        T* cur_;
    };

    size_type size() const { return size_; }
    bool empty() const { return size_ == 0; }
    buf_type& buf() { return buf_.first(); }
    const buf_type& buf() const { return buf_.first(); }
    iterator end() { return at(size_); }
    iterator at(size_type pos) {
        buf_type* pBuf;
        size_type i = pos + start_;
        pBuf = &buf();
        typename buf_type::iterator block = pBuf->begin() + i / block_size;
        T* pBlock = pBuf->empty() ? 0 : *block;
        return iterator(block, pBlock + i % block_size);
    }
    size_type front_capacity() const { return start_; }
    size_type capacity() const { return buf().empty() ? 0 : (buf().size() - 1) * block_size; }
    size_type max_size() const {
        static size_type n = (numeric_limits<size_type>::max() / block_size - 1) * block_size;
        return n;
    }

    T& front() { return first(); }
    T& first() { return buf()[start_ / block_size][start_ % block_size]; }

    __deque_imp() : start_(0), size_(0) {}
    explicit __deque_imp(const Allocator& rAlloc) : start_(0), size_(0), buf_(buf_type(typename Allocator::template rebind<T*>::other(rAlloc)), rAlloc) {}
    ~__deque_imp();
    Allocator& alloc();

    void push_back(const T& x) { append(x); }
    void append(const T& x) { push_back(x, pod_type()); }
    void push_back(const T& x, Metrowerks::int2type<false>);
    size_type back_capacity();

    void allocate_back(size_type n);

    void pop_front() { pop_front(1); }
    void pop_front(size_type n) { pop_front(n, pod_type()); }
    void pop_front(size_type n, Metrowerks::int2type<false>);

    void destroy_all();
    void destroy_all(pod_type);

    T& operator[](size_type n) {
        size_type i = n + start_;
        return buf()[i / block_size][i % block_size];
    }

    size_type start_;
    size_type size_;
    Metrowerks::compressed_pair<buf_type, Allocator> buf_;
};

template <typename T, typename Allocator> T& __deque_imp<T, Allocator>::iterator::operator*() {
    return *cur_;
}

template <typename T, typename Allocator> __deque_imp<T, Allocator>::~__deque_imp() {
    destroy_all();
    buf_type& rBuf = buf();
    if (!rBuf.empty()) {
        Allocator& rAlloc = alloc();
        typename buf_type::iterator last = rBuf.end();
        typename buf_type::iterator it = rBuf.begin();
        for (; it != last; ++it) {
            if (*it) {
                rAlloc.deallocate(*it, block_size);
            }
        }
    }
}

template <typename T, typename Allocator> Allocator& __deque_imp<T, Allocator>::alloc() {
    return buf_.second();
}

template <typename T, typename Allocator> void __deque_imp<T, Allocator>::push_back(const T& x, Metrowerks::int2type<false>) {
    if (back_capacity() == 0) {
        allocate_back(1);
    }
    alloc().construct(&*end(), x);
    ++size_;
}

template <typename T, typename Allocator> typename __deque_imp<T, Allocator>::size_type __deque_imp<T, Allocator>::back_capacity() {
    return capacity() - (start_ + size_);
}

template <typename T, typename Allocator> void __deque_imp<T, Allocator>::pop_front(size_type n, Metrowerks::int2type<false>) {
    if (n != 0) {
        Allocator& rAlloc = alloc();
        buf_type& rBuf = buf();
        size_ -= n;
        start_ += n;
        while (start_ >= 2 * block_size) {
            rAlloc.deallocate(rBuf.front(), block_size);
            rBuf.pop_front();
            start_ -= block_size;
        }
        if (size_ == 0) {
            start_ = block_size / 2;
        }
    }
}

template <typename T, typename Allocator> void __deque_imp<T, Allocator>::destroy_all() {
    destroy_all(pod_type());
}

template <typename T, typename Allocator> void __deque_imp<T, Allocator>::destroy_all(pod_type) {
    size_ = 0;
}

template <typename T, typename Allocator> void __deque_imp<T, Allocator>::allocate_back(size_type n) {
    buf_type& rBuf = buf();
    Allocator& rAlloc = alloc();
    T* pBlock;
    size_type count;
    size_type limit;
    size_type blocks = n / block_size + (n % block_size != 0);
    for (; blocks != 0 && front_capacity() >= block_size; --blocks) {
        pBlock = rBuf.front();
        rBuf.pop_front();
        rBuf.back() = pBlock;
        rBuf.push_back(nullptr);
        start_ -= block_size;
    }
    if (blocks != 0) {
        count = blocks * block_size;
        if (count > max_size() || capacity() > max_size() - count) {
            __throw_deque_length_error("deque:: length error");
        }
        limit = rBuf.capacity();
        if (blocks + rBuf.size() <= limit) {
            for (; blocks != 0; --blocks) {
                pBlock = rAlloc.allocate(block_size);
                rBuf.back() = pBlock;
                rBuf.push_back(nullptr);
            }
        } else {
            __deque_imp spare(rAlloc);
            buf_type& rSpare = spare.buf();
            rSpare.reserve(max(rBuf.capacity() * 2, rBuf.size() + blocks + 1));
            rSpare.push_back(nullptr);
            for (; blocks != 0; --blocks) {
                pBlock = rAlloc.allocate(block_size);
                rSpare.back() = pBlock;
                rSpare.push_back(nullptr);
            }
            if (!rBuf.empty()) {
                rSpare.insert(rSpare.begin(), rBuf.begin(), rBuf.end() - 1, 0);
            }
            rBuf.swap(rSpare);
            rSpare.clear();
        }
    }
}

template <typename T, typename Allocator> class __deque_storage : public __deque_imp<T, Allocator> {};

template <typename T, typename Allocator> class __deque_container : public __deque_storage<T, Allocator> {};

template <typename T, typename Allocator> class __deque_ops {
public:
    typedef unsigned long size_type;
    typedef __cdeque<T*, typename Allocator::template rebind<T*>::other> buf_type;

    typedef Metrowerks::int2type<Metrowerks::is_POD<T>::value> pod_type;

    enum { block_size = 1024 / sizeof(T) };

    class iterator {
    public:
        iterator(const typename buf_type::iterator& rBlock, T* pCur) : block_(rBlock), cur_(pCur) {}
        T& operator*() { return *cur_; }

    private:
        typename buf_type::iterator block_;
        T* cur_;
    };

    __deque_ops() : start_(0), size_(0), buf_() {}
    explicit __deque_ops(const Allocator& rAlloc) : start_(0), size_(0), buf_(buf_type(typename Allocator::template rebind<T*>::other(rAlloc)), rAlloc) {}

    size_type size() const { return size_; }
    bool empty() const { return size_ == 0; }
    buf_type& buf() { return buf_.first(); }
    const buf_type& buf() const { return buf_.first(); }
    Allocator& alloc() { return buf_.second(); }
    ~__deque_ops();
    iterator end() { return make_iterator(size_); }
    iterator make_iterator(size_type pos);
    size_type front_capacity() const { return start_; }
    size_type back_capacity() { return capacity() - (start_ + size_); }
    size_type capacity() const { return buf().empty() ? 0 : (buf().size() - 1) * block_size; }
    size_type max_size() const {
        static size_type n = (numeric_limits<size_type>::max() / block_size - 1) * block_size;
        return n;
    }

    void destroy_all() { destroy_all(pod_type()); }
    void destroy_all(pod_type) { size_ = 0; }

    void push_back(const T& x) { push_back(x, pod_type()); }
    void push_back(const T& x, Metrowerks::int2type<false>);

    void allocate_back(size_type n);

    void pop_front() { pop_front(1); }
    void pop_front(size_type n) { pop_front(n, pod_type()); }
    void pop_front(size_type n, Metrowerks::int2type<false>);

    const T& operator[](size_type n) const {
        size_type i = n + start_;
        return buf()[i / block_size][i % block_size];
    }

    size_type start_;
    size_type size_;
    Metrowerks::compressed_pair<buf_type, Allocator> buf_;
};

template <typename T, typename Allocator> __deque_ops<T, Allocator>::~__deque_ops() {
    destroy_all();
    buf_type& rBuf = buf();
    if (!rBuf.empty()) {
        Allocator& rAlloc = alloc();
        typename buf_type::iterator last = rBuf.end();
        typename buf_type::iterator it = rBuf.begin();
        for (; it != last; ++it) {
            if (*it) {
                rAlloc.deallocate(*it, block_size);
            }
        }
    }
}

template <typename T, typename Allocator>
typename __deque_ops<T, Allocator>::iterator __deque_ops<T, Allocator>::make_iterator(size_type pos) {
    pos += start_;
    buf_type& rBuf = buf();
    typename buf_type::iterator block = rBuf.begin() + pos / block_size;
    return iterator(block, (rBuf.empty() ? 0 : *block) + pos % block_size);
}

template <typename T, typename Allocator> void __deque_ops<T, Allocator>::push_back(const T& x, Metrowerks::int2type<false>) {
    if (back_capacity() == 0) {
        allocate_back(1);
    }
    alloc().construct(&*end(), x);
    ++size_;
}

template <typename T, typename Allocator> void __deque_ops<T, Allocator>::allocate_back(size_type n) {
    buf_type& rBuf = buf();
    Allocator& rAlloc = alloc();
    T* pBlock;
    size_type blocks = n / block_size + (n % block_size != 0);
    for (; blocks != 0 && front_capacity() >= block_size; --blocks) {
        pBlock = rBuf.front();
        rBuf.pop_front();
        rBuf.back() = pBlock;
        rBuf.push_back(nullptr);
        start_ -= block_size;
    }
    if (blocks != 0) {
        if (blocks * block_size > max_size() || capacity() > max_size() - blocks * block_size) {
            __throw_deque_length_error("deque:: length error");
        }
        if (blocks + rBuf.size() <= rBuf.capacity()) {
            for (; blocks != 0; --blocks) {
                pBlock = rAlloc.allocate(block_size);
                rBuf.back() = pBlock;
                rBuf.push_back(nullptr);
            }
        } else {
            __deque_ops spare(rAlloc);
            buf_type& rSpare = spare.buf();
            rSpare.reserve(max(rBuf.capacity() * 2, rBuf.size() + blocks + 1));
            rSpare.push_back(nullptr);
            for (; blocks != 0; --blocks) {
                pBlock = rAlloc.allocate(block_size);
                rSpare.back() = pBlock;
                rSpare.push_back(nullptr);
            }
            if (!rBuf.empty()) {
                rSpare.insert(rSpare.begin(), rBuf.begin(), rBuf.end() - 1, 0);
            }
            rBuf.swap(rSpare);
            rSpare.clear();
        }
    }
}

template <typename T, typename Allocator> void __deque_ops<T, Allocator>::pop_front(size_type n, Metrowerks::int2type<false>) {
    if (n != 0) {
        Allocator& rAlloc = alloc();
        buf_type& rBuf = buf();
        size_ -= n;
        start_ += n;
        while (start_ >= 2 * block_size) {
            rAlloc.deallocate(rBuf.front(), block_size);
            rBuf.pop_front();
            start_ -= block_size;
        }
        if (size_ == 0) {
            start_ = block_size / 2;
        }
    }
}

