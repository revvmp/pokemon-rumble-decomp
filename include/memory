namespace std {
namespace detail {
template <typename T> struct default_delete {
    default_delete() {}
    void operator()(T* pObject) const { delete pObject; }
};

template <typename T> struct default_delete<T[]> {
    void operator()(T* pArray) const { delete[] pArray; }
};
}
}

namespace Metrowerks {
template <bool B, typename T = void> struct restrict_to {};
template <typename T> struct restrict_to<true, T> {
    typedef T type;
};

template <typename From, typename To> struct is_convertible {
private:
    struct Yes {
        char mValue[2];
    };
    static Yes Test(To);
    static char Test(...);
    static From Make();

public:
    enum { value = sizeof(Test(Make())) == sizeof(Yes) };
};

template <typename T, typename D = std::detail::default_delete<T> > class move_ptr {
    struct nat {
        int dummy_;
    };

public:
    template <typename Y>
    explicit move_ptr(Y* p, typename restrict_to<is_convertible<Y*, T*>::value, nat>::type = nat()) : ptr_(p) {}
    ~move_ptr();
    T* get() const { return ptr_.first(); }
    T* release() {
        T* p = ptr_.first();
        ptr_.first() = nullptr;
        return p;
    }

private:
    move_ptr(const move_ptr&);
    move_ptr& operator=(const move_ptr&);

    compressed_pair<T*, D> ptr_;
};

template <typename T, typename D> move_ptr<T, D>::~move_ptr() {
    if (ptr_.first()) {
        ptr_.second()(ptr_.first());
    }
}
}

namespace std {
namespace tr1 {

namespace detail {

template <typename T> struct shared_ptr_reference { typedef T& type; };
template <> struct shared_ptr_reference<void> { typedef void type; };

template <typename T, typename D> class shared_ptr_holder {
public:
    shared_ptr_holder(T* pObject, D& rDeleter) : mpObject(pObject), mrDeleter(rDeleter) {}
    ~shared_ptr_holder();
    void release() { mpObject = nullptr; }

private:
    T* mpObject;
    D& mrDeleter;
};

template <typename T, typename D> shared_ptr_holder<T, D>::~shared_ptr_holder() {
    if (mpObject != nullptr) {
        mrDeleter(mpObject);
    }
}

}

namespace detail {
struct unused_argument;
}

template <typename T> class shared_ptr;
template <typename T> class weak_ptr;
template <typename T> class enable_shared_from_this;

class bad_weak_ptr : public exception {
public:
    virtual const char* what() const throw() { return "bad_weak_ptr"; }
};

template <typename T> class shared_ptr {
    struct bool_type {
        int dummy_;
    };

public:
    typedef T element_type;

    shared_ptr() : ptr_(nullptr), s_(nullptr) {}
    shared_ptr(detail::unused_argument*) : ptr_(nullptr), s_(nullptr) {}
    template <typename Y> explicit shared_ptr(Y* p) : ptr_(p) {
        Metrowerks::move_ptr<Y> hold(p);
        s_ = new detail::shared_ptr_deleter<Y, std::detail::default_delete<Y> >(p);
        hold.release();
        enable_from_this(p, p);
    }
    template <typename Y, typename D> shared_ptr(Y* p, D d) : ptr_(p) {
        detail::shared_ptr_holder<Y, D> holder(p, d);
        s_ = new detail::shared_ptr_deleter<Y, D>(p, d);
        holder.release();
    }
    template <typename Y> explicit shared_ptr(const weak_ptr<Y>& r);
    template <typename Y>
    shared_ptr(const weak_ptr<Y>& r, typename Metrowerks::restrict_to<Metrowerks::is_convertible<Y*, T*>::value>::type*);
    shared_ptr(const shared_ptr& r) : ptr_(r.ptr_), s_(r.s_) {
        if (s_) {
            s_->retain();
        }
    }
    template <typename Y>
    shared_ptr(const shared_ptr<Y>& r, typename Metrowerks::restrict_to<Metrowerks::is_convertible<Y*, T*>::value>::type* = nullptr) :
        ptr_(r.ptr_), s_(r.s_) {
        if (s_) {
            s_->retain();
        }
    }
    ~shared_ptr() throw();

    shared_ptr& operator=(const shared_ptr& r) {
        shared_ptr(r).swap(*this);
        return *this;
    }
    template <typename Y> shared_ptr& operator=(const shared_ptr<Y>& r) {
        shared_ptr(r).swap(*this);
        return *this;
    }

    void swap(shared_ptr& r) {
        T* p = ptr_;
        ptr_ = r.ptr_;
        r.ptr_ = p;
        detail::shared_ptr_deleter_common* s = s_;
        s_ = r.s_;
        r.s_ = s;
    }
    void reset();
    template <typename Y> void reset(Y* p) { shared_ptr(p).swap(*this); }
    template <typename Y, typename D> void reset(Y* p, D d) { shared_ptr(p, d).swap(*this); }

    T* get() const { return ptr_; }
    typename detail::shared_ptr_reference<T>::type operator*() const { return *ptr_; }
    T* operator->() const { return ptr_; }
    long use_count() const { return s_ ? s_->use_count() : 0; }
    operator int bool_type::*() const { return ptr_ ? &bool_type::dummy_ : nullptr; }
    template <typename Y> bool operator<(const shared_ptr<Y>& r) const { return s_ < r.s_; }

private:
    template <typename Y> friend class shared_ptr;
    template <typename Y> friend class weak_ptr;
    template <typename Y, typename U> friend shared_ptr<Y> static_pointer_cast(const shared_ptr<U>& r);

    shared_ptr(T* p, detail::shared_ptr_deleter_common* s) : ptr_(p), s_(s) { s_->retain(); }
    template <typename Y, typename U> void enable_from_this(const enable_shared_from_this<Y>* pBase, U* p);
    void enable_from_this(const void*, const void*) {}

    T* ptr_;
    detail::shared_ptr_deleter_common* s_;
};

template <typename T> class weak_ptr {
public:
    typedef T element_type;

    weak_ptr() : ptr_(nullptr), s_(nullptr) {}
    weak_ptr(const weak_ptr& r) : ptr_(r.ptr_), s_(r.s_) {
        if (s_) {
            s_->attach_weak();
        }
    }
    template <typename Y>
    weak_ptr(const shared_ptr<Y>& r, typename Metrowerks::restrict_to<Metrowerks::is_convertible<Y*, T*>::value>::type* = nullptr) :
        ptr_(r.ptr_), s_(r.s_) {
        if (s_) {
            s_->attach_weak();
        }
    }
    ~weak_ptr();

    weak_ptr& operator=(const weak_ptr& r) {
        weak_ptr(r).swap(*this);
        return *this;
    }
    template <typename Y> weak_ptr& operator=(const shared_ptr<Y>& r) {
        weak_ptr(r).swap(*this);
        return *this;
    }

    void swap(weak_ptr& r) {
        T* p = ptr_;
        ptr_ = r.ptr_;
        r.ptr_ = p;
        detail::shared_ptr_deleter_common* s = s_;
        s_ = r.s_;
        r.s_ = s;
    }
    void reset() { weak_ptr().swap(*this); }

    long use_count() const { return s_ ? s_->use_count() : 0; }
    bool expired() const { return !s_ || s_->use_count() == 0; }
    shared_ptr<T> lock() const;

private:
    template <typename Y> friend class shared_ptr;
    template <typename Y> friend class weak_ptr;

    template <typename Y> weak_ptr(Y* p, detail::shared_ptr_deleter_common* s) : ptr_(p), s_(s) { s_->attach_weak(); }

    T* ptr_;
    detail::shared_ptr_deleter_common* s_;
};

template <typename T> class enable_shared_from_this {
public:
    shared_ptr<T> shared_from_this() { return shared_ptr<T>(weak_this_, nullptr); }

protected:
    enable_shared_from_this() {}
    enable_shared_from_this(const enable_shared_from_this&) {}
    enable_shared_from_this& operator=(const enable_shared_from_this&) { return *this; }
    ~enable_shared_from_this() {}

private:
    template <typename Y> friend class shared_ptr;

    weak_ptr<T> weak_this_;
};

template <typename T>
template <typename Y>
shared_ptr<T>::shared_ptr(const weak_ptr<Y>& r) : ptr_(nullptr), s_(nullptr) {
    shared_ptr<T> locked(r.lock());
    if (locked.use_count() == 0) {
        throw bad_weak_ptr();
    }
    swap(locked);
}

template <typename T>
template <typename Y>
shared_ptr<T>::shared_ptr(const weak_ptr<Y>& r, typename Metrowerks::restrict_to<Metrowerks::is_convertible<Y*, T*>::value>::type*) : ptr_(nullptr), s_(nullptr) {
    shared_ptr<T> locked(r.lock());
    if (locked.use_count() == 0) {
        throw bad_weak_ptr();
    }
    swap(locked);
}

template <typename T> void shared_ptr<T>::reset() {
    shared_ptr().swap(*this);
}

template <typename T> shared_ptr<T>::~shared_ptr() throw() {
    if (s_) {
        s_->release();
    }
}

template <typename T> weak_ptr<T>::~weak_ptr() {
    if (s_) {
        s_->release_weak();
    }
}

template <typename T> shared_ptr<T> weak_ptr<T>::lock() const {
    if (expired()) {
        return shared_ptr<T>();
    }
    shared_ptr<T> locked;
    if (s_->use_count() != 0) {
        locked.ptr_ = ptr_;
        locked.s_ = s_;
        locked.s_->retain();
    }
    return locked;
}

template <typename T, typename U> bool operator==(const shared_ptr<T>& a, const shared_ptr<U>& b) {
    return a.get() == b.get();
}

template <typename T, typename U> shared_ptr<T> static_pointer_cast(const shared_ptr<U>& r) {
    return r.s_ ? shared_ptr<T>(static_cast<T*>(r.ptr_), r.s_) : shared_ptr<T>();
}

template <typename T>
template <typename Y, typename U>
void shared_ptr<T>::enable_from_this(const enable_shared_from_this<Y>* pBase, U* p) {
    if (p) {
        weak_ptr<Y>(p, s_).swap(const_cast<enable_shared_from_this<Y>*>(pBase)->weak_this_);
    }
}

