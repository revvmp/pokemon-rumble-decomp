template <typename T> class weak_ptr {
public:
    typedef T element_type;

    weak_ptr() : ptr_(nullptr), s_(nullptr) {}
    weak_ptr(const weak_ptr& r) : ptr_(r.ptr_), s_(r.s_) {
        if (s_) {
            s_->attach_weak();
        }
    }
    template <typename Y>
    weak_ptr(const shared_ptr<Y>& r, typename Metrowerks::restrict_to<Metrowerks::is_convertible<Y*, T*>::value>::type* = nullptr);
    ~weak_ptr();

    weak_ptr& operator=(const weak_ptr& r);
    template <typename Y> weak_ptr& operator=(const shared_ptr<Y>& r);

    void swap(weak_ptr& r) {
        T* p = ptr_;
        ptr_ = r.ptr_;
        r.ptr_ = p;
        detail::shared_ptr_deleter_common* s = s_;
        s_ = r.s_;
        r.s_ = s;
    }
#if defined(GAME_DLGPIISELECTOR_EMISSION_LAYOUT) || defined(CGAME_RESULT_EMISSION_LAYOUT)
    void reset();
#else
    void reset() { weak_ptr().swap(*this); }
#endif

    long use_count() const { return s_ ? s_->use_count() : 0; }
    bool expired() const { return !s_ || s_->use_count() == 0; }
#if defined(BWORLD_EMISSION_LAYOUT)
    typename detail::world_shared_result<T>::type lock() const;
#else
    shared_ptr<T> lock() const;
#endif

private:
    template <typename Y> friend class shared_ptr;
    template <typename Y> friend class weak_ptr;

    template <typename Y> weak_ptr(Y* p, detail::shared_ptr_deleter_common* s) : ptr_(p), s_(s) { s_->attach_weak(); }

    T* ptr_;
    detail::shared_ptr_deleter_common* s_;
};

template <typename T> class enable_shared_from_this {
public:
#if defined(BWORLD_EMISSION_LAYOUT)
    typename detail::world_shared_result<T>::type shared_from_this() { return shared_ptr<T>(weak_this_, nullptr); }
#else
    shared_ptr<T> shared_from_this() { return shared_ptr<T>(weak_this_, nullptr); }
#endif

protected:
    enable_shared_from_this() {}
    enable_shared_from_this(const enable_shared_from_this&) {}
    enable_shared_from_this& operator=(const enable_shared_from_this&) { return *this; }
    ~enable_shared_from_this() {}

private:
    template <typename Y> friend class shared_ptr;

    weak_ptr<T> weak_this_;
};

template <typename T>
template <typename Y>
shared_ptr<T>::shared_ptr(const weak_ptr<Y>& r) : ptr_(nullptr), s_(nullptr) {
    shared_ptr<T> locked(r.lock());
    if (locked.use_count() == 0) {
        throw bad_weak_ptr();
    }
    swap(locked);
}

template <typename T>
template <typename Y>
shared_ptr<T>::shared_ptr(const weak_ptr<Y>& r, typename Metrowerks::restrict_to<Metrowerks::is_convertible<Y*, T*>::value>::type*) : ptr_(nullptr), s_(nullptr) {
    shared_ptr<T> locked(r.lock());
    if (locked.use_count() == 0) {
        throw bad_weak_ptr();
    }
    swap(locked);
}

template <typename T> void shared_ptr<T>::reset() {
    shared_ptr().swap(*this);
}

template <typename T> inline
shared_ptr<T>::shared_ptr(const shared_ptr& r) : ptr_(r.ptr_), s_(r.s_) {
    if (s_) {
        s_->retain();
    }
}

#if !defined(CMODEL_THUNK_EMISSION_LAYOUT)
template <typename T> shared_ptr<T>::~shared_ptr() throw() {
    if (s_) {
        s_->release();
    }
}
#endif

template <typename T>
shared_ptr<T>& shared_ptr<T>::operator=(const shared_ptr& r) {
    shared_ptr(r).swap(*this);
    return *this;
}

template <typename T> inline
void shared_ptr<T>::swap(shared_ptr& r) {
    void* temporary = const_cast<void*>(static_cast<const void*>(ptr_));
    ptr_ = r.ptr_;
    r.ptr_ = static_cast<element_type*>(temporary);
    temporary = s_;
#if defined(GAME_SHARED_PTR_SORT_STORAGE)
    detail::shared_ptr_deleter_common* pOtherState = r.s_;
    pOtherState = static_cast<detail::shared_ptr_deleter_common*>(pOtherState);
    s_ = pOtherState;
#else
    s_ = r.s_;
#endif
    r.s_ = static_cast<detail::shared_ptr_deleter_common*>(temporary);
}

template <typename T> inline void swap(shared_ptr<T>& a, shared_ptr<T>& b) { a.swap(b); }

template <typename T> template <typename Y>
void shared_ptr<T>::reset(Y* p) { shared_ptr(p).swap(*this); }

template <typename T> template <typename Y> inline
weak_ptr<T>::weak_ptr(const shared_ptr<Y>& r, typename Metrowerks::restrict_to<Metrowerks::is_convertible<Y*, T*>::value>::type*) : ptr_(r.ptr_), s_(r.s_) {
    if (s_) {
        s_->attach_weak();
    }
}

template <typename T> weak_ptr<T>::~weak_ptr() {
    if (s_) {
        s_->release_weak();
    }
}

template <typename T> weak_ptr<T>& weak_ptr<T>::operator=(const weak_ptr& r) {
    weak_ptr(r).swap(*this);
    return *this;
}

template <typename T> template <typename Y>
weak_ptr<T>& weak_ptr<T>::operator=(const shared_ptr<Y>& r) {
    weak_ptr(r).swap(*this);
    return *this;
}

#if defined(BWORLD_EMISSION_LAYOUT)
template <typename T> typename detail::world_shared_result<T>::type weak_ptr<T>::lock() const {
#else
template <typename T> shared_ptr<T> weak_ptr<T>::lock() const {
#endif
    if (expired()) {
        return shared_ptr<T>();
    }
    shared_ptr<T> locked;
    if (s_->use_count() != 0) {
        locked.ptr_ = ptr_;
        locked.s_ = s_;
        locked.s_->retain();
    }
    return locked;
}

template <typename T, typename U> inline bool operator==(const shared_ptr<T>& a, const shared_ptr<U>& b) {
    return a.get() == b.get();
}

template <typename T, typename U> bool operator!=(const shared_ptr<T>& a, const shared_ptr<U>& b) {
    return a.get() != b.get();
}

template <typename T, typename U> shared_ptr<T> static_pointer_cast(const shared_ptr<U>& r) {
    return r.s_ ? shared_ptr<T>(static_cast<T*>(r.ptr_), r.s_) : shared_ptr<T>();
}

template <typename T, typename U> shared_ptr<T> dynamic_pointer_cast(const shared_ptr<U>& r) {
    T* p = dynamic_cast<T*>(r.get());
    return p ? shared_ptr<T>(p, r.s_) : shared_ptr<T>();
}

template <typename T>
template <typename Y, typename U>
void shared_ptr<T>::enable_from_this(const enable_shared_from_this<Y>* pBase, U* p) {
    if (p) {
        weak_ptr<Y>(p, s_).swap(const_cast<enable_shared_from_this<Y>*>(pBase)->weak_this_);
    }
}

