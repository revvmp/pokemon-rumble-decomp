template <typename R> class function<R()> {
    typedef detail::function_base<R (*)()> base;

    struct bool_type {
        int dummy_;
    };

public:
    typedef R result_type;

    function(detail::unused_argument* = nullptr) : f_(nullptr) {}
    template <typename F> function(F f, detail::unused_argument* = nullptr) : f_(nullptr) {
        if (!detail::is_null(f)) {
            typedef detail::function_imp<R (*)(), F, false, false> imp;
            if (sizeof(imp) <= sizeof(buf_)) {
                f_ = new (buf_) imp(f);
            } else {
                f_ = new imp(f);
            }
        }
    }
    function(const function& r) : f_(nullptr) {
        if (r.f_ != nullptr) {
            if (r.f_ == r.local()) {
                f_ = r.f_->clone(buf_);
            } else {
                f_ = r.f_->clone();
            }
        }
    }
    ~function() {
        if (f_ == local()) {
            f_->~base();
        } else if (f_ != nullptr) {
            delete f_;
        }
    }

    function& operator=(const function& r) {
        function tmp(r);
        swap(tmp);
        return *this;
    }

    void swap(function& r) {
        base* p = f_;
        bool localStorage = p == local();
        f_ = r.f_;
        r.f_ = p;
        for (unsigned int i = 0; i < sizeof(buf_) / sizeof(unsigned long); ++i) {
            unsigned long c = words_[i];
            words_[i] = r.words_[i];
            r.words_[i] = c;
        }
        if (localStorage) {
            r.f_ = r.local();
        }
        if (f_ == r.local()) {
            f_ = local();
        }
    }

    operator int bool_type::*() const { return f_ != nullptr ? &bool_type::dummy_ : nullptr; }

    R operator()() const {
        if (f_ == nullptr) {
            throw bad_function_call();
        }
        return (*f_)();
    }

private:
    base* local() const { return reinterpret_cast<base*>(const_cast<char*>(buf_)); }

    base* f_;
    union { char buf_[8]; unsigned long words_[2]; };
};

