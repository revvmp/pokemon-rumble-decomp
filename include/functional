template <typename Signature> class function_base;

template <typename R> class function_base<R (*)()> {
public:
    virtual ~function_base() {}
    virtual function_base* clone() const = 0;
    virtual function_base* clone(void* pBuffer) const = 0;
    virtual R operator()() = 0;
};

template <typename Signature, typename F, bool IsMemberPointer, bool IsReferenceWrapper> class function_imp;

template <typename R, typename F> class function_imp<R (*)(), F, false, false> : public function_base<R (*)()> {
    typedef function_base<R (*)()> base;

public:
    explicit function_imp(F f) : f_(f) {}
    virtual base* clone() const { return new function_imp(*this); }
    virtual base* clone(void* pBuffer) const { return new (pBuffer) function_imp(*this); }
    virtual R operator()() { return f_(); }

private:
    F f_;
};

template<class R,class A> class function_base<R (*)(A)> {
public:
    virtual ~function_base() {}
    virtual function_base* clone() const = 0;
    virtual function_base* clone(void* pBuffer) const = 0;
    virtual R operator()(A argument) = 0;
};
template<class R,class A,class F> class function_imp<R (*)(A),F,false,true> : public function_base<R (*)(A)> {
    typedef function_base<R (*)(A)> base;
public:
    explicit function_imp(F f) : f_(f) {}
