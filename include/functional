template<class R,class F,class T> template<class A>
inline R detail::bound_func<R,F,tuple<T,placeholders::detail::ph<1> > >::operator()(const A& argument) const {
    tuple<const A&> arguments(argument);
    return mFunction(std::tr1::get<0>(mArguments),resolve_bound_argument(std::tr1::get<1>(mArguments),arguments));
}

template<class R,class F,class T> template<class A>
inline R detail::bound_func<R,F,tuple<T,placeholders::detail::ph<1> > >::operator()(A& argument) const {
