template<class R,class F,class Tuple,class Arguments> R call_bound(F& rFunction, Tuple& rTuple, const Arguments& arguments, Metrowerks::int2type<0>) {
    return rFunction(resolve_bound_argument(get_bound<0>(rTuple), arguments), resolve_bound_argument(get_bound<1>(rTuple), arguments));
}
