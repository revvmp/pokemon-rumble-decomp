#ifndef _FUNCTIONAL
#define _FUNCTIONAL

#include <exception>
#include <new>
#include <revolution/types.h>

namespace std {
namespace tr1 {

class bad_function_call : public exception {
public:
    virtual const char* what() const throw() { return "bad_function_call"; }
};

template <typename Signature> class function;

namespace detail {

template <typename Signature> class function_base;

template <typename R> class function_base<R (*)()> {
public:
    virtual ~function_base() {}
    virtual function_base* clone() const = 0;
    virtual function_base* clone(void* pBuffer) const = 0;
    virtual R operator()() = 0;
};

template <typename Signature, typename F, bool IsMemberPointer, bool IsReferenceWrapper> class function_imp;

template <typename R, typename F> class function_imp<R (*)(), F, false, false> : public function_base<R (*)()> {
    typedef function_base<R (*)()> base;

public:
    explicit function_imp(const F& f) : f_(f) {}
    virtual base* clone() const { return new function_imp(*this); }
    virtual base* clone(void* pBuffer) const { return new (pBuffer) function_imp(*this); }
    virtual R operator()() { return f_(); }

private:
    F f_;
};

template <typename F> bool is_null(const F&) {
    return false;
}

template <typename F> bool is_null(F* p) {
    return p == nullptr;
}

}

template <typename R> class function<R()> {
    typedef detail::function_base<R (*)()> base;

    struct bool_type {
        int dummy_;
    };

public:
    typedef R result_type;

    function() : f_(nullptr) {}
    template <typename F> function(F f) : f_(nullptr) {
        if (!detail::is_null(f)) {
            typedef detail::function_imp<R (*)(), F, false, false> imp;
            if (sizeof(imp) <= sizeof(buf_)) {
                f_ = new (buf_) imp(f);
            } else {
                f_ = new imp(f);
            }
        }
    }
    function(const function& r) : f_(nullptr) {
        if (r.f_ != nullptr) {
            if (r.f_ == r.local()) {
                f_ = r.f_->clone(buf_);
            } else {
                f_ = r.f_->clone();
            }
        }
    }
    ~function() {
        if (f_ == local()) {
            f_->~base();
        } else if (f_ != nullptr) {
            delete f_;
        }
    }

    operator int bool_type::*() const { return f_ != nullptr ? &bool_type::dummy_ : nullptr; }

    R operator()() const {
        if (f_ == nullptr) {
            throw bad_function_call();
        }
        return (*f_)();
    }

private:
    base* local() const { return reinterpret_cast<base*>(const_cast<char*>(buf_)); }

    base* f_;
    char buf_[8];
};

}
}

#endif
