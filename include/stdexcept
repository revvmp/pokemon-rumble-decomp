#ifndef _STDEXCEPT
#define _STDEXCEPT

#include <exception>
#include <memory>
#include <string.h>

namespace std {

class __msl_error {
public:
    explicit __msl_error(const char* pMessage) : message_(new char[strlen(pMessage) + 1], detail::default_delete<char[]>()) {
        strcpy(message_.get(), pMessage);
    }
    const char* what() const { return message_.get(); }

private:
    tr1::shared_ptr<char> message_;
};

class logic_error : public exception {
public:
    explicit logic_error(const char* pWhat) : message_(pWhat) {}
    virtual const char* what() const { return message_.what(); }

private:
    __msl_error message_;
};

class length_error : public logic_error {
public:
    explicit length_error(const char* pWhat) : logic_error(pWhat) {}
};

class out_of_range : public logic_error {
public:
    explicit out_of_range(const char* pWhat) : logic_error(pWhat) {}
};

}

#endif
