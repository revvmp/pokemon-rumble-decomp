#ifndef _LIST
#define _LIST

#include <MSL_CPP/allocator.h>
#include <MSL_CPP/alloc_ptr.h>
#include <MSL_CPP/compressed_pair.h>

namespace std {

template <typename T, typename Allocator> class __list_deleter {
protected:
    struct node;

    struct node_base {
        node* prev_;
        node* next_;
    };

    struct node : node_base {
        T* value() { return &data_; }

        T data_;
    };

    typedef unsigned long size_type;
    typedef typename Allocator::template rebind<node>::other node_allocator;

    class iterator {
    public:
        iterator() {}
        iterator(const iterator& rOther) : node_(rOther.node_) {}
        iterator(node* pNode) : node_(pNode) {}
        explicit iterator(node_base* pNode) : node_(static_cast<node*>(pNode)) {}

        T& operator*() const { return node_->data_; }
        T* operator->() const { return &node_->data_; }
        iterator& operator++() {
            node_ = node_->next_;
            return *this;
        }
        bool operator==(const iterator& rOther) const { return node_ == rOther.node_; }
        bool operator!=(const iterator& rOther) const { return node_ != rOther.node_; }

        node* get() const { return node_; }

        node* node_;
    };

    __list_deleter() : size_(0), tail_(alloc()) {
        node_base* pTail = end_node();
        pTail->next_ = static_cast<node*>(pTail);
        pTail->prev_ = static_cast<node*>(pTail);
    }
    ~__list_deleter() { erase(begin(), end()); }

    void clear() {
        erase(begin(), end());
    }

    iterator begin() { return iterator(end_node()->next_); }
    iterator end() { return iterator(end_node()); }

    iterator erase(iterator first, iterator last) {
        if (first == last) {
            return last;
        }
        unlink_nodes(first.get(), last.get()->prev_);
        while (first != last) {
            alloc().destroy(&*first);
            node* pNode = first.get();
            ++first;
            tail_.first().deallocate(pNode, 1);
            --size_.first();
        }
        return last;
    }

    static void unlink_nodes(node_base* pFirst, node_base* pLast) {
        pFirst->prev_->next_ = pLast->next_;
        pLast->next_->prev_ = pFirst->prev_;
    }

    Allocator& alloc() { return size_.second(); }

    void destroy(T* pValue) { pValue->~T(); }

    node_base* begin_node() const { return tail_.second().next_; }
    node_base* end_node() const { return const_cast<node_base*>(&tail_.second()); }

    Metrowerks::compressed_pair<size_type, Allocator> size_;
    Metrowerks::compressed_pair<node_allocator, node_base> tail_;

private:
    __list_deleter(const __list_deleter&);
    __list_deleter& operator=(const __list_deleter&);
};

template <typename T, typename Allocator> class __list_imp : public __list_deleter<T, Allocator> {
public:
    __list_imp() {}
};

template <typename T, typename Allocator = allocator<T> > class list : private __list_imp<T, Allocator> {
    typedef __list_imp<T, Allocator> base;
    typedef typename base::node_base node_base;
    typedef typename base::node node;

public:
    typedef T value_type;
    typedef typename base::size_type size_type;

    typedef typename base::iterator iterator;

    list() {}
    list(const list& rOther) : base() {
        for (node_base* p = rOther.begin_node(); p != rOther.end_node(); p = p->next_) {
            push_back(static_cast<node*>(p)->data_);
        }
    }
    ~list() {}

    iterator begin() { return iterator(this->begin_node()); }
    iterator end() { return iterator(this->end_node()); }
    size_type size() const { return this->size_.first(); }
    bool empty() const { return this->size_.first() == 0; }
    T& front() { return *begin(); }
    void push_back(const T& x) { insert(end(), x); }
    void clear() { base::clear(); }

    void pop_front() {
        node_base* pNode = this->begin_node();
        base::unlink_nodes(pNode, pNode);
        static_cast<node*>(pNode)->data_.~T();
        this->tail_.first().deallocate(static_cast<node*>(pNode), 1);
        --this->size_.first();
    }

    iterator erase(iterator position);

    template <class InputIterator> list(InputIterator first, InputIterator last) {
        for (; first != last; ++first) {
            push_back(*first);
        }
    }

    template <class InputIterator> void insert(iterator position, InputIterator first, InputIterator last) {
        iterator pos(position);
        list temp(first, last);
        splice(pos, temp);
    }

    void splice(iterator position, list& rOther) {
        if (rOther.size_.first() != 0) {
            node_base* pFirst = rOther.begin_node();
            node_base* pLast = rOther.end_node()->prev_;
            node_base* pOtherTail = rOther.end_node();
            pOtherTail->next_ = static_cast<node*>(pOtherTail);
            pOtherTail->prev_ = static_cast<node*>(pOtherTail);
            node_base* pNext = position.node_;
            pNext->prev_->next_ = static_cast<node*>(pFirst);
            pFirst->prev_ = pNext->prev_;
            pNext->prev_ = static_cast<node*>(pLast);
            pLast->next_ = static_cast<node*>(pNext);
            this->size_.first() += rOther.size_.first();
            rOther.size_.first() = 0;
        }
    }

    void swap(list& rOther) {
        if (this != &rOther) {
            size_type size = this->size_.first();
            this->size_.first() = rOther.size_.first();
            rOther.size_.first() = size;
            node_base* pTail = this->end_node();
            node_base tail = *pTail;
            *pTail = rOther.tail_.second();
            rOther.tail_.second() = tail;
            if (this->size_.first() != 0) {
                pTail->prev_->next_ = static_cast<node*>(pTail);
                pTail->next_->prev_ = static_cast<node*>(pTail);
            } else {
                pTail->prev_ = static_cast<node*>(pTail);
                pTail->next_ = static_cast<node*>(pTail);
            }
            node_base* pOtherTail = rOther.end_node();
            if (rOther.size_.first() != 0) {
                pOtherTail->prev_->next_ = static_cast<node*>(pOtherTail);
                pOtherTail->next_->prev_ = static_cast<node*>(pOtherTail);
            } else {
                pOtherTail->prev_ = static_cast<node*>(pOtherTail);
                pOtherTail->next_ = static_cast<node*>(pOtherTail);
            }
        }
    }

    iterator insert(iterator position, const T& x) {
        Metrowerks::alloc_ptr<node, typename base::node_allocator&> holder(this->tail_.first().allocate(1), this->tail_.first());
        this->size_.second().construct(holder.get()->value(), x);
        node* pNode = holder.release();
        node_base* pNext = position.node_;
        pNext->prev_->next_ = pNode;
        pNode->prev_ = pNext->prev_;
        pNext->prev_ = pNode;
        pNode->next_ = static_cast<node*>(pNext);
        ++this->size_.first();
        return iterator(pNode);
    }
};

template <typename T, typename Allocator>
typename list<T, Allocator>::iterator list<T, Allocator>::erase(iterator position) {
    iterator next(position);
    ++next;
    node* pNode = position.node_;
    base::unlink_nodes(pNode, pNode);
    pNode->data_.~T();
    this->tail_.first().deallocate(pNode, 1);
    --this->size_.first();
    return next;
}

}

#endif
