namespace std {

template <class T1, class T2> inline bool operator!=(const allocator<T1>&, const allocator<T2>&) {
    return false;
}

template <typename T, typename Allocator> class __list_deleter {
public:
    struct node;

    struct node_base {
        void init() {
            next_ = static_cast<node*>(this);
            prev_ = static_cast<node*>(this);
        }

        node* prev_;
        node* next_;
    };

    struct node : node_base {
        T data_;
    };

    typedef unsigned long size_type;
    typedef typename Allocator::template rebind<node>::other node_allocator;

    class const_iterator;
    template <bool B> class generic_iterator;
    typedef generic_iterator<false> iterator;

    template <bool B = false> class generic_iterator {
    public:
        typedef int difference_type;
        typedef T value_type;
        typedef T* pointer;
        typedef T& reference;
        typedef bidirectional_iterator_tag iterator_category;

        generic_iterator() {}
        generic_iterator(const generic_iterator& rOther) : node_(rOther.node_) {}
        explicit generic_iterator(node* pNode) : node_(pNode) {}
        explicit generic_iterator(node_base* pNode) : node_(static_cast<node*>(pNode)) {}

        T& operator*() const { return static_cast<node*>(node_)->data_; }
        T* operator->() const { return &static_cast<node*>(node_)->data_; }
        generic_iterator& operator++() {
            node_ = node_->next_;
            return *this;
        }
        generic_iterator& operator--() {
            node_ = node_->prev_;
            return *this;
        }
        bool operator==(const generic_iterator& rOther) const { return node_ == rOther.node_; }
        bool operator!=(const generic_iterator& rOther) const { return node_ != rOther.node_; }
        node_base* base() const { return node_; }

    private:
        node* node_;

        friend class __list_deleter;
        template <typename U, typename V> friend class list;
        friend class const_iterator;
    };

    static node* __iterator2pointer(iterator& i) { return i.node_; }
    static iterator __pointer2iterator(node* pNode) { return iterator(pNode); }

    class const_iterator {
    public:
        typedef int difference_type;
        typedef T value_type;
        typedef const T* pointer;
        typedef const T& reference;
        typedef bidirectional_iterator_tag iterator_category;

        const_iterator() {}
        const_iterator(const iterator& rOther) : node_(rOther.node_) {}
        explicit const_iterator(const node* pNode) : node_(pNode) {}
        explicit const_iterator(const node_base* pNode) : node_(static_cast<const node*>(pNode)) {}

        const T& operator*() const { return node_->data_; }
        const_iterator& operator++() {
            node_ = node_->next_;
            return *this;
        }
        const_iterator& operator--() {
            node_ = node_->prev_;
            return *this;
        }
        bool operator==(const const_iterator& rOther) const { return node_ == rOther.node_; }
        bool operator!=(const const_iterator& rOther) const { return node_ != rOther.node_; }

    private:
        const node* node_;

        friend class __list_deleter;
        template <typename U, typename V> friend class list;
    };

    iterator insert(iterator position, const T& x);
    static iterator erase(__list_deleter* pList, iterator first, iterator last);
    T& back() { return tail().prev_->data_; }
    const T& back() const { return tail().prev_->data_; }
    iterator erase(iterator position);
    void pop_back() { erase(__pointer2iterator(tail().prev_)); }
    void splice_all(iterator position, __list_deleter& rOther);

    iterator begin() { return iterator(tail().next_); }
    const_iterator begin() const { return const_iterator(tail().next_); }
    iterator end() { return iterator(&tail()); }
    const_iterator end() const { return const_iterator(&tail()); }

    __list_deleter();
    explicit __list_deleter(const Allocator& rAllocator) : size_(rAllocator, 0), tail_(alloc()) {
        node_base& rTail = tail();
        rTail.next_ = static_cast<node*>(&rTail);
        rTail.prev_ = static_cast<node*>(&rTail);
    }
    ~__list_deleter() { erase(this, begin(), end()); }

    void clear() { erase(this, begin(), end()); }

    size_type& size_ref() { return size_.second(); }
    const size_type& size_ref() const { return size_.second(); }
    Allocator& alloc() { return size_.first(); }
    const Allocator& alloc() const { return size_.first(); }
    node_allocator& node_alloc() { return tail_.first(); }

    static void unlink_nodes(node_base* pFirst, node_base* pLast) {
        pFirst->prev_->next_ = pLast->next_;
        pLast->next_->prev_ = pFirst->prev_;
    }

    static void link_nodes(node_base* pPosition, node_base* pFirst, node_base* pLast) {
        pPosition->prev_->next_ = static_cast<node*>(pFirst);
        pFirst->prev_ = pPosition->prev_;
        pPosition->prev_ = static_cast<node*>(pLast);
        pLast->next_ = static_cast<node*>(pPosition);
    }

    node_base& tail() { return tail_.second(); }
    const node_base& tail() const { return tail_.second(); }

    node_base* begin_node() const { return tail_.second().next_; }
    node_base* end_node() const { return const_cast<node_base*>(&tail_.second()); }

    Metrowerks::compressed_pair<Allocator, size_type> size_;
    Metrowerks::compressed_pair<node_allocator, node_base> tail_;

private:
    __list_deleter(const __list_deleter&);
    __list_deleter& operator=(const __list_deleter&);
};

template <typename T, typename Allocator>
inline __list_deleter<T, Allocator>::__list_deleter() : size_(size_type(0)), tail_(alloc()) {
    node_base& rTail = tail();
    rTail.prev_ = rTail.next_ = static_cast<node*>(&rTail);
}

template <typename T, typename Allocator>
typename __list_deleter<T, Allocator>::iterator __list_deleter<T, Allocator>::erase(__list_deleter* pList, iterator first, iterator last) {
    if (first == last) {
        return last;
    }
    unlink_nodes(first.base(), last.base()->prev_);
    while (first != last) {
        pList->alloc().destroy(&*first);
        node* pNode = static_cast<node*>(first.base());
        ++first;
        pList->node_alloc().deallocate(pNode, 1);
        --pList->size_ref();
    }
    return last;
}

template <typename T, typename Allocator>
typename __list_deleter<T, Allocator>::iterator __list_deleter<T, Allocator>::erase(iterator position) {
    node* oldnode = __iterator2pointer(position);
    ++position;
    unlink_nodes(oldnode, oldnode);
    alloc().destroy(&oldnode->data_);
    node_alloc().deallocate(oldnode, 1);
    --size_ref();
    return position;
}

template <typename T, typename Allocator> void __list_deleter<T, Allocator>::splice_all(iterator position, __list_deleter& rOther) {
    if (rOther.size_ref() != 0) {
        if (alloc() != rOther.alloc()) {
            throw runtime_error("list::splice called with unequal allocators");
        }
        node_base* pEnd = &rOther.tail();
        node_base* pFirst = pEnd->next_;
        node_base* pLast = pEnd->prev_;
        pEnd->next_ = static_cast<node*>(pEnd);
        pEnd->prev_ = static_cast<node*>(pEnd);
        link_nodes(position.base(), pFirst, pLast);
        size_ref() += rOther.size_ref();
        rOther.size_ref() = 0;
    }
}

template <typename T, typename Allocator>
typename __list_deleter<T, Allocator>::iterator __list_deleter<T, Allocator>::insert(iterator position, const T& x) {
    Metrowerks::alloc_ptr<node, node_allocator&> holder(node_alloc().allocate(1), node_alloc());
    alloc().construct(&holder->data_, x);
    node* pNode = holder.release();
    link_nodes(position.base(), pNode, pNode);
    ++size_ref();
    return __pointer2iterator(pNode);
}

template <typename T, typename Allocator> class __list_imp : public __list_deleter<T, Allocator> {
public:
    __list_imp() {}
    __list_imp(const __list_imp& rOther) : __list_deleter<T, Allocator>(rOther.alloc()) { insert_range(rOther.begin(), rOther.end()); }
    template <typename InputIterator> __list_imp(InputIterator first, InputIterator last, const Allocator& rAllocator) :
        __list_deleter<T, Allocator>(rAllocator) {
        insert_dispatch(first, last, Metrowerks::int2type<0>());
    }

    void push_front(const T& x) { this->insert(this->begin(), x); }
    void push_back(const T& x);

private:
    template <typename InputIterator> void insert_dispatch(InputIterator first, InputIterator last, Metrowerks::int2type<0>) {
        insert_range(first, last);
    }

    template <typename InputIterator> void insert_range(InputIterator first, InputIterator last) {
        for (; first != last; ++first) {
            push_back(*first);
        }
    }
};

template <typename T, typename Allocator> inline void __list_imp<T, Allocator>::push_back(const T& x) {
    this->insert(this->end(), x);
}

template <typename T, typename Allocator> class __list_imp<T*, Allocator> : public __list_deleter<T*, Allocator> {
    typedef __list_deleter<T*, Allocator> deleter;

public:
    class iterator : public deleter::iterator {
    public:
        typedef typename deleter::iterator base_iterator;

        iterator() {}
        iterator(const base_iterator& rOther) : base_iterator(rOther) {}

        T*& operator*() const { return base_iterator::operator*(); }
        iterator& operator++() {
            base_iterator::operator++();
            return *this;
        }
        iterator& operator--() {
            base_iterator::operator--();
            return *this;
        }
        bool operator!=(const iterator& rOther) const { return base_iterator::operator!=(rOther); }
        bool operator==(const iterator& rOther) const { return base_iterator::operator==(rOther); }
    };

    __list_imp() {}
    __list_imp(const __list_imp& rOther) : deleter(rOther.alloc()) { insert_range(rOther.begin(), rOther.end()); }
    template <typename InputIterator> __list_imp(InputIterator first, InputIterator last, const Allocator& rAllocator) :
        deleter(rAllocator) {
        insert_dispatch(first, last, Metrowerks::int2type<0>());
    }

    class const_iterator : public deleter::const_iterator {
    public:
        typedef typename deleter::const_iterator base_iterator;

        const_iterator() {}
        const_iterator(const base_iterator& rOther) : base_iterator(rOther) {}
        const_iterator(const iterator& rOther) : base_iterator(rOther) {}

        T* const& operator*() const { return base_iterator::operator*(); }
        const_iterator& operator++() {
            base_iterator::operator++();
            return *this;
        }
        const_iterator& operator--() {
            base_iterator::operator--();
            return *this;
        }
        bool operator!=(const const_iterator& rOther) const { return base_iterator::operator!=(rOther); }
        bool operator==(const const_iterator& rOther) const { return base_iterator::operator==(rOther); }
    };

    iterator begin() { return deleter::begin(); }
    iterator end() { return deleter::end(); }
    const_iterator begin() const { return deleter::begin(); }
    const_iterator end() const { return deleter::end(); }

    void push_front(T* const& x) { this->insert(deleter::begin(), x); }
    void push_back(T* const& x) { this->insert(deleter::end(), x); }

private:
    template <typename InputIterator> void insert_dispatch(InputIterator first, InputIterator last, Metrowerks::int2type<0>) {
        insert_range(first, last);
    }

    template <typename InputIterator> void insert_range(InputIterator first, InputIterator last) {
        for (; first != last; ++first) {
            push_back(*first);
        }
    }
};

template <typename T, typename Allocator = allocator<T> > class list;

template <typename T, typename Allocator>
void __assign_range(list<T, Allocator>& rList, typename list<T, Allocator>::const_iterator first,
                    typename list<T, Allocator>::const_iterator mid, typename list<T, Allocator>::const_iterator last);

template <typename T, typename Allocator> class list : private __list_imp<T, Allocator> {
    typedef __list_imp<T, Allocator> base;
    typedef typename base::node_base node_base;
    typedef typename base::node node;

public:
    typedef T value_type;
    typedef typename base::size_type size_type;

    typedef typename base::iterator iterator;
    typedef typename base::const_iterator const_iterator;

    iterator locate(size_type n);

    list() {}
    template <class InputIterator> list(InputIterator first, InputIterator last) {
        for (; first != last; ++first) {
            push_back(*first);
        }
    }

    list& operator=(const list& rOther) {
        copy_from(rOther);
        return *this;
    }

    void assign(const_iterator first, const_iterator last) {
        const_iterator mid = first;
        size_type count = size();
        for (; count != 0 && mid != last; --count, ++mid) {}
        __assign_range(*this, first, mid, last);
    }

    using base::back;
    using base::pop_back;
    using base::begin;
    using base::end;
    using base::push_front;
    size_type size() const { return this->size_ref(); }
    bool empty() const { return this->size_.second() == 0; }
    T& front() { return *begin(); }
    const T& front() const { return *begin(); }
    using base::push_back;
    void clear() { base::clear(); }

    void pop_front() {
        node_base* pNode = this->begin_node();
        unlink_nodes(pNode, pNode);
        static_cast<node*>(pNode)->data_.~T();
        this->tail_.first().deallocate(static_cast<node*>(pNode), 1);
        --this->size_.second();
    }

    iterator erase(iterator position);
    iterator erase(iterator first, iterator last) { return base::erase(this, first, last); }

    void swap(list& rOther) {
        if (this != &rOther) {
            size_type size = this->size_.second();
            this->size_.second() = rOther.size_.second();
            rOther.size_.second() = size;
            node_base* pTail = this->end_node();
            node_base tail = *pTail;
            *pTail = rOther.tail_.second();
            rOther.tail_.second() = tail;
            if (this->size_.second() != 0) {
                pTail->prev_->next_ = static_cast<node*>(pTail);
                pTail->next_->prev_ = static_cast<node*>(pTail);
            } else {
                pTail->prev_ = static_cast<node*>(pTail);
                pTail->next_ = static_cast<node*>(pTail);
            }
            node_base* pOtherTail = rOther.end_node();
            if (rOther.size_.second() != 0) {
                pOtherTail->prev_->next_ = static_cast<node*>(pOtherTail);
                pOtherTail->next_->prev_ = static_cast<node*>(pOtherTail);
            } else {
                pOtherTail->prev_ = static_cast<node*>(pOtherTail);
                pOtherTail->next_ = static_cast<node*>(pOtherTail);
            }
        }
    }

    using base::insert;

    void splice(iterator position, base& rOther) { base::splice_all(position, rOther); }
    void splice(iterator position, list& rOther) { base::splice_all(position, rOther); }

    template <class InputIterator> void insert(iterator position, InputIterator first, InputIterator last) {
        insert_dispatch(position, first, last, Metrowerks::int2type<0>());
    }

    using base::erase;

private:
    template <class InputIterator> void insert_dispatch(iterator position, InputIterator first, InputIterator last, Metrowerks::int2type<0>) {
        iterator pos(position);
        __list_imp<T, Allocator> temp(first, last, this->alloc());
        splice(pos, temp);
    }
    template <typename U, typename V>
    friend void __assign_range(list<U, V>& rList, typename list<U, V>::const_iterator first,
                               typename list<U, V>::const_iterator mid, typename list<U, V>::const_iterator last);

    list& copy_from(const list& rOther) {
        if (this != &rOther) {
            __assign_range(*this, rOther.begin(), rOther.nth(std::min(size(), rOther.size())), rOther.end());
        }
        return *this;
    }

    const_iterator nth(size_type n) const { return const_iterator(const_cast<list*>(this)->locate(n)); }
};

template <typename T, typename Allocator>
void __assign_range(list<T, Allocator>& rList, typename list<T, Allocator>::const_iterator first,
                    typename list<T, Allocator>::const_iterator mid, typename list<T, Allocator>::const_iterator last) {
    if (mid != last) {
        __list_imp<T, Allocator> temp(mid, last, rList.alloc());
        rList.splice(std::copy(first, mid, rList.begin()), temp);
    } else {
        list<T, Allocator>::erase(&rList, std::copy(first, mid, rList.begin()), rList.end());
    }
}

template <typename T, typename Allocator> typename list<T, Allocator>::iterator list<T, Allocator>::locate(size_type n) {
    size_type count = size();
    iterator it;
    if (n <= count / 2) {
        it = this->begin();
        std::advance(it, n);
    } else {
        it = this->end();
        std::advance(it, n - count);
    }
    return it;
}


template <typename T, typename Allocator>
typename list<T, Allocator>::iterator list<T, Allocator>::erase(iterator position) {
    iterator next(position);
    ++next;
    node* pNode = static_cast<node*>(position.base());
    unlink_nodes(pNode, pNode);
    pNode->data_.~T();
    this->tail_.first().deallocate(pNode, 1);
    --this->size_.second();
    return next;
}

}

#endif
