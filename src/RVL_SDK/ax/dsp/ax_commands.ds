    lrri $AC0.M, @$AR1
    lrri $AC0.L, @$AR1
    tst'l $ACC0 : $AC1.M, @$AR1
    jnz AxDspSetupAuxBSRamp
    loop $AX0.H
    srri @$AR2, $AC0.M
    jmp AxDspSetupAuxCL

AxDspSetupAuxBSRamp:
    asr16 $ACC1
    srri @$AR2, $AC0.M
    srri @$AR2, $AC0.L
    bloop $AX1.H, AxDspSetupAuxBSRampEnd
