AxDspSetupAuxBL:
    lri $AR2, #AX_AUXB_L_BUFFER
    lrri $AC0.M, @$AR1
    lrri $AC0.L, @$AR1
    tst'l $ACC0 : $AC1.M, @$AR1
    jnz AxDspSetupAuxBLRamp
    loop $AX0.H
