    srri @$AR2, $AC0.M
AxDspSetupAuxALRampEnd:
    srri @$AR2, $AC0.L

AxDspSetupAuxAR:
    lri $AR2, #AX_AUXA_R_BUFFER
    lrri $AC0.M, @$AR1
    lrri $AC0.L, @$AR1
    tst'l $ACC0 : $AC1.M, @$AR1
