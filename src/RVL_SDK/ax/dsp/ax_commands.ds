org 0x008a

AxDspSetup:
    clr $ACC0
    clr'l $ACC1 : $AC0.M, @$AR0
    set16'l : $AC1.M, @$AR0
    srs @DSMAH, $AC0.M
    srs @DSMAL, $AC1.M
    si @DSPA, #AX_SCRATCH_BUFFER
    si @DSCR, #DSP_DMA_READ
    si @DSBL, #AX_STUDIO_BYTES
    lri $AR1, #AX_SCRATCH_BUFFER
    lri $AR2, #AX_MAIN_L_BUFFER
    lri $AX1.H, #AX_FRAME_SAMPLES - 1
    lri $AX0.H, #AX_CHANNEL_WORDS
    clr $ACC0
    clr $ACC1
    set40
    call AxDspWaitDma

AxDspSetupMainL:
    lrri $AC0.M, @$AR1
    lrri $AC0.L, @$AR1
    tst'l $ACC0 : $AC1.M, @$AR1
    jnz AxDspSetupMainLRamp
    loop $AX0.H
    srri @$AR2, $AC0.M
    jmp AxDspSetupMainR

AxDspSetupMainLRamp:
    asr16 $ACC1
    srri @$AR2, $AC0.M
    srri @$AR2, $AC0.L
    bloop $AX1.H, AxDspSetupMainLRampEnd
    add $ACC0, $ACC1
    srri @$AR2, $AC0.M
AxDspSetupMainLRampEnd:
    srri @$AR2, $AC0.L

AxDspSetupMainR:
    lri $AR2, #AX_MAIN_R_BUFFER
    lrri $AC0.M, @$AR1
    lrri $AC0.L, @$AR1
    tst'l $ACC0 : $AC1.M, @$AR1
    jnz AxDspSetupMainRRamp
    loop $AX0.H
    srri @$AR2, $AC0.M
    jmp AxDspSetupMainS

AxDspSetupMainRRamp:
    asr16 $ACC1
    srri @$AR2, $AC0.M
    srri @$AR2, $AC0.L
    bloop $AX1.H, AxDspSetupMainRRampEnd
    add $ACC0, $ACC1
    srri @$AR2, $AC0.M
AxDspSetupMainRRampEnd:
    srri @$AR2, $AC0.L

AxDspSetupMainS:
    lri $AR2, #AX_MAIN_S_BUFFER
    lrri $AC0.M, @$AR1
    lrri $AC0.L, @$AR1
    tst'l $ACC0 : $AC1.M, @$AR1
    jnz AxDspSetupMainSRamp
    loop $AX0.H
    srri @$AR2, $AC0.M
    jmp AxDspSetupAuxAL

AxDspSetupMainSRamp:
    asr16 $ACC1
    srri @$AR2, $AC0.M
    srri @$AR2, $AC0.L
    bloop $AX1.H, AxDspSetupMainSRampEnd
    add $ACC0, $ACC1
    srri @$AR2, $AC0.M
AxDspSetupMainSRampEnd:
    srri @$AR2, $AC0.L

AxDspSetupAuxAL:
    lri $AR2, #AX_AUXA_L_BUFFER
    lrri $AC0.M, @$AR1
    lrri $AC0.L, @$AR1
    tst'l $ACC0 : $AC1.M, @$AR1
    jnz AxDspSetupAuxALRamp
    loop $AX0.H
