    lri $AR2, #AX_AUXC_R_BUFFER
    lrri $AC0.M, @$AR1
    lrri $AC0.L, @$AR1
    tst'l $ACC0 : $AC1.M, @$AR1
    jnz AxDspSetupAuxCRRamp
    loop $AX0.H
    srri @$AR2, $AC0.M
    jmp AxDspSetupAuxCS

AxDspSetupAuxCRRamp:
    asr16 $ACC1
    srri @$AR2, $AC0.M
    srri @$AR2, $AC0.L
    bloop $AX1.H, AxDspSetupAuxCRRampEnd
    add $ACC0, $ACC1
    srri @$AR2, $AC0.M
AxDspSetupAuxCRRampEnd:
    srri @$AR2, $AC0.L

AxDspSetupAuxCS:
    lri $AR2, #AX_AUXC_S_BUFFER
    lrri $AC0.M, @$AR1
    lrri $AC0.L, @$AR1
    tst'l $ACC0 : $AC1.M, @$AR1
    jnz AxDspSetupAuxCSRamp
    loop $AX0.H
    srri @$AR2, $AC0.M
    jmp AxDspSetupRemote

AxDspSetupAuxCSRamp:
    asr16 $ACC1
    srri @$AR2, $AC0.M
    srri @$AR2, $AC0.L
    bloop $AX1.H, AxDspSetupAuxCSRampEnd
    add $ACC0, $ACC1
    srri @$AR2, $AC0.M
AxDspSetupAuxCSRampEnd:
    srri @$AR2, $AC0.L

AxDspSetupRemote:
    lri $AX1.H, #AX_REMOTE_FRAME_SAMPLES - 1
    lri $AX0.H, #AX_REMOTE_CHANNEL_WORDS

AxDspSetupRemoteMain0:
    lri $AR2, #AX_REMOTE_MAIN0_BUFFER
    lrri $AC0.M, @$AR1
    lrri $AC0.L, @$AR1
    tst'l $ACC0 : $AC1.M, @$AR1
    jnz AxDspSetupRemoteMain0Ramp
    loop $AX0.H
    srri @$AR2, $AC0.M
    jmp AxDspSetupRemoteAux0

AxDspSetupRemoteMain0Ramp:
    asr16 $ACC1
    srri @$AR2, $AC0.M
    srri @$AR2, $AC0.L
    bloop $AX1.H, AxDspSetupRemoteMain0RampEnd
    add $ACC0, $ACC1
    srri @$AR2, $AC0.M
AxDspSetupRemoteMain0RampEnd:
    srri @$AR2, $AC0.L

AxDspSetupRemoteAux0:
    lri $AR2, #AX_REMOTE_AUX0_BUFFER
    lrri $AC0.M, @$AR1
    lrri $AC0.L, @$AR1
    tst'l $ACC0 : $AC1.M, @$AR1
    jnz AxDspSetupRemoteAux0Ramp
    loop $AX0.H
    srri @$AR2, $AC0.M
    jmp AxDspSetupRemoteMain1

AxDspSetupRemoteAux0Ramp:
    asr16 $ACC1
    srri @$AR2, $AC0.M
    srri @$AR2, $AC0.L
    bloop $AX1.H, AxDspSetupRemoteAux0RampEnd
    add $ACC0, $ACC1
    srri @$AR2, $AC0.M
AxDspSetupRemoteAux0RampEnd:
    srri @$AR2, $AC0.L

AxDspSetupRemoteMain1:
    lri $AR2, #AX_REMOTE_MAIN1_BUFFER
    lrri $AC0.M, @$AR1
    lrri $AC0.L, @$AR1
    tst'l $ACC0 : $AC1.M, @$AR1
    jnz AxDspSetupRemoteMain1Ramp
    loop $AX0.H
    srri @$AR2, $AC0.M
    jmp AxDspSetupRemoteAux1

AxDspSetupRemoteMain1Ramp:
    asr16 $ACC1
    srri @$AR2, $AC0.M
    srri @$AR2, $AC0.L
    bloop $AX1.H, AxDspSetupRemoteMain1RampEnd
    add $ACC0, $ACC1
    srri @$AR2, $AC0.M
AxDspSetupRemoteMain1RampEnd:
    srri @$AR2, $AC0.L

AxDspSetupRemoteAux1:
    lri $AR2, #AX_REMOTE_AUX1_BUFFER
    lrri $AC0.M, @$AR1
    lrri $AC0.L, @$AR1
    tst'l $ACC0 : $AC1.M, @$AR1
    jnz AxDspSetupRemoteAux1Ramp
    loop $AX0.H
    srri @$AR2, $AC0.M
    jmp AxDspSetupRemoteMain2

AxDspSetupRemoteAux1Ramp:
    asr16 $ACC1
    srri @$AR2, $AC0.M
    srri @$AR2, $AC0.L
    bloop $AX1.H, AxDspSetupRemoteAux1RampEnd
    add $ACC0, $ACC1
    srri @$AR2, $AC0.M
AxDspSetupRemoteAux1RampEnd:
    srri @$AR2, $AC0.L

AxDspSetupRemoteMain2:
    lri $AR2, #AX_REMOTE_MAIN2_BUFFER
    lrri $AC0.M, @$AR1
    lrri $AC0.L, @$AR1
    tst'l $ACC0 : $AC1.M, @$AR1
    jnz AxDspSetupRemoteMain2Ramp
    loop $AX0.H
    srri @$AR2, $AC0.M
    jmp AxDspSetupRemoteAux2

AxDspSetupRemoteMain2Ramp:
    asr16 $ACC1
    srri @$AR2, $AC0.M
    srri @$AR2, $AC0.L
    bloop $AX1.H, AxDspSetupRemoteMain2RampEnd
    add $ACC0, $ACC1
    srri @$AR2, $AC0.M
AxDspSetupRemoteMain2RampEnd:
    srri @$AR2, $AC0.L

AxDspSetupRemoteAux2:
    lri $AR2, #AX_REMOTE_AUX2_BUFFER
    lrri $AC0.M, @$AR1
    lrri $AC0.L, @$AR1
    tst'l $ACC0 : $AC1.M, @$AR1
    jnz AxDspSetupRemoteAux2Ramp
    loop $AX0.H
    srri @$AR2, $AC0.M
    jmp AxDspSetupRemoteMain3

AxDspSetupRemoteAux2Ramp:
    asr16 $ACC1
    srri @$AR2, $AC0.M
    srri @$AR2, $AC0.L
    bloop $AX1.H, AxDspSetupRemoteAux2RampEnd
    add $ACC0, $ACC1
    srri @$AR2, $AC0.M
AxDspSetupRemoteAux2RampEnd:
    srri @$AR2, $AC0.L

AxDspSetupRemoteMain3:
    lri $AR2, #AX_REMOTE_MAIN3_BUFFER
    lrri $AC0.M, @$AR1
    lrri $AC0.L, @$AR1
    tst'l $ACC0 : $AC1.M, @$AR1
    jnz AxDspSetupRemoteMain3Ramp
    loop $AX0.H
    srri @$AR2, $AC0.M
    jmp AxDspSetupRemoteAux3

