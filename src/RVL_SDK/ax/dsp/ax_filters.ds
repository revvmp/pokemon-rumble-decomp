AxDspLowPass:
    lri $IX3, #AX_NO_ADDRESS_WRAP
    mrr $IX0, $AR3
    lrri $AC0.M, @$AR3
    nx'ld : $AX0.H, $AX1.L, @$AR1
    mulx'ln $AX0.H, $AX1.L : $AX1.L, @$AR3
    mrr $AX0.H, $AC0.M
    maddx'ld $AX0.H, $AX1.L : $AX0.H, $AX1.L, @$AR1
    mulxmv'ln $AX0.H, $AX1.L, $ACC0 : $AX1.L, @$AR3
    mrr $AX0.H, $AC0.M
    maddx'ld $AX0.H, $AX1.L : $AX0.H, $AX1.L, @$AR1
    bloopi #AX_FRAME_PAIR_LOOP_COUNT, AxDspLowPassPairAccumulate

AxDspLowPassPairs:
    mulxmv'slm $AX0.H, $AX1.L, $ACC1 : $AC0.M, $AX1.L
    mrr $AX0.H, $AC1.M
    maddx'ld $AX0.H, $AX1.L : $AX0.H, $AX1.L, @$AR1
    mulxmv'slm $AX0.H, $AX1.L, $ACC0 : $AC1.M, $AX1.L
    mrr $AX0.H, $AC0.M
AxDspLowPassPairAccumulate:
    maddx'ld $AX0.H, $AX1.L : $AX0.H, $AX1.L, @$AR1
    movp's $ACC1 : @$AR0, $AC0.M
    srri @$AR0, $AC1.M
    mrr $AR3, $IX0
    srri @$AR3, $AC1.M
    ret

warnpc 0x06c1

AxDspBiquad:
    clr15
    m0
    mrr $IX1, $AR0
    lri $AR3, #AX_BIQUAD_HISTORY
    lrri $AX0.H, @$AR0
    lrri $AX0.L, @$AR0
    srri @$AR3, $AX0.H
    srri @$AR3, $AX0.L
    lrri $AX1.L, @$AR0
    lrri $AX1.H, @$AR0
    lri $AR3, #AX_BIQUAD_COEFFICIENTS
    bloopi #AX_BIQUAD_COEFFICIENT_COUNT, AxDspCopyBiquadCoefficientStore
AxDspCopyBiquadCoefficients:
    lrri $AX0.H, @$AR0
AxDspCopyBiquadCoefficientStore:
    srri @$AR3, $AX0.H
    lri $AR0, #AX_BIQUAD_COEFFICIENTS
    lri $WR0, #AX_BIQUAD_COEFFICIENT_WRAP
    lri $AR3, #AX_BIQUAD_HISTORY
    lri $WR3, #AX_BIQUAD_HISTORY_WRAP
    lri $IX3, #0
    lrri $AC1.M, @$AR1
    lrri $AX0.H, @$AR0
    include "include/ax_biquad_even_sample.inc"
    srri @$AR2, $AC0.M
    bloopi #AX_FRAME_PAIR_LOOP_COUNT, AxDspBiquadPairStore
AxDspBiquadPairs:
    include "include/ax_biquad_odd_sample.inc"
    include "include/ax_biquad_even_sample.inc"
AxDspBiquadPairStore:
    srri @$AR2, $AC0.M
    mulc'ldax $AC1.M, $AX0.H : $AX0, @$AR0
    madd'ldaxm $AX0.L, $AX0.H : $AX0, @$AR0
    madd'lsm $AX0.L, $AX0.H : $AX0.H, $AC1.M
    maddx'l $AX0.H, $AX1.H : $AX0.H, @$AR0
    maddx $AX0.H, $AX1.L
    movp $ACC0
    asl $ACC0, #2
    clrl $AC1.L
    mrr $AX1.L, $AC0.M
    srri @$AR2, $AC0.M
    lri $WR0, #AX_NO_ADDRESS_WRAP
    lri $WR3, #AX_NO_ADDRESS_WRAP
    mrr $AR0, $IX1
    lri $AR3, #AX_BIQUAD_HISTORY
    lrri $AX0.H, @$AR3
    lrri $AX0.L, @$AR3
    srri @$AR0, $AX0.H
    srri @$AR0, $AX0.L
    srri @$AR0, $AX1.L
    srri @$AR0, $AX1.H
    set15
    m2
    ret

warnpc 0x0718
