    bloopi #AX_FRAME_PAIR_LOOP_COUNT, AxDspMixStereoRampLeftVolumeLastPair
    include "include/ax_volume_ramp_pair.inc"
AxDspMixStereoRampLeftVolumeLastPair:
    srri @$AR3, $AC0.M
