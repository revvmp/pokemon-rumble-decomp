AxDspMixMonoConstant:
    include "include/ax_mix_constant_prime.inc"
    bloopi #AX_FRAME_PAIR_LOOP_COUNT, AxDspMixMonoConstantLastPair
    include "include/ax_mix_constant_pair.inc"
AxDspMixMonoConstantLastPair:
    lsl16'ls $ACC1 : $AX0.H, $AC0.M
    include "include/ax_mix_left_depop.inc"
    asr16 $ACC1
    srri @$AR3, $AC1.M
    clr's $ACC0 : @$AR3, $AC1.L
    ret

warnpc 0x0be9

AxDspMixStereoConstant:
    include "include/ax_mix_constant_prime.inc"
    bloopi #AX_FRAME_PAIR_LOOP_COUNT, AxDspMixStereoConstantLeftLastPair
    include "include/ax_mix_constant_pair.inc"
AxDspMixStereoConstantLeftLastPair:
    lsl16'ls $ACC1 : $AX0.H, $AC0.M
    include "include/ax_mix_left_depop.inc"
    asr16'ir $ACC1 : $AR1
    srri @$AR3, $AC1.M
    srri @$AR3, $AC1.L

    mrr $AR0, $IX0
    mrr $AR2, $IX1
    mrr $AR3, $AR2
    include "include/ax_mix_constant_prime.inc"
    bloopi #AX_FRAME_PAIR_LOOP_COUNT, AxDspMixStereoConstantRightLastPair
    include "include/ax_mix_constant_pair.inc"
AxDspMixStereoConstantRightLastPair:
    lsl16'ls $ACC1 : $AX0.H, $AC0.M
    include "include/ax_mix_right_depop.inc"
    asr16 $ACC1
    srri @$AR3, $AC1.M
    srri @$AR3, $AC1.L
    ret

warnpc 0x0c1f

AxDspMixMonoRamp:
    mrr $IX3, $AR3
    set16
    include "include/ax_volume_ramp_prime.inc"
    bloopi #AX_FRAME_PAIR_LOOP_COUNT, AxDspMixMonoRampVolumeLastPair
    include "include/ax_volume_ramp_pair.inc"
AxDspMixMonoRampVolumeLastPair:
    srri @$AR3, $AC0.M
