    bloopi #AX_FRAME_PAIR_LOOP_COUNT, AxDspMixStereoRampLeftLastPair
    include "include/ax_mix_ramp_pair.inc"
AxDspMixStereoRampLeftLastPair:
    lrri $AX1.L, @$AR1
    include "include/ax_mix_left_depop.inc"
    asr16'dr $ACC1 : $AR1
    srri @$AR3, $AC1.M
    srri @$AR3, $AC1.L

    mrr $AR0, $IX0
    mrr $AR2, $IX1
    mrr $AR3, $AR2
