    mrr $AR1, $IX3
    mrr $AR3, $AR2
    set40'l : $AX0.H, @$AR0
    include "include/ax_mix_ramp_prime.inc"
    bloopi #AX_FRAME_PAIR_LOOP_COUNT, AxDspMixMonoRampLastPair
    include "include/ax_mix_ramp_pair.inc"
AxDspMixMonoRampLastPair:
    lrri $AX1.L, @$AR1
    include "include/ax_mix_left_depop.inc"
    asr16 $ACC1
    srri @$AR3, $AC1.M
    srri @$AR3, $AC1.L
    ret

warnpc 0x0c4f

AxDspMixStereoRamp:
    mrr $IX3, $AR3
